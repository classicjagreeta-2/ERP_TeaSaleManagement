@* Table rows for the Tea Sample Receive Entry list (one row per document). Rendered by Index.cshtml for
   the first chunk and returned on its own (Request.IsAjaxRequest) for every further chunk the list's
   infinite scroll asks for -- see Scripts/list-infinite-scroll.js and TeaSampleReceiveController.Index.
   ViewBag.RowOffset keeps the "+" expand ids unique across chunks. *@
@model List<TeaSaleManagement.Controllers.TeaSampleReceiveRow>
@{
    var rowIndex = (int?)ViewBag.RowOffset ?? 0;
    // The Doc No is a link into View mode only for users holding the View right (AEDV) -- UX only.
    var canView = (ViewBag.Permission as TeaSaleManagement.Helpers.AEDV)?.View ?? false;
}
@if (Model != null)
{
    foreach (var row in Model)
    {
        rowIndex++;
        var detailId = "rowDetail" + rowIndex;
        var dt = row.DOCDT?.ToString("yyyy-MM-dd");
        var markText = string.IsNullOrEmpty(row.MARK_NAME) ? row.MARK : row.MARK_NAME;
        if ((row.MARKS ?? 0) > 1) { markText = markText + " (+" + ((row.MARKS ?? 0) - 1).ToString("0") + ")"; }
        <tr class="data-row"@TeaSaleManagement.Utility.RecordLock.RowAttrs(ViewBag.Locks, row.UNIT, row.DOCNO, row.DOCDT)>
            <td>
                <input type="checkbox" class="row-check" value="@row.DOCNO" data-docdt="@dt" data-unit="@row.UNIT" />
            </td>
            <td style="text-align:center;">
                <i class="fa fa-plus row-expand-btn" data-target="@detailId" title="Show invoices" style="cursor:pointer;"></i>
            </td>
            <td title="@row.UNIT">@TeaSaleManagement.UnitScope.Name(row.UNIT, ViewBag.UnitList as List<TeaSaleManagement.Models.PT.UnitOption>)</td>
            <td>
                @if (canView)
                {
                    <a href="@Url.Action("InsertOrUpdate", "TeaSampleReceive", new { unit = row.UNIT, docno = row.DOCNO, docdt = dt, view = true })">@row.DOCNO</a>
                }
                else
                {
                    @row.DOCNO
                }
            </td>
            <td>@(row.DOCDT?.ToString("dd/MM/yyyy"))</td>
            <td title="@row.GARDEN">@(string.IsNullOrEmpty(row.GARDEN_NAME) ? row.GARDEN : row.GARDEN_NAME)</td>
            <td title="@row.MARK">@markText</td>
            <td class="num">@((row.LINES ?? 0).ToString("0"))</td>
            <td class="num">@((row.BAGS ?? 0).ToString("0.##"))</td>
            <td class="num">@((row.TNET_WT ?? 0).ToString("0.00"))</td>
            <td class="num">@((row.TGROSS_WT ?? 0).ToString("0.00"))</td>
        </tr>
        <tr class="row-detail" id="@detailId" style="display:none;" data-docno="@row.DOCNO" data-docdt="@dt" data-unit="@row.UNIT">
            <td colspan="11" style="background:#f8f9fc;padding:10px 12px;">
                <div style="overflow-x:auto;">
                    <table class="detail-sub-table">
                        <thead>
                            <tr>
                                <th style="width:34px;">Sl.</th>
                                <th>Mark</th>
                                <th>Inv No.</th>
                                <th>Pack Date</th>
                                <th>Crop Yr.</th>
                                <th>Category</th>
                                <th>Grade</th>
                                <th class="num">Bags</th>
                                <th class="num">Net.Wt.</th>
                                <th class="num">Total Net.Wt.</th>
                                <th class="num">Total Gross Wt.</th>
                            </tr>
                        </thead>
                        <tbody class="detail-items-body">
                            <tr><td colspan="11" style="text-align:center;color:#666;">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
    }
}
