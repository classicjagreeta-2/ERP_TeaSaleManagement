@{
    string screenName = (string)ViewBag.ScreenName;
    ViewBag.Title = screenName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = ViewBag.IsEdit ?? false;
    bool isView = ViewBag.IsView ?? false;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (CLAUDE.md "Lookup pickers"): Garden / Mark (and the invoice list's
         Category filter) are jquery.inputpicker dropdowns. -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        input[readonly], input:disabled, select:disabled { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        .accordion-container.main-accordion { height: auto; overflow-y: visible; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input[type="checkbox"] { min-width: 0; width: auto; }
        #gridTable td.num, #gridTable th.num, #gridTable tfoot td { text-align: right; }
        input.num { text-align: right; }
        .total-box { font-weight: bold; text-align: right; }
        /* Pickers are as wide as their list needs (like Warehouse AWR's despatch picker), not fixed. */
        .popup-box.picker-box { display: none; width: fit-content; min-width: 560px; max-width: min(1080px, 92vw); padding: 14px 16px; }
        .popup-box.picker-box h2 { font-size: 16px; }
        .popup-box.picker-box.wide { width: fit-content; }
        .popup-box .picker-body { max-height: 52vh; overflow: auto; margin-top: 8px; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; position: sticky; top: 0; }
        .popup-box .picker-body th.num, .popup-box .picker-body td.num { text-align: right; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; white-space: nowrap; }
        .popup-box .picker-body tr:hover td, .popup-box .picker-body tr.is-active td { background: #eef3ff; }
        .popup-box .picker-empty { margin: 10px 4px 2px; font-size: 12px; color: #666; }
        .stock-filters { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; align-items: center; }
        .stock-filters input[type="text"] { width: 200px; }
        .stock-filters input[type="date"] { width: 150px; }
        .stock-filters label { margin: 0; font-weight: normal; font-size: 12px; }
        .stock-filters .inputpicker-overflow-hidden, .stock-filters .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        .stock-filters .inputpicker-div input { display: block; }
        .popup-box.alert-box { width: 440px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .action-btns li a.is-disabled, .action-btns li button:disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="purchase-details">
            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "TeaSampleReceive")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave" @(isView ? "disabled" : "")><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "TeaSampleReceive")"><i class="fa fa-times"></i> Revert</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">@screenName</div></div>
                        </div>
                        <div class="title-heading">RECEIVED DOC NO. : <span id="hdrDocNo"></span></div>
                    </div>
                </div>
            </div>

            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                @* #UNIT_disp keeps the code that is saved; #UNIT_name shows the unit's name. *@
                                <input type="hidden" id="UNIT_disp" />
                                <input type="text" id="UNIT_name" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container main-accordion">

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Received Doc No</label>
                                <input type="text" id="DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Received Date <span>(*)</span></label>
                                <input type="date" id="DOCDT" min="@ViewBag.MinDocDate" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Garden <span>(*)</span></label>
                                @* inputpicker dropdown; the saved value is the picked M_GARDEN code *@
                                <input type="text" id="GARDEN" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-40">
                                <label>Garden Name</label>
                                <input type="text" id="GARDEN_disp" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Mark</label>
                                @* the invoice list's Mark filter (VB6 txtMark) -- not saved, each line carries its own mark *@
                                <input type="text" id="MARK" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-40">
                                <label>Mark Name</label>
                                <input type="text" id="MARK_disp" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Total Bags</label>
                                <input type="text" id="TOTAL_BAGS" class="num total-box" readonly value="0" />
                            </div>
                            <div class="form-col-20">
                                <label>Total Net.Wt.</label>
                                <input type="text" id="TOTAL_NET" class="num total-box" readonly value="0.00" />
                            </div>
                            <div class="form-col-20">
                                <label>Total Gross Wt.</label>
                                <input type="text" id="TOTAL_GROSS" class="num total-box" readonly value="0.00" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Invoice Details</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnSelectInv"><i class="fa fa-search"></i> Select Invoices</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;">Sl.</th>
                                        <th>Mark</th>
                                        <th>Inv No.</th>
                                        <th>Pack Date</th>
                                        <th>Crop Yr.</th>
                                        <th>Category</th>
                                        <th>Grade</th>
                                        <th class="num">Bags</th>
                                        <th class="num">Net.Wt.</th>
                                        <th class="num">Total Net.Wt.</th>
                                        <th class="num">Total Gross Wt.</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="8" style="text-align:right;">Total</td>
                                        <td id="ftBags"></td>
                                        <td></td>
                                        <td id="ftTnet"></td>
                                        <td id="ftGross"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="popup-overlay" id="pickerOverlay"></div>

    <!-- VB6 "GardenInv_List" frame: the packing register's invoices whose sample is not received yet
         (bulk multi-row selection with its own Category / Packing Date filters -- a composite picker,
         not an inputpicker). -->
    <div class="popup-box picker-box wide" id="invPicker">
        <div class="popup-header">
            <h2>Garden Invoice List</h2>
            <button type="button" class="close-btn" id="invClose">X</button>
        </div>
        <div class="stock-filters">
            <label>Packing Date From</label>
            <input type="date" id="invFromDate" />
            <label>Packing Date To</label>
            <input type="date" id="invToDate" />
            <label>Category</label>
            <input type="text" id="invCategory" placeholder="Select Category" autocomplete="off" />
            <button type="button" id="btnInvRefresh" class="btn-blue" style="width:auto;padding:5px 14px;">Refresh</button>
        </div>
        <div class="stock-filters">
            <input type="text" id="invFind" placeholder="Inv No. / find (any column)..." style="width:260px;" autocomplete="off" />
            <button type="button" id="btnInvSelectAll" class="btn-white" style="width:auto;padding:5px 14px;">Select All</button>
            <button type="button" id="btnInvDeselectAll" class="btn-white" style="width:auto;padding:5px 14px;">De-Select All</button>
            <span id="invCount" style="font-size:12px;color:#666;"></span>
        </div>
        <div class="picker-body" id="invBody"></div>
        <div style="text-align:right;padding-top:10px;">
            <button type="button" class="btn-blue" id="btnInvOk" style="width:auto;padding:5px 16px;">OK</button>
            <button type="button" class="btn-white" id="btnInvCancel" style="width:auto;padding:5px 16px;">Cancel</button>
        </div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
(function () {
    var IS_EDIT = @(isEdit ? "true" : "false");
    var IS_VIEW = @(isView ? "true" : "false");
    var DOC = @Html.Raw(ViewBag.DocJson ?? "{}");
    var H = DOC.head || {};
    var URL = {
        garden: '@Url.Action("GetGarden", "TeaSampleReceive")',
        mark: '@Url.Action("GetMark", "TeaSampleReceive")',
        category: '@Url.Action("GetCategory", "TeaSampleReceive")',
        invoices: '@Url.Action("GetInvoiceList", "TeaSampleReceive")',
        save: '@Url.Action("Save", "TeaSampleReceive")',
        list: '@Url.Action("Index", "TeaSampleReceive")'
    };
    var MAX_LINES = 998;                // VB6 detailno = 999

    // ---------------------------------------------------------------- helpers
    $('#pickerOverlay, #invPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function r2(v) { v = num(v); var s = v < 0 ? -1 : 1; return s * Math.round(Math.abs(v) * 100 + 1e-7) / 100; }
    function f2(v) { return r2(v).toFixed(2); }
    function fc(v) { return String(r2(v)); }            // bags: no forced decimals
    function iso(d) { return d ? String(d).substring(0, 10) : ''; }
    function dmy(d) { d = iso(d); return d ? d.substring(8, 10) + '/' + d.substring(5, 7) + '/' + d.substring(0, 4) : ''; }
    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function closeAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) { AppMsg.show(message, onOk); }
    function showConfirm(message, onYes, onNo) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', function () { closeAlert(); if (onNo) onNo(); });
        $('#appAlertOk').off('click').on('click', function () { closeAlert(); onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function failMsg(x, fallback) {
        if (x && x.status === 440) {
            showAlert((x.responseJSON && x.responseJSON.message) || 'Your session has expired. Please log in again.', function () { window.location.reload(); });
            return;
        }
        if (x && x.statusText === 'abort') return;
        showAlert((x && x.responseJSON && x.responseJSON.message) || fallback || 'Could not load data. Please try again.');
    }

    // ---------------------------------------------------------------- state
    var FY_START = iso(H.FY_START), FY_END = iso(H.FY_END);
    var TODAY = iso(H.TODAY) || new Date().toISOString().substring(0, 10);
    // The Unit is locked: a NEW document carries the one picked on the list's "New" row (server-checked
    // against the user's units), an edit the document's own. UNIT is what Save posts -- see payload().
    var UNIT = H.UNIT || '';
    var MIN_DOC = '@ViewBag.MinDocDate';
    var rows = [], seq = 0;

    // ---------------------------------------------------------------- header
    $('#UNIT_disp').val(UNIT);
    $('#UNIT_name').val(H.UNIT_NAME || UNIT).attr('title', UNIT);
    $('#DOCNO').val(H.DOCNO || '');
    $('#hdrDocNo').text(H.DOCNO || '');
    $('#GARDEN').val(H.GARDEN || ''); $('#GARDEN_disp').val(H.GARDEN_NAME || '');
    // VB6 mstrfsh: the header Mark shows the first line's mark.
    $('#MARK').val(H.MARK || ''); $('#MARK_disp').val(H.MARK_NAME || '');

    // VB6 blankrec: today, or the year end once the year is over; never a future date.
    var MAX_DT = TODAY < FY_END ? TODAY : FY_END;
    if (IS_EDIT) {
        // Received Date is part of the document's key (Unit + Doc No + Date): fixed once saved.
        $('#DOCDT').val(iso(H.DOCDT)).prop('disabled', true);
    } else {
        var minDt = FY_START;
        if (MIN_DOC && MIN_DOC > minDt) minDt = MIN_DOC;
        $('#DOCDT').attr('min', minDt).attr('max', MAX_DT).val(MAX_DT < minDt ? minDt : MAX_DT);
    }
    // VB6 Form_Load: the invoice list's Packing Date From / To = the year start / today (or the year end).
    $('#invFromDate').val(FY_START);
    $('#invToDate').val(MAX_DT);

    // VB6 edit_record: Garden and Mark are locked on Edit.
    function headLocked() { return IS_VIEW || IS_EDIT; }

    function applyModeUi() {
        $('#GARDEN, #MARK').prop('readonly', headLocked()).attr('placeholder', headLocked() ? '' : 'Click to select');
        $('#btnSelectInv, #btnRemoveRows').toggleClass('is-disabled', IS_VIEW);
        if (IS_VIEW) $('input, select, textarea').prop('disabled', true);
    }

    // ---------------------------------------------------------------- lines
    function lineKey(r) { return [r.INVNO || '', iso(r.PACK_DATE), r.MARK || '', r.GRADE || ''].join('|').toUpperCase(); }

    function newRow(src) {
        var r = $.extend({
            MARK: '', MARK_NAME: '', INVNO: '', PACK_DATE: '', SEASON: '', CAT: '', CATEGORY: '', GRADE: '', GRADE_NAME: '',
            BAG_CHEST: 0, NET_WT: 0, TNET_WT: 0, TGROSS_WT: 0
        }, src || {});
        ['MARK', 'MARK_NAME', 'INVNO', 'SEASON', 'CAT', 'CATEGORY', 'GRADE', 'GRADE_NAME'].forEach(function (k) { r[k] = r[k] || ''; });
        r.PACK_DATE = iso(r.PACK_DATE);
        ['BAG_CHEST', 'NET_WT', 'TNET_WT', 'TGROSS_WT'].forEach(function (k) { r[k] = r2(r[k]); });
        r._cid = ++seq;
        return r;
    }

    // The lines come only from the Garden Invoice List and are not typed (the API takes the weights
    // from the packing register).
    function renderGrid() {
        var $tb = $('#gridBody').empty();
        rows.forEach(function (r, i) {
            r.SRLNO = i + 1;
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" ' + (IS_VIEW ? 'disabled' : '') + ' /></td>');
            tr.append('<td>' + r.SRLNO + '</td>');
            tr.append('<td title="' + esc(r.MARK) + '">' + esc(r.MARK_NAME || r.MARK) + '</td>');
            tr.append('<td>' + esc(r.INVNO) + '</td>');
            tr.append('<td>' + esc(dmy(r.PACK_DATE)) + '</td>');
            tr.append('<td>' + esc(r.SEASON) + '</td>');
            tr.append('<td title="' + esc(r.CAT) + '">' + esc(r.CATEGORY) + '</td>');
            tr.append('<td title="' + esc(r.GRADE) + '">' + esc(r.GRADE_NAME || r.GRADE) + '</td>');
            tr.append('<td class="num">' + fc(r.BAG_CHEST) + '</td>');
            tr.append('<td class="num">' + f2(r.NET_WT) + '</td>');
            tr.append('<td class="num">' + f2(r.TNET_WT) + '</td>');
            tr.append('<td class="num">' + f2(r.TGROSS_WT) + '</td>');
            $tb.append(tr);
        });
        if (!rows.length) $tb.append('<tr><td colspan="12" style="text-align:center;color:#666;">Use "Select Invoices" to pick the garden invoices whose samples were received.</td></tr>');
        refreshTotals();
    }

    // VB6 grid footers: Bags, Total Net.Wt., Total Gross Wt.
    function refreshTotals() {
        var t = { BAG_CHEST: 0, TNET_WT: 0, TGROSS_WT: 0 };
        rows.forEach(function (r) { for (var k in t) t[k] += num(r[k]); });
        $('#ftBags').text(fc(t.BAG_CHEST)); $('#ftTnet').text(f2(t.TNET_WT)); $('#ftGross').text(f2(t.TGROSS_WT));
        $('#TOTAL_BAGS').val(fc(t.BAG_CHEST)); $('#TOTAL_NET').val(f2(t.TNET_WT)); $('#TOTAL_GROSS').val(f2(t.TGROSS_WT));
    }

    $('#chkAll').on('change', function () { $('.rowChk:not(:disabled)').prop('checked', $(this).is(':checked')); });
    // VB6 datagrid1 AllowDelete (+ datagrid1_AfterDelete renumbering the Sl.).
    $('#btnRemoveRows').on('click', function () {
        if (IS_VIEW) return;
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        $('#chkAll').prop('checked', false);
        renderGrid();
    });

    // ---------------------------------------------------------------- lookups
    // jquery.inputpicker dropdowns (Root UI convention): anchored under the field, paged, and searched
    // server-side on EVERY column shown. The first field is the value written to the box.
    var LOOKUPS = {
        garden: { url: URL.garden, urlParam: function () { return { unit: UNIT }; },
                  fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Garden' }] },
        // VB6 txtMark: narrowed to the picked garden's marks (M_MARK.GLOCA = garden code).
        mark: { url: URL.mark, urlParam: function () { return { garden: $('#GARDEN').val() || '' }; }, selectMode: 'empty',
                fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Mark' }, { name: 'GARDEN', text: 'Garden' }] },
        category: { url: URL.category, selectMode: 'empty',
                    fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Category' }, { name: 'GRADE_TYPE', text: 'Grade Type' }] }
    };

    // This copy of the plugin writes the picked value into the original input and fires "change"; read
    // the picked row back from the data it last loaded.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function pickerOptions(cfg) {
        var o = {
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2
        };
        if (cfg.urlParam) o.urlParam = cfg.urlParam();
        if (cfg.selectMode) o.selectMode = cfg.selectMode;
        return o;
    }

    function visibleInput($orig) { return $orig.next('.inputpicker-overflow-hidden').find('input'); }

    function openLookup(key, $input, onSelect, onClear) {
        var cfg = LOOKUPS[key];
        $('.inputpicker-wrapped-list').remove();

        if ($input.hasClass('inputpicker-original')) {
            // The filter may have changed since the dropdown was built (Mark follows the Garden).
            if (cfg.urlParam) { try { $input.inputpicker('set', 'urlParam', cfg.urlParam()); } catch (e) { /* keeps the old filter */ } }
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker(pickerOptions(cfg));
        setTimeout(function () { showPickerList($input); }, 0);

        function deliver(row) { if (row && onSelect) onSelect(row); }
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
        if (onClear) {
            visibleInput($input).on('input', function () {
                if (!$(this).val() && $input.val()) { $input.val(''); $(this).data('value', ''); onClear(); }
            });
        }
    }

    function clearMark() {
        $('#MARK').val(''); $('#MARK_disp').val('');
        if ($('#MARK').hasClass('inputpicker-original')) {
            visibleInput($('#MARK')).val('').data('value', '');
            // The plugin's own box is what gets clicked once built, so openLookup's refresh never runs:
            // point the Mark list at the new Garden here.
            try { $('#MARK').inputpicker('set', 'urlParam', LOOKUPS.mark.urlParam()); } catch (e) { }
        }
    }

    // Garden (VB6 txtGarden): a change of garden drops a Mark of another garden.
    $('#GARDEN').on('click focus', function () {
        if (headLocked()) return;
        openLookup('garden', $(this), function (g) {
            $('#GARDEN_disp').val(g.NAME || '');
            clearMark();
        });
    });
    // Mark (VB6 txtMark): optional -- the invoice list's Mark filter.
    $('#MARK').on('click focus', function () {
        if (headLocked()) return;
        openLookup('mark', $(this),
            function (m) { $('#MARK_disp').val(m.NAME || ''); },
            function () { $('#MARK_disp').val(''); });
    });

    // ---------------------------------------------------------------- Garden Invoice List popup
    var invRows = [], invReq = 0;

    function initCategoryFilter() {
        var $orig = $('#invCategory');
        if ($orig.hasClass('inputpicker-original')) return;
        $orig.inputpicker(pickerOptions(LOOKUPS.category));
        // Wiping the visible text is how the filter is removed.
        visibleInput($orig).on('input', function () {
            if (!$(this).val() && $orig.val()) { $orig.val(''); $(this).data('value', ''); }
        });
    }

    // VB6 datagrid1_ButtonClick (Inv No.) -> Command4_Click: the list as it opens (no date filter).
    function openInvoices() {
        if (IS_VIEW) return;
        if (rows.length >= MAX_LINES) { showAlert('A document can hold at most ' + MAX_LINES + ' invoices.'); return; }
        $('#invFind').val('');
        $('#pickerOverlay, #invPicker').fadeIn(120, initCategoryFilter);
        loadInvoices(false);
    }
    function closeInvoices() { $('.inputpicker-wrapped-list').hide(); $('#pickerOverlay, #invPicker').fadeOut(120); }

    // useDates = false: Command4 (opening); true: Command3 "Refresh" (Packing Date From / To applied).
    function loadInvoices(useDates) {
        if (useDates && (!$('#invFromDate').val() || !$('#invToDate').val())) { showAlert('INVALID DATE !'); return; }
        var reqId = ++invReq;
        $('.inputpicker-wrapped-list').hide();
        invRows = [];
        $('#invCount').text('');
        $('#invBody').html('<p class="picker-empty">Loading...</p>');
        $.getJSON(URL.invoices, {
            unit: UNIT,
            mark: $('#MARK').val() || '',
            category: $('#invCategory').val() || '',
            fromDate: $('#invFromDate').val(),
            toDate: $('#invToDate').val(),
            useDates: useDates
        }).done(function (data) {
            if (reqId !== invReq) return;
            var have = {};
            rows.forEach(function (r) { have[lineKey(r)] = true; });
            // Invoices already on the grid are left out of the list.
            invRows = (data || []).filter(function (d) { return !have[lineKey(d)]; })
                                  .map(function (d, i) { d._i = i; d._sel = false; return d; });
            renderInvoices();
        }).fail(function (x) {
            if (reqId !== invReq) return;
            $('#invBody').html('<p class="picker-empty">Could not load the invoices. Click Refresh to try again.</p>');
            failMsg(x);
        });
    }

    // VB6 TDBGrid1 columns.
    var INV_COLS = [['MARK_NAME', 'Mark'], ['INVNO', 'Inv No.'], ['GRADE', 'Grade Code'], ['PACK_DATE', 'Pack Date', 'date'], ['GRADE_NAME', 'Grade'],
                    ['CHESTSLF', 'Start No.'], ['CHESTSLT', 'End No.'], ['CATEGORY', 'Category'], ['BAG_CHEST', 'Bags', 'cnt'],
                    ['TNET_WT', 'Total Net.Wt.', 'num'], ['NET_WT', 'Net.Wt.', 'num'], ['TGROSS_WT', 'Total Gross Wt.', 'num']];
    function isNumKind(k) { return k === 'num' || k === 'cnt'; }
    function cellText(v, kind) { return kind === 'date' ? dmy(v) : kind === 'num' ? f2(v) : kind === 'cnt' ? fc(v) : (v == null ? '' : String(v)); }
    function cell(v, kind) { return '<td' + (isNumKind(kind) ? ' class="num"' : '') + '>' + esc(cellText(v, kind)) + '</td>'; }
    function invText(d) {
        return INV_COLS.map(function (c) { return cellText(d[c[0]], c[2]); }).concat([d.MARK || '']).join(' ').toUpperCase();
    }
    function shownInvoices() {
        var term = $.trim($('#invFind').val()).toUpperCase();
        return invRows.filter(function (d) { return !term || invText(d).indexOf(term) >= 0; });
    }
    function renderInvoices() {
        var shown = shownInvoices();
        var html = '<table><thead><tr><th style="width:30px;">Tag</th>' +
            INV_COLS.map(function (c) { return '<th' + (isNumKind(c[2]) ? ' class="num"' : '') + '>' + c[1] + '</th>'; }).join('') + '</tr></thead><tbody>';
        shown.forEach(function (d) {
            html += '<tr data-i="' + d._i + '"><td><input type="checkbox" class="invChk"' + (d._sel ? ' checked' : '') + ' /></td>' +
                INV_COLS.map(function (c) { return cell(d[c[0]], c[2]); }).join('') + '</tr>';
        });
        html += '</tbody></table>';
        if (!invRows.length) html += '<p class="picker-empty">No invoice is pending for the selected Mark / Category / Packing Date.</p>';
        else if (!shown.length) html += '<p class="picker-empty">No invoice matches the search.</p>';
        $('#invBody').html(html);
        $('#invCount').text(invRows.length ? shown.length + ' of ' + invRows.length + ' invoices' : '');
    }
    function invAt(i) { for (var k = 0; k < invRows.length; k++) { if (invRows[k]._i == i) return invRows[k]; } return null; }

    $('#invBody').on('click', 'tr[data-i]', function (e) {
        var d = invAt($(this).data('i')); if (!d) return;
        var $chk = $(this).find('.invChk');
        if (!$(e.target).is('.invChk')) $chk.prop('checked', !$chk.is(':checked'));
        d._sel = $chk.is(':checked');
    });
    $('#invFind').on('input', renderInvoices);
    $('#btnInvRefresh').on('click', function () { loadInvoices(true); });
    // VB6 Command50 / Command15: Select All / De-Select All (of the rows shown).
    $('#btnInvSelectAll').on('click', function () { shownInvoices().forEach(function (d) { d._sel = true; }); renderInvoices(); });
    $('#btnInvDeselectAll').on('click', function () { shownInvoices().forEach(function (d) { d._sel = false; }); renderInvoices(); });
    $('#invClose, #btnInvCancel').on('click', closeInvoices);
    $('#btnSelectInv').on('click', openInvoices);

    // VB6 Command6_Click "OK": one grid line per tagged invoice.
    $('#btnInvOk').on('click', function () {
        // A lot already on the grid is not added again (a second OK / double click used to duplicate it).
        var onGrid = {};
        rows.forEach(function (r) { onGrid[lineKey(r)] = true; });
        var picked = invRows.filter(function (d) { return d._sel && !onGrid[lineKey(d)]; });
        if (!picked.length) { showAlert('Tag at least one invoice.'); return; }
        if (rows.length + picked.length > MAX_LINES) { showAlert('A document can hold at most ' + MAX_LINES + ' invoices.'); return; }
        picked.forEach(function (d) {
            rows.push(newRow({
                MARK: d.MARK, MARK_NAME: d.MARK_NAME, INVNO: d.INVNO, PACK_DATE: d.PACK_DATE, SEASON: d.SEASON,
                CAT: d.CAT, CATEGORY: d.CATEGORY, GRADE: d.GRADE, GRADE_NAME: d.GRADE_NAME,
                BAG_CHEST: d.BAG_CHEST, NET_WT: d.NET_WT, TNET_WT: d.TNET_WT, TGROSS_WT: d.TGROSS_WT
            }));
        });
        closeInvoices();
        renderGrid();
    });

    // ---------------------------------------------------------------- save
    function payload() {
        return {
            // UNIT: the locked Unit. IsNew lets the server apply the AEDV Add / Edit right and back-date
            // window (TeaSampleReceiveController.Save).
            UNIT: $('#UNIT_disp').val(), IsNew: !IS_EDIT,
            DOCNO: $('#DOCNO').val() || null, DOCDT: $('#DOCDT').val() || null,
            GARDEN: $('#GARDEN').val() || null, MARK: $('#MARK').val() || null,
            LINES: rows.map(function (r) {
                return { INVNO: r.INVNO, PACK_DATE: r.PACK_DATE || null, MARK: r.MARK, GRADE: r.GRADE };
            })
        };
    }

    // VB6 txtDocdt_Validate + Command1_Click (same order and messages).
    function validate() {
        var d = $('#DOCDT').val();
        if (!d) return 'INVALID DATE !';
        if (!IS_EDIT) {
            if (d > TODAY) return 'Can not enter future date ' + dmy(d);
            if (d < FY_START || d > FY_END) return 'Date not between financial Year';
            if (d < ($('#DOCDT').attr('min') || '') || d > ($('#DOCDT').attr('max') || '9999')) {
                return 'Date must be between ' + dmy($('#DOCDT').attr('min')) + ' and ' + dmy($('#DOCDT').attr('max')) + '.';
            }
        }
        if (!$('#GARDEN').val()) return 'Garden Code invalid';
        if (!rows.length) return 'No Record in Datagrid to Save';
        if (rows.length > MAX_LINES) return 'A document can hold at most ' + MAX_LINES + ' invoices.';
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            if (!r.INVNO) return 'Without Invoice Detail, Record Can Not be Saved.';
            if (!(r.BAG_CHEST > 0)) return 'Line ' + r.SRLNO + ': Enter Bag Invoice Detail !';
        }
        return null;
    }

    var saving = false;
    $('#btnSave').on('click', function () {
        if (IS_VIEW || saving) return;
        var err = validate();
        if (err) { showAlert(err); return; }
        showConfirm('Are you sure?', function () {
            saving = true;
            $('#btnSave').prop('disabled', true);
            $.ajax({ url: URL.save, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload()) })
                .done(function (resp) {
                    if (resp && resp.success) {
                        var no = resp.data && resp.data.docno ? resp.data.docno : '';
                        showAlert('Saved successfully.' + (no ? '\n' + 'Received Doc No. ' + no : ''), function () { window.location.href = URL.list; });
                    } else {
                        showAlert((resp && resp.message) || 'Save failed.');
                    }
                })
                .fail(function (x) { failMsg(x, 'Save failed.'); })
                .always(function () { saving = false; $('#btnSave').prop('disabled', false); });
        });
    });

    // ---------------------------------------------------------------- init
    rows = (DOC.lines || []).map(function (l) { return newRow(l); });
    renderGrid();
    applyModeUi();
    $(window).on('beforeunload pagehide', function () { $('.inputpicker-wrapped-list').hide(); });
})();
</script>
@Html.Partial("_RecordLock")
</body>
</html>
