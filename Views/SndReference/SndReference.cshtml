        // ----- Reference list: load details → rebuild rows with API-backed selects -----
        $("#referenceList").on("click", ".reference-item", function () {
            $("#cdError").text("");
    debugger;
    $(".reference-item").removeClass("selected-reference");

    $(this).addClass("selected-reference");
    var CODE = $(this).data("code");

    $.ajax({
        url: '@Url.Action("GetDetails", "SndReference")',
        data: { cd: CODE }
    }).done(function (dta) {

        var res = dta.Data || dta.data || dta;

        if (!res || !res.hdr) {
            toastr.warning("No data found for selected code.");
            return;
        }

        var hdr = res.hdr,
            dtl = res.dtl || [],
            udtl = res.udtl || [];


        $("#id").val(hdr.id || hdr.ID || "");
        $("#cd").val(hdr.cd || hdr.CD || "").prop("readonly", true) .prop("disabled", true)
        $("#nam").val(hdr.nam || hdr.NAM || "");
        $("#adds").val(hdr.adds || hdr.ADDS || "");
        $("#addss").val(hdr.addss || hdr.ADDSS || "");
        $("#FFCODE").val(hdr.FFCODE || "").trigger("change");


        function formatDate(dateStr) {
            if (!dateStr) return "";

            const match = /\/Date\((\d+)\)\//.exec(dateStr);
            if (match) {
                const ticks = parseInt(match[1], 10);
                const d = new Date(ticks);
                return `${d.getFullYear()}-${("0" + (d.getMonth() + 1)).slice(-2)}-${("0" + d.getDate()).slice(-2)}`;
            }

            const d = new Date(dateStr);
            if (isNaN(d)) return "";
            return `${d.getFullYear()}-${("0" + (d.getMonth() + 1)).slice(-2)}-${("0" + d.getDate()).slice(-2)}`;
        }

        if (hdr.ENTDT) $("#ENTDT").val(formatDate(hdr.ENTDT));
        if (hdr.ENTDT_NEW) $("#ENTDT_NEW").val(formatDate(hdr.ENTDT_NEW));


        $("#accounttablelink tbody").empty();
        $("#unitTableLink tbody").empty();


        dtl.forEach(function (item) {
            addAccountRow({
                id: item.ACCODE || "",
                text: item.ACCODE || "",
                subcode: item.SUBCODE || "",
                description: item.ACNAME || item.ACNAME || "" // 🩵 fixed field reference
            });
        });


        udtl.forEach(function (item) {
            addUnitRow({
                id: item.UNIT_CODE || item.uniT_CODE || item.unit || "",
                text: item.UNIT_CODE || item.uniT_CODE || item.unit || "",
                name: item.NAME || item.name || ""
            });
        });

        toggleTableControls(false);
        toggleActionButtons(true);
    }).fail(function () {
        toastr.error("Error loading details.");
    });
});



        var currentPageNumber = 1, searchQuery = "", isLoading = false;
        function GetMoreContent(currentPage, query) {
            $("#loading").show();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetList", "SndReference")",
                dataType: "json",
                data: { page: currentPage, pageSize: 15, searchString: query }
            }).done(function (dataL) {
                if (Array.isArray(dataL) && dataL.length > 0) {
                    dataL.forEach(function (item) {
                        $('<p class="reference-item" data-code="' + item.CD + '">' + item.CD + ' - ' + item.NAM + '</p>').appendTo("#referenceList");
                    });
                    isLoading = false;
                } else if (currentPage === 1) {
                    $("#referenceList").html("<p>No results found</p>");
                } else {
                    $("#referenceList").append("<p>No more results</p>");
                }
            }).fail(function () {
                $("#referenceList").append("<p>Error loading data</p>");
                isLoading = false;
            }).always(function(){ $("#loading").hide(); });
        }
        GetMoreContent(currentPageNumber, searchQuery);

        $("#SearchString").on("keyup change", function () {
            searchQuery = $(this).val(); currentPageNumber = 1;
            $("#referenceList").empty(); GetMoreContent(currentPageNumber, searchQuery);
        });
        $("#referenceList").on("scroll", function () {
            var $this = $(this), height = this.scrollHeight - $this.height(), scroll = $this.scrollTop();
            if (scroll >= height - 50 && !isLoading) { isLoading = true; currentPageNumber += 1; GetMoreContent(currentPageNumber, searchQuery); }
        });
    });




    </script>
</body>
</html>
