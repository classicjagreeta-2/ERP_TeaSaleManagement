@{
    ViewBag.Title = "Auction Release Printing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("_HsReportHead")

<div class="general-container">
    <div class="rpt-details">
        @Html.Partial("_HsReportToolbar")

        <div class="header-details">
            <div class="row">
                <div class="col-md-4 align-items-center">
                    <div class="header-left"><div class="title-heading">Auction Release Printing</div></div>
                </div>
                <div class="col-md-8 d-flex justify-content-end align-items-center" style="padding-right:2.2%">
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Graphics" title="PDF in a new tab">Graphics</button>
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Html" title="HTML page in a new tab">HTML</button>
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Excel" title="Download as Excel (.xlsx)">Excel</button>
                </div>
            </div>

            <div class="accordion-container">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-15">
                                <label>From Date <span>(*)</span></label>
                                <div class="date-field">
                                    <input type="text" id="FromDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.FinancialYearFrom" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#FromDate" />
                                </div>
                            </div>
                            <div class="form-col-15">
                                <label>To Date <span>(*)</span></label>
                                <div class="date-field">
                                    <input type="text" id="ToDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.DefaultDate" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#ToDate" />
                                </div>
                            </div>
                            <div class="form-col-40">
                                <label>Select Doc No</label>
                                <div id="Documents_holder"></div>
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_HsReportScripts")
<script>
    $(function () {
        HsReport.init({ title: "Auction Release Printing", fyFrom: "@ViewBag.FinancialYearFrom", fyTo: "@ViewBag.FinancialYearTo" });
        HsReport.picker({ id: "Documents", width: "460px",
            fields: [{ name: "CODE", text: "DOC NO", width: "90px" }, { name: "DOCDT", text: "DATE", width: "90px" },
                     { name: "UNIT", text: "UNIT", width: "60px" }, { name: "SALE_NO", text: "SALE NO", width: "90px" }],
            load: function () {
                return $.getJSON('@Url.Action("Lookup", "AuctionReleasePrinting")', { what: "GetDocuments", fromDate: $("#FromDate").val(), toDate: $("#ToDate").val() });
            } });
        $("#FromDate, #ToDate").on("change", function () { HsReport.reload("Documents"); });

        $(".out-btn").on("click", function () {
            if (!HsReport.checkPeriod("FromDate", "ToDate")) return;
            HsReport.open('@Url.Action("Report", "AuctionReleasePrinting")', {
                fromDate: $("#FromDate").val(),
                toDate: $("#ToDate").val(),
                documents: HsReport.codes("Documents"),
                outputType: $(this).data("output")
            });
        });
    });
</script>
