@{
    // Shared by TaxInvoicePrinting (03020100T) and ExportInvoicePrinting (03020900T, TT).
    string ctl = (string)ViewBag.Controller;
    ViewBag.Title = (bool)ViewBag.Tt ? "Tax Invoice Printing(TT)" : "Tax Invoice Printing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("_HsReportHead")

<div class="general-container">
    <div class="rpt-details">
        @Html.Partial("_HsReportToolbar")

        <div class="header-details">
            <div class="row">
                <div class="col-md-4 align-items-center">
                    <div class="header-left"><div class="title-heading">@ViewBag.Title</div></div>
                </div>
                <div class="col-md-8 d-flex justify-content-end align-items-center" style="padding-right:2.2%">
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Graphics" title="Print the invoices (PDF in a new tab)">View Report</button>
                </div>
            </div>

            <div class="accordion-container">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Select Unit <span>(*)</span></label>
                                <div id="Unit_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Sales Type <span>(*)</span></label>
                                <div id="SaleType_holder"></div>
                            </div>
                            <div class="form-col-15">
                                <label>Invoice From</label>
                                <div class="date-field">
                                    <input type="text" id="FromDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.FinancialYearFrom" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#FromDate" />
                                </div>
                            </div>
                            <div class="form-col-15">
                                <label>Invoice To</label>
                                <div class="date-field">
                                    <input type="text" id="ToDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.DefaultDate" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#ToDate" />
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-40">
                                <label>Select Inv No <span>(*)</span></label>
                                <div id="Invoices_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Select No of Copies</label>
                                <div id="Copies_holder"></div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-30">
                                <div class="sr-check">
                                    <label><input type="checkbox" id="WithBroker" checked /> With Broker Name</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_HsReportScripts")
<script>
    $(function () {
        HsReport.init({ title: "@ViewBag.Title", fyFrom: "@ViewBag.FinancialYearFrom", fyTo: "@ViewBag.FinancialYearTo" });
        var lookup = '@Url.Action("Lookup", ctl)';
        var tt = @(((bool)ViewBag.Tt) ? "true" : "false");
        function reloadInvoices() { HsReport.reload("Invoices"); }
        HsReport.picker({ id: "Unit", multiple: false, placeholder: "Select Unit", width: "320px",
            load: function () { return $.getJSON('@Url.Action("Units", ctl)'); },
            onChange: function () { HsReport.reload("SaleType"); } });
        HsReport.picker({ id: "SaleType", multiple: false, placeholder: "Select Sales Type",
            load: function () {
                var unit = HsReport.value("Unit");
                return unit ? $.getJSON(lookup, { what: "GetSaleTypes", tt: tt, unit: unit }) : [];
            },
            onChange: reloadInvoices });
        HsReport.picker({ id: "Invoices", width: "420px", placeholder: "Select Inv No", allText: "",
            fields: [{ name: "CODE", text: "INVOICE NO", width: "160px" }, { name: "DESP_DATE", text: "DATE", width: "90px" }, { name: "PCODE", text: "PARTY", width: "80px" }],
            load: function () {
                var unit = HsReport.value("Unit"), st = HsReport.value("SaleType");
                if (!unit || !st) return [];
                return $.getJSON(lookup, { what: "GetInvoices", saleType: st, unit: unit, fromDate: $("#FromDate").val(), toDate: $("#ToDate").val() });
            } });
        HsReport.picker({ id: "Copies", data: [
            { CODE: "1", DESCN: "Original for Recipient" }, { CODE: "2", DESCN: "Duplicate for Transporter" },
            { CODE: "3", DESCN: "Triplicate for Supplier" }, { CODE: "4", DESCN: "Extra Copy" }] });
        $("#FromDate, #ToDate").on("change", reloadInvoices);

        $(".out-btn").on("click", function () {
            if (!HsReport.value("Unit")) { HsReport.alert("Select a Unit."); return; }
            if (!HsReport.value("SaleType")) { HsReport.alert("Select the Sales Type."); return; }
            var inv = HsReport.value("Invoices");
            if (!inv) { HsReport.alert("Select the Invoice No(s)."); return; }
            HsReport.open('@Url.Action("Report", ctl)', {
                unit: HsReport.value("Unit"),
                saleType: HsReport.value("SaleType"),
                invoices: inv,
                withBroker: $("#WithBroker").is(":checked"),
                copies: HsReport.codes("Copies")
            });
        });
    });
</script>
