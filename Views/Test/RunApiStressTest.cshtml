
@model List<TeaSaleManagement.Controllers.Test.TestController.ApiTestResult>
@{
    ViewBag.Title = "API Stress Test Results";
}

<h2>API Stress Test Results</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Endpoint</th>
            <th>Total Runs</th>
            <th>Success Count</th>
            <th>Error Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var result in Model)
        {
            <tr>
                <td>@result.Endpoint</td>
                <td>@result.TotalRuns</td>
                <td>@result.SuccessCount</td>
                <td>@result.ErrorCount</td>
            </tr>
        }
    </tbody>
</table>


