        $('#btnSubmit').click(function (e) {
            debugger;
            // Added by SB on 050523
            var form = document.getElementById('myForm');
            for (var i = 0; i < form.elements.length; i++) {
                var element = form.elements[i];
                if ((element.value === '' || element.value.toUpperCase() === 'NAN') && element.hasAttribute('required')) {
                    var selectors = $('#' + element.id);
                    selectors.prop('required', true);
                    selectors.css('border', '1px solid red');
                    $("span").remove();
                    selectors.after("<span style='color: red;font-size: x-small;'>Required fields!</span>");
                    return false;
                }
            }
            e.preventDefault();
            var IstoVlidate = 'form';
            if ($(IstoVlidate).smkValidate()) {
                ResetTableControlNames();
                var dataString = new FormData($("#myForm").get(0));
                var redirectUrl = '/TD_PerformaInvoice/SaveForm';
                blockUIStart();
                var IstoVlidate = 'form';

                $.ajax({
                    url: redirectUrl,
                    data: dataString,
                    contentType: false,
                    processData: false,
                    cache: false,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        debugger;
                        OnSuccess2(data);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        debugger;
                        OnFailure2(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });

            }
        });

        function OnSuccess2(result) {
            debugger;
            $.unblockUI();
            if (result.success == false) {

                msgError(result.details);
                //$.notify(result.message, {
                //    globalPosition: "top center",
                //    className: "Errror"
                //})

            } else {
                // msgSuccess(result.message);
                //$('form').smkClear();

                $.confirm({

                    title: 'Confirmation !!',
                    type: 'green',
                    content: result.message,
                    typeAnimated: true,
                    icon: 'icon-smiley',
                    buttons: {

                        Okay: function (e) {


                            var url = '/Common/FinalConformation?FMode=' + result.fmode + '&submitType=' + result.submitType;
                            window.location.href = url;
                        },
                        //cancel: function () {

                        //}
                    }

                });
            }

        }

        function OnFailure2(result) {
