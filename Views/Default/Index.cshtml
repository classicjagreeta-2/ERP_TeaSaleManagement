            $.unblockUI();
        }

        function ResetTableControlNames() {
            debugger;
            var tableRows = $("#tblstock2 .RowTable");

            if (tableRows.length > 0) {
                var index = 0;
                tableRows.each(function () {
                    //set new id of row
