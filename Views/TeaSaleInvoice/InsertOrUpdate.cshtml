            if (BILL_TYPE !== '01' && !(r.RATE > 0)) return 'Line ' + r.SL_NO + ': Enter Rate !';
            if (!r._saved && r.DAMAGE_QTY > 0 && r.DAMAGE_CHECK !== 'Y') return 'Line ' + r.SL_NO + ': Damage marked Found at time of AWR. Please Check It';
            var key = r.PACK_DATE + '|' + r.INVNO + '|' + r.GRADE + (withMark ? '|' + r.MARK : '');
            if (seen[key]) return 'Line ' + r.SL_NO + ': Duplicate Entry';
            seen[key] = true;
        }
        var manual = num($('#TOT_GSTAMT_M').val());
        if ((oneType() || isAuction()) && manual > 0) {
            var sys = 0; rows.forEach(function (r) { var c = $.extend({}, r); applyTax(c); sys += c.CGST_AMT + c.SGST_AMT + c.IGST_AMT; });
            if (Math.abs(r2(manual - sys)) > 1) return 'Please Check the GST Amount Which has been entered from Invoice';
        }
        return brCheck();
    }

    var saving = false;
    function post(tcsAnswer) {
        saving = true;
        $('#btnSave').prop('disabled', true);
        $.ajax({ url: URL.save, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload(tcsAnswer)) })
            .done(function (resp) {
                if (resp && resp.success) {
                    var no = resp.data && resp.data.docno ? resp.data.docno : '';
                    showAlert('Saved successfully.' + (no ? '\nTax Invoice No. ' + no : ''), function () { window.location.href = URL.list; });
                } else if (resp && resp.tcsPrompt) {
                    // VB: "Total Gross Amount With This Bill Will Cross 50 Lacs. Do Want to apply for TCS?"
                    showConfirm(resp.message, function () { post('Y'); }, function () { post('N'); });
                } else if (resp && resp.tcsApplied) {
                    // The party is now flagged for TCS: show the invoice with TCS; the user saves again.
                    reRateAll(function () { showAlert(resp.message); });
                } else {
                    showAlert((resp && resp.message) || 'Save failed.');
                }
            })
            .fail(function (x) { failMsg(x, 'Save failed.'); })
            .always(function () { saving = false; $('#btnSave').prop('disabled', false); });
    }
    function confirmAndPost() {
        showConfirm('Are you sure? The invoice and its accounts voucher will be saved.', function () { post(null); });
    }
    $('#btnSave').on('click', function () {
        if (IS_VIEW || saving) return;
        $('#gridBody input:focus').trigger('change');
        var err = validate();
        if (err) { showAlert(err); return; }
        // VB: an auction Sale Date left blank takes the invoice date; more than one day before it asks.
        if (isAuction()) {
            var d = $('#DESP_DATE').val(), sd = $('#SALE_DATE').val();
            if (!sd) { $('#SALE_DATE').val(d); sd = d; }
            if (d > addDays(sd, 1)) {
                showConfirm('Difference Between Sale Date and Tax Invoice Date is more than 1. Want to Continue ?', confirmAndPost);
                return;
            }
        }
        confirmAndPost();
    });

    // ---------------------------------------------------------------- init
    var savedDamages = DOC.damages || [];
    rows = (DOC.lines || []).map(function (l) {
        var r = newRow($.extend({}, l, { _saved: true }));
        // Saved damage detail of the line (only "Ready To Sale" packages are stored).
        r.DAMAGES = savedDamages.filter(function (d) { return num(d.DTL_SRLNO) === num(l.SL_NO); }).map(function (d) {
            return { BAG_CHEST: num(d.BAG_CHEST), WS_QTY: flag(d.WS_QTY), BR_QTY: flag(d.BR_QTY), TR_QTY: flag(d.TR_QTY), SR_QTY: flag(d.SR_QTY), OS_QTY: flag(d.OS_QTY),
                     SR_KGS: num(d.SR_KGS), REMARK: d.REMARK || '', TAG_OK: flag(d.TAG_OK), _oldOk: flag(d.TAG_OK), DOCNO: d.DOCNO || '', AWR_DATE: iso(d.AWR_DATE) };
        });
        return r;
    });
    (DOC.brokerage || []).forEach(function (b) { var t = b.DOC_TYPE === 'T' ? 'T' : 'B'; BR[t].push(newBr(t, b)); });
    padBr();
    renderGrid();
    if (!IS_VIEW && (rows.length || brGstCodes().length)) {
        // Edit: live rates for any further change; the saved figures stay as loaded.
        fetchRates(rows.map(function (r) { return r.GRADE; }), brGstCodes(), function () { renderGrid(); });
    }
    // Leaving the page (e.g. a side-menu click) closes any dropdown still open.
    $(window).on('beforeunload pagehide', function () { $('.inputpicker-wrapped-list').hide(); });
})();
</script>
@Html.Partial("_RecordLock")
</body>
</html>
