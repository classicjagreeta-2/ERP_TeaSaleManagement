@{
    string screenName = (string)ViewBag.ScreenName;
    ViewBag.Title = screenName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = ViewBag.IsEdit ?? false;
    bool isView = ViewBag.IsView ?? false;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (CLAUDE.md "Lookup pickers"): Sale No / Sale Centre / Broker / AWR No (and the
         stock list's Garden / Mark / Category filters) are jquery.inputpicker dropdowns. -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        input[readonly], input:disabled, select:disabled { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        .accordion-container.main-accordion { height: auto; overflow-y: visible; }
        #gridTable th, #gridTable td, #nrTable th, #nrTable td { white-space: nowrap; }
        #gridTable td input { min-width: 60px; width: 80px; }
        #gridTable td input[type="checkbox"] { min-width: 0; width: auto; }
        #gridTable td.num, #gridTable th.num, #gridTable tfoot td, #nrTable td.num, #nrTable th.num { text-align: right; }
        input.num { text-align: right; }
        #gridTable td input[readonly] { cursor: default; }
        .total-box { font-weight: bold; text-align: right; }
        .nr-note { font-size: 12px; color: #666; margin: 4px 0 8px; }
        /* Pickers are as wide as their list needs (like Warehouse AWR's despatch picker), not fixed. */
        .popup-box.picker-box { display: none; width: fit-content; min-width: 560px; max-width: min(1080px, 92vw); padding: 14px 16px; }
        .popup-box.picker-box h2 { font-size: 16px; }
        .popup-box.picker-box.wide { width: fit-content; }
        .popup-box .picker-body { max-height: 50vh; overflow: auto; margin-top: 8px; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; position: sticky; top: 0; }
        .popup-box .picker-body th.num, .popup-box .picker-body td.num { text-align: right; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; white-space: nowrap; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .popup-box .picker-body tr.no-stock td { color: #999; }
        .popup-box .picker-body tfoot td { font-weight: bold; background: #f4f6fa; position: sticky; bottom: 0; }
        .popup-box .picker-empty { margin: 10px 4px 2px; font-size: 12px; color: #666; }
        /* Filter bar of the popup (same look as Catalogue Entry's "Select Stock"). */
        .stock-filters { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; align-items: center; }
        .stock-filters input[type="text"] { width: 180px; }
        .stock-filters input[type="date"] { width: 140px; }
        .stock-filters label { margin: 0; font-weight: normal; font-size: 12px; }
        .stock-filters label.chk { display: inline-flex; align-items: center; gap: 4px; font-weight: bold; }
        .stock-filters .inputpicker-overflow-hidden, .stock-filters .inputpicker-div { overflow: hidden !important; height: auto !important; max-width: 100%; }
        .stock-filters .inputpicker-div input { display: block; }
        .popup-box.alert-box { width: 440px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .action-btns li a.is-disabled, .action-btns li button:disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="purchase-details">
            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "AuctionRelease")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave" @(isView ? "disabled" : "")><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "AuctionRelease")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">Release to Auction</div></div>
                        </div>
                        <div class="title-heading">DOCUMENT NO. : <span id="hdrDocNo"></span></div>
                    </div>
                </div>
            </div>

            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                @* #UNIT_disp keeps the code that is saved; #UNIT_name shows the unit's name. *@
                                <input type="hidden" id="UNIT_disp" />
                                <input type="text" id="UNIT_name" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container main-accordion">

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Document No</label>
                                <input type="text" id="DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Date <span>(*)</span></label>
                                <input type="date" id="DOCDT" min="@ViewBag.MinDocDate" />
                            </div>
                            <div class="form-col-20">
                                <label>Sale Centre <span>(*)</span></label>
                                @* inputpicker dropdown; the saved value is the picked M_SALESCENTRE code *@
                                <input type="text" id="SALE_CENTRE" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Sale Centre Name</label>
                                <input type="text" id="SALE_CENTRE_disp" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Sale No <span>(*)</span></label>
                                @* inputpicker dropdown; the saved value is the picked Sale No, "<sale>/<year>" *@
                                <input type="text" id="SALE_NO" placeholder="Click to select" autocomplete="off" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Broker <span>(*)</span></label>
                                <input type="text" id="BROKER" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-40">
                                <label>Broker Name</label>
                                <input type="text" id="BROKER_disp" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>AWR No</label>
                                @* VB6 txtAWRNO: a filter for the stock list only (not saved); needs the Sale Centre. *@
                                <input type="text" id="AWR_NO" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20" id="parkCol" style="display:none;">
                                <label>Status</label>
                                <input type="text" id="PARK_disp" readonly value="Provisional" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Total Release Qty</label>
                                <input type="text" id="TOTAL_REL" class="num total-box" readonly value="0" />
                            </div>
                            <div class="form-col-20">
                                <label>Total Inv. Kgs.</label>
                                <input type="text" id="TOTAL_KGS" class="num total-box" readonly value="0.00" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Lot Details</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnSelectStock"><i class="fa fa-search"></i> Select Stock</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;">Sl.</th>
                                        <th>Mark</th>
                                        <th>Inv No.</th>
                                        <th>Pack Date</th>
                                        <th>Grade Code</th>
                                        <th>Grade</th>
                                        <th>Category</th>
                                        <th class="num">Pack Qty</th>
                                        <th>Arrival Date</th>
                                        <th>AWR No</th>
                                        <th class="num">AWR Qty</th>
                                        <th class="num">Alloc Qty</th>
                                        <th class="num">Offer Qty</th>
                                        <th class="num">Order Qty</th>
                                        <th class="num">Confimed /Sold Qty</th>
                                        <th class="num">Release Qty <span style="color:red;">(*)</span></th>
                                        <th>Crop Yr.</th>
                                        <th class="num">Net.Wt.</th>
                                        <th class="num">Inv. Kgs.</th>
                                        <th class="num">Total Gross Wt.</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="8" style="text-align:right;">Total</td>
                                        <td id="ftBags"></td>
                                        <td colspan="2"></td>
                                        <td id="ftAwr"></td>
                                        <td id="ftAlloc"></td>
                                        <td id="ftOffer"></td>
                                        <td></td>
                                        <td id="ftSold"></td>
                                        <td id="ftRel"></td>
                                        <td colspan="2"></td>
                                        <td id="ftTnet"></td>
                                        <td id="ftGross"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Listed, Not Released (<span id="nrCount">0</span>)</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="nr-note">
                            Lots shown in the Garden Invoice List but left untagged are saved with this document as not released
                            (Release Qty 0) -- the stock list's "All" option offers them again later.
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="nrTable">
                                <thead>
                                    <tr>
                                        <th>Mark</th>
                                        <th>Inv No.</th>
                                        <th>Pack Date</th>
                                        <th>Grade Code</th>
                                        <th>Category</th>
                                        <th class="num">Pack Qty</th>
                                        <th class="num">AWR Qty</th>
                                        <th class="num">Alloc Qty</th>
                                        <th class="num">Offer Qty</th>
                                        <th class="num">Confimed /Sold Qty</th>
                                        <th class="num">Net.Wt.</th>
                                    </tr>
                                </thead>
                                <tbody id="nrBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="popup-overlay" id="pickerOverlay"></div>

    <!-- VB6 "GardenInv_List" frame: the AWR lots that can be released (bulk multi-row selection with its own
         filters -- a composite picker, not an inputpicker). -->
    <div class="popup-box picker-box wide" id="stockPicker">
        <div class="popup-header">
            <h2>Garden Invoice List</h2>
            <button type="button" class="close-btn" id="stockClose">X</button>
        </div>
        <div class="stock-filters">
            <label>AWR Date From</label>
            <input type="date" id="stockFrom" />
            <label>AWR Date To</label>
            <input type="date" id="stockTo" />
            <label>Garden</label>
            <input type="text" id="stockGardenFilter" placeholder="Select Garden" autocomplete="off" />
            <label>Mark</label>
            <input type="text" id="stockMarkFilter" placeholder="Select Mark" autocomplete="off" />
            <label>Category</label>
            <input type="text" id="stockCategoryFilter" placeholder="Select Category" autocomplete="off" />
        </div>
        <div class="stock-filters">
            <label class="chk"><input type="checkbox" id="stockAll" /> All</label>
            <label class="chk"><input type="checkbox" id="stockPart" /> Part Invoice No Only</label>
            <button type="button" id="btnStockFilter" class="btn-blue" style="width:auto;padding:5px 14px;">Refresh</button>
            <span style="flex:1"></span>
            <label>Inv No.</label>
            <input type="text" id="stockFind" placeholder="Inv No. (Enter tags it) / find..." style="width:240px;" autocomplete="off" />
            <button type="button" id="btnStockSelectAll" class="btn-white" style="width:auto;padding:5px 14px;">Select All</button>
            <button type="button" id="btnStockDeselectAll" class="btn-white" style="width:auto;padding:5px 14px;">De-Select All</button>
            <span id="stockCount" style="font-size:12px;color:#666;"></span>
        </div>
        <div class="picker-body" id="stockBody"></div>
        <div style="text-align:right;padding-top:10px;">
            <button type="button" class="btn-blue" id="btnStockOk" style="width:auto;padding:5px 16px;">OK</button>
            <button type="button" class="btn-white" id="btnStockCancel" style="width:auto;padding:5px 16px;">Cancel</button>
        </div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
(function () {
    var IS_EDIT = @(isEdit ? "true" : "false");
    var IS_VIEW = @(isView ? "true" : "false");
    var DOC = @Html.Raw(ViewBag.DocJson ?? "{}");
    var H = DOC.head || {};
    var URL = {
        saleNo: '@Url.Action("GetSaleNo", "AuctionRelease")',
        centre: '@Url.Action("GetSalesCentre", "AuctionRelease")',
        broker: '@Url.Action("GetBroker", "AuctionRelease")',
        awrNo: '@Url.Action("GetAwrNo", "AuctionRelease")',
        category: '@Url.Action("GetCategory", "AuctionRelease")',
        mark: '@Url.Action("GetMark", "AuctionRelease")',
        garden: '@Url.Action("GetGarden", "AuctionRelease")',
        stock: '@Url.Action("GetAvailableStock", "AuctionRelease")',
        save: '@Url.Action("Save", "AuctionRelease")',
        list: '@Url.Action("Index", "AuctionRelease")'
    };
    var MAX_LINES = 998;                // VB6 detailno = 999
    var MAX_REL = 99999999.99;          // T_AUCTION_RELEASE.RELEASE_QTY NUMBER(10,2)

    // ---------------------------------------------------------------- helpers
    $('#pickerOverlay, #stockPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function r2(v) { v = num(v); var s = v < 0 ? -1 : 1; return s * Math.round(Math.abs(v) * 100 + 1e-7) / 100; }
    function f2(v) { return r2(v).toFixed(2); }
    function fc(v) { return String(r2(v)); }            // bags: no forced decimals
    function iso(d) { return d ? String(d).substring(0, 10) : ''; }
    function dmy(d) { d = iso(d); return d ? d.substring(8, 10) + '/' + d.substring(5, 7) + '/' + d.substring(0, 4) : ''; }
    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function closeAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) { AppMsg.show(message, onOk); }
    function showConfirm(message, onYes, onNo) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', function () { closeAlert(); if (onNo) onNo(); });
        $('#appAlertOk').off('click').on('click', function () { closeAlert(); onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function failMsg(x, fallback) {
        if (x && x.status === 440) {
            showAlert((x.responseJSON && x.responseJSON.message) || 'Your session has expired. Please log in again.', function () { window.location.reload(); });
            return;
        }
        if (x && x.statusText === 'abort') return;
        showAlert((x && x.responseJSON && x.responseJSON.message) || fallback || 'Could not load data. Please try again.');
    }

    // Numeric-only inputs: digits and one decimal point, at most 2 decimals, right aligned.
    function sanitizeNum(el) {
        var v = el.value, clean = v.replace(/[^0-9.]/g, '');
        var dot = clean.indexOf('.');
        if (dot >= 0) {
            var frac = clean.substring(dot + 1).replace(/\./g, '');
            clean = clean.substring(0, dot + 1) + frac.substring(0, 2);
        }
        if (clean !== v) el.value = clean;
    }
    $(document).on('keypress', 'input.num:not([readonly])', function (e) {
        var ch = String.fromCharCode(e.which);
        if (e.which < 32) return;
        if (!/[0-9.]/.test(ch) || (ch === '.' && this.value.indexOf('.') >= 0 && this.selectionStart === this.selectionEnd)) e.preventDefault();
    });
    $(document).on('input paste', 'input.num:not([readonly])', function () { var el = this; setTimeout(function () { sanitizeNum(el); }, 0); });

    // ---------------------------------------------------------------- state
    var FY_START = iso(H.FY_START), FY_END = iso(H.FY_END);
    var TODAY = iso(H.TODAY) || new Date().toISOString().substring(0, 10);
    // The Unit is locked: a NEW release carries the one picked on the list's "New" row (server-checked against
    // the user's units), an edit the release's own. UNIT is what Save posts -- see payload().
    var UNIT = H.UNIT || '';
    // VB6 loca1: on "JST" the stock list opens empty (Command3_Click forces mark = '  ' while the frame is hidden).
    var LOCA = H.LOCA || '';
    // Doc Date lower bound from the AEDV back-date window (ViewBag.MinDocDate = later of the FY start and
    // today - Aday); Save re-checks it server-side.
    var MIN_DOC = '@ViewBag.MinDocDate';
    var rows = [], notReleased = [], seq = 0;

    // ---------------------------------------------------------------- header
    $('#UNIT_disp').val(UNIT);                                        // the code that is saved
    $('#UNIT_name').val(H.UNIT_NAME || UNIT).attr('title', UNIT);     // the Unit's description
    $('#DOCNO').val(H.DOCNO || '');
    $('#hdrDocNo').text(H.DOCNO || '');
    $('#SALE_NO').val(H.SALE_NO || '');
    $('#SALE_CENTRE').val(H.SALE_CENTRE || ''); $('#SALE_CENTRE_disp').val(H.SALE_CENTRE_NAME || '');
    $('#BROKER').val(H.BROKER || ''); $('#BROKER_disp').val(H.BROKER_NAME || '');
    // VB6 ChkProvisional is hidden; a provisional release (PARK 'Y') is only shown, and Save keeps it.
    if (H.PARK === 'Y') $('#parkCol').show();
    $('#stockFrom').val(iso(H.AWR_FROM));
    $('#stockTo').val(iso(H.AWR_TO));

    if (IS_EDIT) {
        // Doc Date is part of the release's key (Unit + Document No + Date): fixed once saved.
        $('#DOCDT').val(iso(H.DOCDT)).prop('disabled', true);
    } else {
        // VB6 blankrec: today, or the year end once the year is over; never a future date.
        var maxDt = TODAY < FY_END ? TODAY : FY_END;
        var minDt = FY_START;
        if (MIN_DOC && MIN_DOC > minDt) minDt = MIN_DOC;
        $('#DOCDT').attr('min', minDt).attr('max', maxDt).val(maxDt < minDt ? minDt : maxDt);
    }

    function applyModeUi() {
        $('#SALE_NO, #SALE_CENTRE, #BROKER').prop('readonly', IS_VIEW).attr('placeholder', IS_VIEW ? '' : 'Click to select');
        // VB6 frmrfsh: the AWR No box is enabled on a new release only.
        $('#AWR_NO').prop('readonly', IS_VIEW || IS_EDIT).attr('placeholder', (IS_VIEW || IS_EDIT) ? '' : 'Click to select');
        $('#btnSelectStock, #btnRemoveRows').toggleClass('is-disabled', IS_VIEW);
        if (IS_VIEW) $('input, select, textarea').prop('disabled', true);
    }

    // ---------------------------------------------------------------- lines
    function lineKey(r) { return [r.INVNO || '', iso(r.PACK_DATE), r.GRADE || '', r.MARK || ''].join('|').toUpperCase(); }

    function newRow(src) {
        var r = $.extend({
            MARK: '', MARK_NAME: '', INVNO: '', PACK_DATE: '', GRADE: '', GRADE_NAME: '', CAT: '', CATEGORY: '', SEASON: '',
            ARRIVAL_DATE: '', AWR_NO: '', BAG_CHEST: 0, NET_WT: 0, TNET_WT: 0, TGROSS_WT: 0, GROSS_BAG: 0,
            AWR_QTY: 0, ALLOC_QTY: 0, OFFER_QTY: 0, ORDER_QTY: 0, SOLD_QTY: 0, RELEASE_QTY: 0
        }, src || {});
        ['MARK', 'MARK_NAME', 'INVNO', 'GRADE', 'GRADE_NAME', 'CAT', 'CATEGORY', 'SEASON', 'AWR_NO'].forEach(function (k) { r[k] = r[k] || ''; });
        r.PACK_DATE = iso(r.PACK_DATE);
        r.ARRIVAL_DATE = iso(r.ARRIVAL_DATE);
        ['BAG_CHEST', 'NET_WT', 'TNET_WT', 'TGROSS_WT', 'AWR_QTY', 'ALLOC_QTY', 'OFFER_QTY', 'ORDER_QTY', 'SOLD_QTY', 'RELEASE_QTY'].forEach(function (k) { r[k] = r2(r[k]); });
        r.GROSS_BAG = num(r.GROSS_BAG);
        r._cid = ++seq;
        return r;
    }
    // VB6 DATAGRID1_BeforeColUpdate: Release Qty may not exceed AWR Qty - (Order Qty + Sold Qty).
    function maxRelease(r) { var b = r2(num(r.AWR_QTY) - (num(r.ORDER_QTY) + num(r.SOLD_QTY))); return b < 0 ? 0 : b; }
    function ro() { return IS_VIEW ? ' readonly tabindex="-1"' : ''; }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        rows.forEach(function (r, i) {
            r.SRLNO = i + 1;
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" ' + (IS_VIEW ? 'disabled' : '') + ' /></td>');
            tr.append('<td>' + r.SRLNO + '</td>');
            tr.append('<td title="' + esc(r.MARK) + '">' + esc(r.MARK_NAME || r.MARK) + '</td>');
            tr.append('<td>' + esc(r.INVNO) + '</td>');
            tr.append('<td>' + esc(dmy(r.PACK_DATE)) + '</td>');
            tr.append('<td>' + esc(r.GRADE) + '</td>');
            tr.append('<td>' + esc(r.GRADE_NAME) + '</td>');
            tr.append('<td>' + esc(r.CATEGORY) + '</td>');
            tr.append('<td class="num">' + fc(r.BAG_CHEST) + '</td>');
            tr.append('<td>' + esc(dmy(r.ARRIVAL_DATE)) + '</td>');
            tr.append('<td>' + esc(r.AWR_NO) + '</td>');
            tr.append('<td class="num">' + fc(r.AWR_QTY) + '</td>');
            tr.append('<td class="num">' + fc(r.ALLOC_QTY) + '</td>');
            tr.append('<td class="num">' + fc(r.OFFER_QTY) + '</td>');
            tr.append('<td class="num">' + fc(r.ORDER_QTY) + '</td>');
            tr.append('<td class="num">' + fc(r.SOLD_QTY) + '</td>');
            tr.append('<td class="num"><input type="text" inputmode="decimal" class="num f-rel" value="' + fc(r.RELEASE_QTY) + '"' + ro() +
                      ' title="At most ' + fc(maxRelease(r)) + '" /></td>');
            tr.append('<td>' + esc(r.SEASON) + '</td>');
            tr.append('<td class="num">' + f2(r.NET_WT) + '</td>');
            tr.append('<td class="num c-TNET_WT">' + f2(r.TNET_WT) + '</td>');
            tr.append('<td class="num c-TGROSS_WT">' + f2(r.TGROSS_WT) + '</td>');
            $tb.append(tr);
        });
        if (!rows.length) $tb.append('<tr><td colspan="21" style="text-align:center;color:#666;">Use "Select Stock" to pick the lots to release.</td></tr>');
        refreshTotals();
    }

    // VB6 grid footers: Pack Qty, AWR / Alloc / Offer / Sold / Release Qty, Inv. Kgs, Total Gross Wt.
    function refreshTotals() {
        var t = { BAG_CHEST: 0, AWR_QTY: 0, ALLOC_QTY: 0, OFFER_QTY: 0, SOLD_QTY: 0, RELEASE_QTY: 0, TNET_WT: 0, TGROSS_WT: 0 };
        rows.forEach(function (r) { for (var k in t) t[k] += num(r[k]); });
        $('#ftBags').text(fc(t.BAG_CHEST)); $('#ftAwr').text(fc(t.AWR_QTY)); $('#ftAlloc').text(fc(t.ALLOC_QTY));
        $('#ftOffer').text(fc(t.OFFER_QTY)); $('#ftSold').text(fc(t.SOLD_QTY)); $('#ftRel').text(fc(t.RELEASE_QTY));
        $('#ftTnet').text(f2(t.TNET_WT)); $('#ftGross').text(f2(t.TGROSS_WT));
        $('#TOTAL_REL').val(fc(t.RELEASE_QTY)); $('#TOTAL_KGS').val(f2(t.TNET_WT));
    }

    function renderNotReleased() {
        // A lot released on this document is never kept as "not released" too.
        var have = {};
        rows.forEach(function (r) { have[lineKey(r)] = true; });
        notReleased = notReleased.filter(function (n) { return !have[lineKey(n)]; });
        var $tb = $('#nrBody').empty();
        notReleased.forEach(function (n) {
            $tb.append('<tr><td title="' + esc(n.MARK) + '">' + esc(n.MARK_NAME || n.MARK) + '</td><td>' + esc(n.INVNO) + '</td><td>' + esc(dmy(n.PACK_DATE)) +
                '</td><td>' + esc(n.GRADE) + '</td><td>' + esc(n.CATEGORY) + '</td><td class="num">' + fc(n.BAG_CHEST) + '</td><td class="num">' + fc(n.AWR_QTY) +
                '</td><td class="num">' + fc(n.ALLOC_QTY) + '</td><td class="num">' + fc(n.OFFER_QTY) + '</td><td class="num">' + fc(n.SOLD_QTY) +
                '</td><td class="num">' + f2(n.NET_WT) + '</td></tr>');
        });
        if (!notReleased.length) $tb.append('<tr><td colspan="11" style="text-align:center;color:#666;">None</td></tr>');
        $('#nrCount').text(notReleased.length);
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    // VB6 DATAGRID1_BeforeColUpdate, Release Qty: "Bag can't be Greater than n"; otherwise Inv. Kgs = Net Wt x
    // Release Qty and Total Gross Wt = the AWR lot's gross per bag x Release Qty.
    $('#gridBody').on('change', 'input.f-rel', function () {
        var $tr = $(this).closest('tr'), r = findRow($tr.data('cid')); if (!r || IS_VIEW) return;
        var v = r2(this.value), max = maxRelease(r);
        if (v > max) { showAlert("Bag can't be Greater than " + fc(max)); v = r.RELEASE_QTY; }
        if (v > MAX_REL) { showAlert('Release Qty is too large.'); v = r.RELEASE_QTY; }
        r.RELEASE_QTY = v;
        this.value = fc(v);
        r.TNET_WT = r2(num(r.NET_WT) * v);
        if (num(r.GROSS_BAG) > 0) r.TGROSS_WT = r2(num(r.GROSS_BAG) * v);
        $tr.find('.c-TNET_WT').text(f2(r.TNET_WT));
        $tr.find('.c-TGROSS_WT').text(f2(r.TGROSS_WT));
        refreshTotals();
    });
    $('#gridBody').on('focus', 'input.num:not([readonly])', function () { var el = this; setTimeout(function () { el.select(); }, 0); });
    // Enter moves to the next row's Release Qty, as in the VB6 grid.
    $('#gridBody').on('keydown', 'input', function (e) {
        if (e.which !== 13) return;
        e.preventDefault();
        $(this).trigger('change');
        var $all = $('#gridBody input.f-rel:not([readonly])');
        var i = $all.index(this);
        if (i >= 0 && i < $all.length - 1) $all.eq(i + 1).focus(); else $('#btnSave').focus();
    });

    $('#chkAll').on('change', function () { $('.rowChk:not(:disabled)').prop('checked', $(this).is(':checked')); });
    // VB6 datagrid1 AllowDelete (+ AfterDelete renumbering).
    $('#btnRemoveRows').on('click', function () {
        if (IS_VIEW) return;
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        $('#chkAll').prop('checked', false);
        renderGrid();
    });

    // ---------------------------------------------------------------- lookups
    // jquery.inputpicker dropdowns (Root UI convention, CLAUDE.md "Lookup pickers"): anchored under the field,
    // paged, and searched server-side on EVERY column shown (the MVC picker actions take (q, limit, ..., p) and
    // reply { data, count }). The first field is the value written to the box.
    var CODE_NAME = [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }];
    var LOOKUPS = {
        saleNo: { url: URL.saleNo, fields: [{ name: 'SALE_NO', text: 'Sale No' }, { name: 'CODE', text: 'Sale' }, { name: 'YEAR_CD', text: 'Year' }] },
        centre: { url: URL.centre, fields: CODE_NAME },
        broker: { url: URL.broker, fields: CODE_NAME },
        awrNo: { url: URL.awrNo, fields: [{ name: 'AWR_NO', text: 'AWR No' }, { name: 'MARK', text: 'Mark' }, { name: 'AWR_DATE', text: 'AWR Date' }], selectMode: 'empty' },
        category: { url: URL.category, fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Category' }] },
        mark: { url: URL.mark, fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Mark' }, { name: 'GARDEN', text: 'Garden' }] },
        garden: { url: URL.garden, urlParam: { unit: UNIT }, fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Garden' }] }
    };

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the plugin writes
    // the picked value into the original input and fires "change" on it; it does not hand the row to a select
    // handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    // Open the dropdown AND refresh its rows (the plugin only re-renders on a keystroke).
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    function pickerOptions(cfg) {
        var o = {
            url: cfg.url,
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2      // seconds (the plugin multiplies by 1000): one request per pause in typing
        };
        if (cfg.urlParam) o.urlParam = cfg.urlParam;
        if (cfg.selectMode) o.selectMode = cfg.selectMode;
        return o;
    }

    function visibleInput($orig) { return $orig.next('.inputpicker-overflow-hidden').find('input'); }

    function openLookup(key, $input, onSelect, onClear) {
        var cfg = LOOKUPS[key];
        $('.inputpicker-wrapped-list').remove();

        // This plugin never sets $.data('inputpicker'); the class it puts on the original input is the
        // "already initialised" test. Showing is deferred a tick so the click's own bubbling doesn't hide it.
        if ($input.hasClass('inputpicker-original')) {
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker(pickerOptions(cfg));
        setTimeout(function () { showPickerList($input); }, 0);

        function deliver(row) { if (row && onSelect) onSelect(row); }
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
        if (onClear) {
            visibleInput($input).on('input', function () {
                if (!$(this).val() && $input.val()) { $input.val(''); $(this).data('value', ''); onClear(); }
            });
        }
    }

    // Sale No (VB6 txtSaleNo).
    $('#SALE_NO').on('click focus', function () {
        if (IS_VIEW) return;
        openLookup('saleNo', $(this));
    });
    // Sale Centre (VB6 txtSalesCentre). The AWR No belongs to a Sale Centre, so a new centre clears it.
    $('#SALE_CENTRE').on('click focus', function () {
        if (IS_VIEW) return;
        openLookup('centre', $(this), function (c) {
            $('#SALE_CENTRE_disp').val(c.NAME || '');
            if ($('#AWR_NO').val()) { $('#AWR_NO').val(''); visibleInput($('#AWR_NO')).val('').data('value', ''); }
        });
    });
    // Broker (VB6 txtBroker, auction brokers only).
    $('#BROKER').on('click focus', function () {
        if (IS_VIEW) return;
        openLookup('broker', $(this), function (b) { $('#BROKER_disp').val(b.NAME || ''); });
    });
    // AWR No (VB6 txtawrno_buttonclick): needs the Sale Centre first; a filter for the stock list.
    $('#AWR_NO').on('click focus', function () {
        if (IS_VIEW || IS_EDIT) return;
        if (!$('#SALE_CENTRE').val()) { showAlert('Please Select Sale Centre First'); $(this).blur(); return; }
        // The list is the Sale Centre's: re-point an already initialised picker at the current centre.
        LOOKUPS.awrNo.urlParam = { saleCentre: $('#SALE_CENTRE').val() };
        if ($(this).hasClass('inputpicker-original')) $(this).inputpicker('set', 'urlParam', LOOKUPS.awrNo.urlParam);
        openLookup('awrNo', $(this), null, function () { });
    });

    // ---------------------------------------------------------------- Garden Invoice List popup
    var stockRows = [], stockReq = 0;

    // Garden / Mark / Category filters: dropdowns initialised on first open (the popup is display:none until
    // then, and the plugin sizes itself from the field's rendered width).
    function initStockFilter($orig, cfg) {
        if ($orig.hasClass('inputpicker-original')) return;
        var opts = pickerOptions(cfg);
        opts.selectMode = 'empty';     // typed text that isn't picked from the list is discarded
        $orig.inputpicker(opts);
        // Wiping the visible text is how a filter is removed.
        visibleInput($orig).on('input', function () {
            if (!$(this).val() && $orig.val()) { $orig.val(''); $(this).data('value', ''); }
        });
    }
    function clearFilter($orig) { $orig.val(''); visibleInput($orig).val('').data('value', ''); }

    // VB6 datagrid1_ButtonClick: the Garden / Mark filters are cleared, then Command3_Click runs while the frame
    // is still hidden -- which lists nothing unless an AWR No is given (and, on "JST", nothing at all).
    function openStock() {
        if (IS_VIEW) return;
        if (rows.length >= MAX_LINES) { showAlert('An auction release can hold at most ' + MAX_LINES + ' lots.'); return; }
        $('#stockFind').val('');
        clearFilter($('#stockGardenFilter')); clearFilter($('#stockMarkFilter'));
        stockRows = [];
        $('#pickerOverlay, #stockPicker').fadeIn(120, function () {
            initStockFilter($('#stockGardenFilter'), LOOKUPS.garden);
            initStockFilter($('#stockMarkFilter'), LOOKUPS.mark);
            initStockFilter($('#stockCategoryFilter'), LOOKUPS.category);
        });
        if ($('#AWR_NO').val() && LOCA !== 'JST') loadStock();
        else { renderStock(); $('#stockBody').append('<p class="picker-empty">Set the filters and click Refresh.</p>'); }
    }
    function closeStock() { $('.inputpicker-wrapped-list').hide(); $('#pickerOverlay, #stockPicker').fadeOut(120); }

    // VB6 Command3_Click "Refresh".
    function loadStock() {
        var reqId = ++stockReq;
        $('.inputpicker-wrapped-list').hide();
        stockRows = [];
        $('#stockCount').text('');
        $('#stockBody').html('<p class="picker-empty">Loading...</p>');
        $.getJSON(URL.stock, {
            unit: UNIT,
            docno: IS_EDIT ? (H.DOCNO || '') : '',
            docdt: IS_EDIT ? iso(H.DOCDT) : '',
            saleCentre: $('#SALE_CENTRE').val(),
            awrNo: $('#AWR_NO').val(),
            mark: $('#stockMarkFilter').val(),
            garden: $('#stockGardenFilter').val(),
            category: $('#stockCategoryFilter').val(),
            awrFrom: $('#stockFrom').val(),
            awrTo: $('#stockTo').val(),
            partInvoice: $('#stockPart').is(':checked'),
            all: $('#stockAll').is(':checked')
        }).done(function (data) {
            if (reqId !== stockReq) return;
            var have = {};
            rows.forEach(function (r) { have[lineKey(r)] = true; });
            // Lots already released on the document are left out of the list.
            stockRows = (data || []).filter(function (d) { return !have[lineKey(d)]; })
                                    .map(function (d, i) { d._i = i; d._sel = !!d.TAG; return d; });
            renderStock();
        }).fail(function (x) {
            if (reqId !== stockReq) return;
            $('#stockBody').html('<p class="picker-empty">Could not load the stock. Click Refresh to try again.</p>');
            failMsg(x);
        });
    }

    // VB6 TDBGrid1 columns.
    var STOCK_COLS = [['MARK_NAME', 'Mark'], ['INVNO', 'Inv No.'], ['GRADE', 'Grade Code'], ['PACK_DATE', 'Pack Date', 'date'], ['GRADE_NAME', 'Grade'],
                      ['CHESTSLF', 'Start No.'], ['CHESTSLT', 'End No.'], ['CATEGORY', 'Category'], ['TNET_WT', 'Total Net.Wt.', 'num'],
                      ['BAG_CHEST', 'Pack Qty', 'cnt'], ['NET_WT', 'Net.Wt.', 'num'], ['TGROSS_WT', 'Total Gross Wt.', 'num'],
                      ['ARRIVAL_DATE', 'Arrival Date', 'date'], ['AWR_NO', 'AWR No'], ['AWR_QTY', 'AWR Qty', 'cnt'], ['ALLOC_QTY', 'Alloc. Qty', 'cnt'],
                      ['OFFER_QTY', 'Offer Qty', 'cnt'], ['ORDER_QTY', 'Order Qty', 'cnt'], ['SOLD_QTY', 'Conf. /Sold Qty', 'cnt'], ['BAL_QTY', 'Bal Qty', 'cnt'],
                      ['DESTINATION', 'Destination'], ['WAREHOUSE', 'Warehouse']];
    var STOCK_FOOT = { AWR_QTY: 1, ALLOC_QTY: 1, OFFER_QTY: 1, SOLD_QTY: 1, BAL_QTY: 1 };   // VB6 TDBGrid1 footers
    function isNumKind(k) { return k === 'num' || k === 'cnt'; }
    function cellText(v, kind) { return kind === 'date' ? dmy(v) : kind === 'num' ? f2(v) : kind === 'cnt' ? fc(v) : (v == null ? '' : String(v)); }
    function cell(v, kind) { return '<td' + (isNumKind(kind) ? ' class="num"' : '') + '>' + esc(cellText(v, kind)) + '</td>'; }
    function stockText(d) {
        return STOCK_COLS.map(function (c) { return cellText(d[c[0]], c[2]); }).concat([d.MARK || '', d.GINVNO || '']).join(' ').toUpperCase();
    }
    function shownStock() {
        var term = $.trim($('#stockFind').val()).toUpperCase();
        return stockRows.filter(function (d) { return !term || stockText(d).indexOf(term) >= 0; });
    }
    function renderStock() {
        var shown = shownStock();
        var html = '<table><thead><tr><th style="width:30px;">Tag</th>' +
            STOCK_COLS.map(function (c) { return '<th' + (isNumKind(c[2]) ? ' class="num"' : '') + '>' + c[1] + '</th>'; }).join('') + '</tr></thead><tbody>';
        var tot = {};
        shown.forEach(function (d) {
            html += '<tr data-i="' + d._i + '"' + (num(d.BAL_QTY) > 0 ? '' : ' class="no-stock"') + '><td><input type="checkbox" class="stockChk"' + (d._sel ? ' checked' : '') + ' /></td>' +
                STOCK_COLS.map(function (c) { return cell(d[c[0]], c[2]); }).join('') + '</tr>';
        });
        stockRows.forEach(function (d) { for (var k in STOCK_FOOT) tot[k] = (tot[k] || 0) + num(d[k]); });
        html += '</tbody>';
        if (stockRows.length) {
            html += '<tfoot><tr><td></td>' + STOCK_COLS.map(function (c) {
                return '<td' + (isNumKind(c[2]) ? ' class="num"' : '') + '>' + (STOCK_FOOT[c[0]] ? esc(fc(tot[c[0]])) : '') + '</td>';
            }).join('') + '</tr></tfoot>';
        }
        html += '</table>';
        if (!stockRows.length) html += '<p class="picker-empty">No lot is available for the selected filters.</p>';
        else if (!shown.length) html += '<p class="picker-empty">No lot matches the search.</p>';
        $('#stockBody').html(html);
        $('#stockCount').text(stockRows.length ? shown.length + ' of ' + stockRows.length + ' lots, ' +
            stockRows.filter(function (d) { return d._sel; }).length + ' tagged' : '');
    }
    function stockAt(i) { for (var k = 0; k < stockRows.length; k++) { if (stockRows[k]._i == i) return stockRows[k]; } return null; }

    // VB6 TDBGrid1_AfterColUpdate: a lot without stock (Bal Qty 0) cannot be tagged.
    function setSel(d, on) {
        if (on && !(num(d.BAL_QTY) > 0)) { showAlert("No Stock. Can't be Selected"); return false; }
        d._sel = on;
        return true;
    }
    $('#stockBody').on('click', 'tr[data-i]', function (e) {
        var d = stockAt($(this).data('i')); if (!d) return;
        var $chk = $(this).find('.stockChk');
        var want = $(e.target).is('.stockChk') ? $chk.is(':checked') : !d._sel;
        if (!setSel(d, want)) want = false;
        $chk.prop('checked', d._sel);
        $('#stockCount').text(shownStock().length + ' of ' + stockRows.length + ' lots, ' +
            stockRows.filter(function (x) { return x._sel; }).length + ' tagged');
    });
    $('#stockFind').on('input', renderStock);
    // VB6 txtInvNo_Validate: Enter tags the lot whose Inv No was typed.
    $('#stockFind').on('keydown', function (e) {
        if (e.which !== 13) return;
        e.preventDefault();
        var term = $.trim(this.value).toUpperCase();
        if (!term) return;
        var hit = stockRows.filter(function (d) { return String(d.INVNO || '').toUpperCase() === term; });
        if (!hit.length) { showAlert('Garden InvNo Not Found'); this.value = ''; renderStock(); return; }
        hit.forEach(function (d) { setSel(d, true); });
        this.value = '';
        renderStock();
    });
    $('#btnStockFilter').on('click', loadStock);
    // "All" and "Part Invoice No Only" are separate lists in VB6 (ChkBalance wins over ChkAllocated).
    $('#stockPart').on('change', function () { $('#stockAll').prop('disabled', $(this).is(':checked')); });
    // VB6 Command50 / Command15: Select All / De-Select All (of the rows shown). Like VB6, Select All tags
    // every row, stock or not.
    $('#btnStockSelectAll').on('click', function () { shownStock().forEach(function (d) { d._sel = true; }); renderStock(); });
    $('#btnStockDeselectAll').on('click', function () { shownStock().forEach(function (d) { d._sel = false; }); renderStock(); });
    $('#stockClose, #btnStockCancel').on('click', closeStock);
    $('#btnSelectStock').on('click', openStock);

    // VB6 Command6_Click "OK": each tagged lot goes on the grid with Release Qty = Bal Qty and Inv. Kgs = Net Wt x
    // Bal Qty; each untagged lot is kept as "not released" (saved with AUCTION 'N', Release Qty 0).
    $('#btnStockOk').on('click', function () {
        var picked = stockRows.filter(function (d) { return d._sel; });
        if (rows.length + picked.length > MAX_LINES) { showAlert('An auction release can hold at most ' + MAX_LINES + ' lots.'); return; }
        var nrHave = {};
        notReleased.forEach(function (n) { nrHave[lineKey(n)] = true; });
        stockRows.forEach(function (d) {
            var src = {
                MARK: d.MARK, MARK_NAME: d.MARK_NAME, INVNO: d.INVNO, PACK_DATE: d.PACK_DATE, GRADE: d.GRADE, GRADE_NAME: d.GRADE_NAME,
                CAT: d.CAT, CATEGORY: d.CATEGORY, SEASON: d.SEASON, ARRIVAL_DATE: d.ARRIVAL_DATE, AWR_NO: d.AWR_NO,
                BAG_CHEST: d.BAG_CHEST, NET_WT: d.NET_WT, TGROSS_WT: d.TGROSS_WT, GROSS_BAG: d.GROSS_BAG,
                AWR_QTY: d.AWR_QTY, ALLOC_QTY: d.ALLOC_QTY, OFFER_QTY: d.OFFER_QTY, ORDER_QTY: d.ORDER_QTY, SOLD_QTY: d.SOLD_QTY
            };
            if (d._sel) {
                src.RELEASE_QTY = d.BAL_QTY;
                src.TNET_WT = r2(num(d.NET_WT) * num(d.BAL_QTY));
                rows.push(newRow(src));
            } else if (!nrHave[lineKey(d)]) {
                src.RELEASE_QTY = 0;
                src.TNET_WT = r2(num(d.NET_WT) * num(d.BAL_QTY));
                notReleased.push(newRow(src));
                nrHave[lineKey(d)] = true;
            }
        });
        closeStock();
        renderGrid();
        renderNotReleased();
        $('#gridBody input.f-rel').first().focus();
    });

    // ---------------------------------------------------------------- save
    function lineOut(r) {
        return {
            CAT: r.CAT, MARK: r.MARK, INVNO: r.INVNO, PACK_DATE: r.PACK_DATE || null, GRADE: r.GRADE,
            BAG_CHEST: r2(r.BAG_CHEST), NET_WT: r2(r.NET_WT), TNET_WT: r2(r.TNET_WT), TGROSS_WT: r2(r.TGROSS_WT),
            AWR_QTY: r2(r.AWR_QTY), ALLOC_QTY: r2(r.ALLOC_QTY), OFFER_QTY: r2(r.OFFER_QTY), ORDER_QTY: r2(r.ORDER_QTY),
            SOLD_QTY: r2(r.SOLD_QTY), RELEASE_QTY: r2(r.RELEASE_QTY)
        };
    }
    function payload() {
        return {
            // UNIT: the locked Unit (see state above). IsNew lets the server apply the AEDV Add / Edit right and
            // back-date window (AuctionReleaseController.Save).
            UNIT: $('#UNIT_disp').val(), IsNew: !IS_EDIT,
            DOCNO: $('#DOCNO').val() || null, DOCDT: $('#DOCDT').val() || null,
            SALE_NO: $('#SALE_NO').val(), SALE_CENTRE: $('#SALE_CENTRE').val(), BROKER: $('#BROKER').val(),
            LINES: rows.map(lineOut),
            NOT_RELEASED: notReleased.map(lineOut)
        };
    }

    // VB6 txtDocdt_Validate + Command1_Click (same order and messages).
    function validate() {
        var d = $('#DOCDT').val();
        if (!d) return 'INVALID DATE !';
        if (!IS_EDIT) {
            if (d > TODAY) return 'Can not enter future date ' + dmy(d);
            if (d < FY_START || d > FY_END) return 'Date not between financial Year';
            if (d < ($('#DOCDT').attr('min') || '') || d > ($('#DOCDT').attr('max') || '9999')) {
                return 'Date must be between ' + dmy($('#DOCDT').attr('min')) + ' and ' + dmy($('#DOCDT').attr('max')) + '.';
            }
        }
        if (!$('#SALE_CENTRE').val()) return 'Sales Centre cannot be blank';
        if (!$('#BROKER').val()) return 'Broker cannot be blank';
        if (!$('#SALE_NO').val()) return 'Sale No cannot be blank';
        if (!rows.length) return 'No Record in Datagrid to Save';
        if (rows.length > MAX_LINES) return 'An auction release can hold at most ' + MAX_LINES + ' lots.';
        var seen = {};
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i], at = 'Line ' + r.SRLNO + ': ';
            if (!r.INVNO) return i === 0 ? 'Without Invoice Detail, Record Can Not be Saved.' : at + 'select the Invoice.';
            if (!(r.RELEASE_QTY > 0)) return at + 'Enter Release Qty Detail !';
            var k = [r.INVNO, r.GRADE, iso(r.PACK_DATE)].join('|').toUpperCase();
            if (seen[k]) return at + 'Duplicate Entry (Inv No ' + r.INVNO + ')';
            seen[k] = true;
            if (r.RELEASE_QTY > maxRelease(r)) return at + "Bag can't be Greater than " + fc(maxRelease(r)) + ' (Inv No ' + r.INVNO + ')';
        }
        return null;
    }

    var saving = false;
    $('#btnSave').on('click', function () {
        if (IS_VIEW || saving) return;
        $('#gridBody input:focus').trigger('change');
        var err = validate();
        if (err) { showAlert(err); return; }
        showConfirm('Are you sure?', function () {
            saving = true;
            $('#btnSave').prop('disabled', true);
            $.ajax({ url: URL.save, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload()) })
                .done(function (resp) {
                    if (resp && resp.success) {
                        var no = resp.data && resp.data.docno ? resp.data.docno : '';
                        showAlert('Saved successfully.' + (no ? '\n' + 'Document No. ' + no : ''), function () { window.location.href = URL.list; });
                    } else {
                        showAlert((resp && resp.message) || 'Save failed.');
                    }
                })
                .fail(function (x) { failMsg(x, 'Save failed.'); })
                .always(function () { saving = false; $('#btnSave').prop('disabled', false); });
        });
    });

    // ---------------------------------------------------------------- init
    rows = (DOC.lines || []).map(function (l) { return newRow(l); });
    notReleased = (DOC.notReleased || []).map(function (l) { return newRow(l); });
    renderGrid();
    renderNotReleased();
    applyModeUi();
    // Leaving the page (e.g. a side-menu click) closes any dropdown still open.
    $(window).on('beforeunload pagehide', function () { $('.inputpicker-wrapped-list').hide(); });
})();
</script>
@Html.Partial("_RecordLock")
</body>
</html>
