@{
    string screenName = (string)ViewBag.ScreenName;
    ViewBag.Title = screenName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEdit = ViewBag.IsEdit ?? false;
    bool isView = ViewBag.IsView ?? false;
}

<!doctype html>
<html lang="en">
<head>
    <link href="~/libraries/assetspo/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order.css">
    <link rel="stylesheet" href="~/libraries/assetspo/css/purchase-order-responsive.css">
    <!-- Root UI lookup convention (CLAUDE.md "Lookup pickers"): Sale Type / Sale Centre / Warehouse / Broker /
         Party, the grid's Sale No and the stock filters are jquery.inputpicker dropdowns. Only the bulk
         "Select Data" (warehouse AWR stock) picker is a bespoke modal: a composite multi-row selection. -->
    <link href="~/Controllers/Test/assets/css/jquery.inputpicker.css" rel="stylesheet" />
    <script src="~/libraries/assetspo/js/custom.js"></script>
    <script src="~/Controllers/Test/assets/js/jquery.inputpicker.js"></script>
    <style>
        .inputpicker-wrapped-list .inputpicker-active td,
        .inputpicker-wrapped-list .inputpicker-active th { background: #404e68 !important; color: #fff !important; font-weight: bold; }
        .inputpicker-wrapped-list { min-width: max-content !important; }
        .inputpicker-wrapped-list table { width: max-content !important; }
        input[readonly], input:disabled, select:disabled { background-color: #f3f4f7; color: #555; }
        .accordion-container.compact-accordion { height: auto; overflow-y: visible; }
        .accordion-container.main-accordion { height: auto; overflow-y: visible; }
        label a.clr { font-size: 11px; font-weight: normal; margin-left: 6px; color: #404e68; text-decoration: underline; cursor: pointer; }
        #gridTable th, #gridTable td { white-space: nowrap; }
        #gridTable td input { min-width: 70px; width: 95px; }
        #gridTable td input[type="checkbox"] { min-width: 0; width: auto; }
        #gridTable td input.f-date { width: 135px; }
        #gridTable td input.f-int { width: 80px; }
        /* Sale No cell: the box is itself the inputpicker dropdown; the "x" beside it clears the pick. */
        #gridTable td.col-lk { min-width: 150px; }
        #gridTable td.col-lk input.f-sale { width: 95px; min-width: 95px; }
        #gridTable td.col-lk .lk-clear { margin-left: 6px; color: #8a93a3; cursor: pointer; }
        /* The plugin wraps a picked cell's input in a div with inline "overflow:auto; height:100%"; inside a
           table cell that can sprout scrollbars, so keep the wrapper exactly the size of its input. */
        #gridTable .inputpicker-div { overflow: hidden !important; height: auto !important; display: inline-block; vertical-align: middle; }
        #gridTable .inputpicker-overflow-hidden { overflow: hidden; display: inline-block; vertical-align: middle; }
        #gridTable td.num, #gridTable th.num, #gridTable tfoot td { text-align: right; }
        input.num { text-align: right; }
        #gridTable td input[readonly] { cursor: default; }
        #gridTable td.own-y { color: #1a6e2e; font-weight: bold; }
        .popup-box.picker-box { display: none; }
        .popup-box.picker-box.wide { width: 1180px; max-width: 96vw; }
        .popup-box .picker-body { max-height: 46vh; overflow: auto; margin-top: 8px; }
        .popup-box .picker-body .stock-empty { margin: 10px 4px 2px; font-size: 12px; color: #666; }
        .popup-box .picker-body table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .popup-box .picker-body th { text-align: left; background: #f4f6fa; padding: 6px 8px; border-bottom: 2px solid #ddd; color: #333; position: sticky; top: 0; white-space: nowrap; }
        .popup-box .picker-body td { padding: 5px 8px; border-bottom: 1px solid #eee; cursor: pointer; color: #222; white-space: nowrap; }
        .popup-box .picker-body th.num, .popup-box .picker-body td.num { text-align: right; }
        .popup-box .picker-body tr:hover td { background: #eef3ff; }
        .popup-box .picker-body tr.is-on td { background: #e3ecff; }
        .stock-filters { display: flex; gap: 8px 12px; margin-bottom: 8px; flex-wrap: wrap; align-items: flex-end; }
        .stock-filters .sf { display: flex; flex-direction: column; font-size: 12px; color: #444; }
        .stock-filters .sf input { border: 1px solid #dde2ea; border-radius: 4px; padding: 5px 6px; font-size: 12px; width: 120px; }
        .stock-filters .sf input[type="date"] { width: 135px; }
        .stock-filters .sf .sf-name { font-size: 11px; color: #777; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-height: 14px; }
        .stock-filters .inputpicker-div { overflow: hidden !important; height: auto !important; }
        .popup-box.alert-box { width: 440px; max-width: 92vw; display: none; }
        .popup-box.alert-box .alert-message { max-height: 50vh; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.5; margin-bottom: 16px; }
        .popup-box.alert-box .alert-actions { display: flex; justify-content: flex-end; gap: 8px; }
        .action-btns li a.is-disabled, .action-btns li button:disabled { opacity: .4; cursor: not-allowed; pointer-events: none; }
    </style>
</head>
<body>

    <div class="general-container">
        <div class="purchase-details">
            <div class="header-content">
                <div class="action-btns">
                    <ul>
                        <li><a href="@Url.Action("Index", "SampleDrawEntry")"><i class="fa fa-arrow-left"></i> Back</a></li>
                        <li><button type="button" id="btnSave" @(isView ? "disabled" : "")><i class="fa fa-floppy-o"></i> Save</button></li>
                        <li><a href="@Url.Action("Index", "SampleDrawEntry")"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left:auto">
                            <label class="btn btn-inverse pull-right" style="margin:0; border:none;">
                                Status : <span id="statusText">@(isView ? "View" : isEdit ? "Edit" : "Add")</span>
                            </label>
                        </li>
                    </ul>
                </div>
                <div class="header-details">
                    <div class="left">
                        <div class="order-code">
                            <div class="txt"><div class="title-heading">@screenName (HO)</div></div>
                        </div>
                        <div class="title-heading">DOC NO. : <span id="hdrDocNo"></span></div>
                    </div>
                </div>
            </div>

            <div class="accordion-container compact-accordion">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Unit</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Unit</label>
                                @* #UNIT_disp keeps the code that is saved; #UNIT_name shows the unit's name. *@
                                <input type="hidden" id="UNIT_disp" />
                                <input type="text" id="UNIT_name" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-container main-accordion">

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body">
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Doc No</label>
                                <input type="text" id="DOCNO" readonly placeholder="(auto)" />
                            </div>
                            <div class="form-col-20">
                                <label>Date <span>(*)</span></label>
                                <input type="date" id="DOCDT" min="@ViewBag.MinDocDate" />
                            </div>
                            <div class="form-col-20">
                                <label>Sale Type <a class="clr" data-for="SALE_TYPE">clear</a></label>
                                @* inputpicker dropdowns (attached on click; the saved value is the picked code) *@
                                <input type="text" id="SALE_TYPE" class="hdr-pick" data-picker="saleType" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Sale Type Name</label>
                                <input type="text" id="SALE_TYPE_disp" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Sale Centre <span>(*)</span></label>
                                <input type="text" id="SALE_CENTRE" class="hdr-pick" data-picker="saleCentre" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Sale Centre Name</label>
                                <input type="text" id="SALE_CENTRE_disp" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Warehouse <a class="clr" data-for="WAREHOUSE">clear</a></label>
                                <input type="text" id="WAREHOUSE" class="hdr-pick" data-picker="warehouse" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Warehouse Name</label>
                                <input type="text" id="WAREHOUSE_disp" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Destination</label>
                                <input type="text" id="DESTI_disp" readonly />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-20">
                                <label>Broker <a class="clr" data-for="BROK_CODE">clear</a></label>
                                <input type="text" id="BROK_CODE" class="hdr-pick" data-picker="broker" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Broker Name</label>
                                <input type="text" id="BROK_CODE_disp" readonly />
                            </div>
                            <div class="form-col-20">
                                <label>Party <a class="clr" data-for="PCODE">clear</a></label>
                                <input type="text" id="PCODE" class="hdr-pick" data-picker="party" placeholder="Click to select" autocomplete="off" />
                            </div>
                            <div class="form-col-20">
                                <label>Party Name</label>
                                <input type="text" id="PCODE_disp" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Sample Details</span></div>
                    <div class="accordion-body active" style="display:block;">
                        <div class="action-btns">
                            <ul>
                                <li><a href="javascript:void(0)" id="btnSelectStock"><i class="fa fa-plus"></i> Select Data</a></li>
                                <li><a href="javascript:void(0)" id="btnRemoveRows"><i class="fa fa-trash-o"></i> Remove Selected</a></li>
                            </ul>
                        </div>
                        <div class="table-responsive">
                            <table class="border" id="gridTable">
                                <thead>
                                    <tr>
                                        <th style="width:26px;"><input type="checkbox" id="chkAll" /></th>
                                        <th style="width:30px;">Sl.</th>
                                        <th>Inv No.</th>
                                        <th>Mark</th>
                                        <th>AWR No.</th>
                                        <th>AWR Date</th>
                                        <th>Pack Date</th>
                                        <th>Grade</th>
                                        <th>Category</th>
                                        <th>Garden</th>
                                        <th class="num">Bag/Chest</th>
                                        <th class="num">Net Wt.</th>
                                        <th class="num">Total Net Wt.</th>
                                        <th class="num">Gross Wt.</th>
                                        <th class="num">Tare Wt.</th>
                                        <th style="text-align:center;">Unclaim</th>
                                        <th class="num">Draw Qty. <span style="color:red;">(*)</span></th>
                                        <th>Lot No.</th>
                                        <th class="num">Chest From</th>
                                        <th class="num">Chest To</th>
                                        <th>Mfg. From</th>
                                        <th>Mfg. To</th>
                                        <th>Size</th>
                                        <th>Crop Year</th>
                                    </tr>
                                </thead>
                                <tbody id="gridBody"></tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td colspan="10" style="text-align:right;">Total</td>
                                        <td id="ftBags"></td>
                                        <td></td>
                                        <td id="ftNet"></td>
                                        <td id="ftGross"></td>
                                        <td colspan="2"></td>
                                        <td id="ftDraw"></td>
                                        <td colspan="7"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="popup-overlay" id="pickerOverlay"></div>

    @* "Select Data" (VB6 GardenInv_List): the warehouse's AWR stock still available for sampling. *@
    <div class="popup-box picker-box wide" id="stockPicker">
        <div class="popup-header">
            <h2>Select Data (Finished Stock at the Sale Centre)</h2>
            <button type="button" class="close-btn" id="btnStockClose">X</button>
        </div>
        <div class="stock-filters">
            @* HO: no Sale No / AWR date filters (VB6 uses them on "WH" only); hidden, kept for the shared script. *@
            <div class="sf" style="display:none;"><span>Sale No.</span><input type="text" id="sfSaleNo" data-picker="saleNo" placeholder="Click to select" autocomplete="off" /><span class="sf-name" id="sfSaleNoName"></span></div>
            <div class="sf"><span>Category</span><input type="text" id="sfCategory" data-picker="category" placeholder="Click to select" autocomplete="off" /><span class="sf-name" id="sfCategoryName"></span></div>
            <div class="sf"><span>Garden</span><input type="text" id="sfGarden" data-picker="garden" placeholder="Click to select" autocomplete="off" /><span class="sf-name" id="sfGardenName"></span></div>
            <div class="sf"><span>Mark</span><input type="text" id="sfMark" data-picker="mark" placeholder="Click to select" autocomplete="off" /><span class="sf-name" id="sfMarkName"></span></div>
            <div class="sf"><span>AWR No.</span><input type="text" id="sfAwrNo" data-picker="awrNo" placeholder="Click to select" autocomplete="off" /><span class="sf-name"></span></div>
            <div class="sf" style="display:none;"><span>AWR From Date</span><input type="date" id="sfAwrFrom" /><span class="sf-name"></span></div>
            <div class="sf" style="display:none;"><span>AWR To Date</span><input type="date" id="sfAwrTo" /><span class="sf-name"></span></div>
            @* maxlength = T_SAMPLE_DRAW.INVNO VARCHAR2(10) *@
            <div class="sf"><span>Inv No. (tick)</span><input type="text" id="sfInvNo" maxlength="10" placeholder="Type + Enter" autocomplete="off" /><span class="sf-name"></span></div>
        </div>
        <div class="stock-filters">
            <button type="button" id="btnStockRefresh" class="btn-blue" style="width:auto;padding:5px 14px;">Refresh</button>
            <button type="button" id="btnStockClear" class="btn-white" style="width:auto;padding:5px 14px;">Clear Filters</button>
            <button type="button" id="btnStockSelectAll" class="btn-white" style="width:auto;padding:5px 14px;">Select All</button>
            <button type="button" id="btnStockDeselectAll" class="btn-white" style="width:auto;padding:5px 14px;">De-Select All</button>
            <span id="stockInfo" style="font-size:12px;color:#666;"></span>
        </div>
        <div class="picker-body" id="stockBody"></div>
        <div style="text-align:right;padding-top:10px;">
            <button type="button" class="btn-blue" id="btnStockOk" style="width:auto;padding:5px 16px;">OK</button>
            <button type="button" class="btn-white" id="btnStockCancel" style="width:auto;padding:5px 16px;">Cancel</button>
        </div>
    </div>

    <div class="popup-overlay" id="appAlertOverlay"></div>
    <div class="popup-box alert-box" id="appAlertBox">
        <div class="popup-header"><h2 id="appAlertTitle">Notice</h2></div>
        <div class="alert-message" id="appAlertMessage"></div>
        <div class="alert-actions">
            <button type="button" class="btn-white" id="appAlertCancel" style="width:auto;padding:5px 16px;">Cancel</button>
            <button type="button" class="btn-blue" id="appAlertOk" style="width:auto;padding:5px 16px;">OK</button>
        </div>
    </div>

<script>
(function () {
    var IS_EDIT = @(isEdit ? "true" : "false");
    var IS_VIEW = @(isView ? "true" : "false");
    var DOC = @Html.Raw(ViewBag.DocJson ?? "{}");
    var H = DOC.head || {};
    var URL = {
        saleType: '@Url.Action("GetSaleType", "SampleDrawEntry")',
        saleCentre: '@Url.Action("GetSalesCentre", "SampleDrawEntry")',
        warehouse: '@Url.Action("GetWarehouse", "SampleDrawEntry")',
        broker: '@Url.Action("GetBroker", "SampleDrawEntry")',
        party: '@Url.Action("GetParty", "SampleDrawEntry")',
        saleNo: '@Url.Action("GetSaleNo", "SampleDrawEntry")',
        mark: '@Url.Action("GetMark", "SampleDrawEntry")',
        garden: '@Url.Action("GetGarden", "SampleDrawEntry")',
        category: '@Url.Action("GetCategory", "SampleDrawEntry")',
        awrNo: '@Url.Action("GetAwrNo", "SampleDrawEntry")',
        stock: '@Url.Action("GetStock", "SampleDrawEntry")',
        save: '@Url.Action("Save", "SampleDrawEntry")',
        list: '@Url.Action("Index", "SampleDrawEntry")'
    };
    var MAX_LINES = 998;                // VB6 grid size (detailno = 999)
    var MAX_QTY = 9999999.999;          // TNET_WT / TGROSS_WT / DRAW_QTY NUMBER(10,3)
    var MAX_NET = 99999.999;            // NET_WT NUMBER(8,3)
    var MAX_BAGS = 99999.99;            // BAG_CHEST NUMBER(7,2)
    var MAX_CHEST = 999999;             // CHEST_NO NUMBER(6)
    var AUCTION = '4';                  // M_SALETYPE "Auction Sale"

    // ---------------------------------------------------------------- helpers
    $('#pickerOverlay, #stockPicker, #appAlertOverlay, #appAlertBox').appendTo(document.body);
    function num(v) { v = parseFloat(v); return isNaN(v) ? 0 : v; }
    function rnd(v, dp) { v = num(v); var s = v < 0 ? -1 : 1, m = Math.pow(10, dp); return s * Math.round(Math.abs(v) * m + 1e-7) / m; }
    function r2(v) { return rnd(v, 2); }
    function r3(v) { return rnd(v, 3); }
    function f2(v) { return r2(v).toFixed(2); }
    function f3(v) { return r3(v).toFixed(3); }
    // Per-column decimals: Bag/Chest 2, weights and Draw Qty 3, Chest No 0 (the columns' scale).
    var COL_DP = { BAG_CHEST: 2, NET_WT: 3, DRAW_QTY: 3, CHEST_NO: 0 };
    function rcol(col, v) { return rnd(v, COL_DP[col] === undefined ? 3 : COL_DP[col]); }
    function fcol(col, v) { var dp = COL_DP[col] === undefined ? 3 : COL_DP[col]; return rcol(col, v).toFixed(dp); }
    function iso(d) { return d ? String(d).substring(0, 10) : ''; }
    function dmy(d) { d = iso(d); return d ? d.substring(8, 10) + '/' + d.substring(5, 7) + '/' + d.substring(0, 4) : ''; }
    function esc(s) { return $('<div>').text(s == null ? '' : s).html(); }

    function closeAlert() { $('#appAlertOverlay, #appAlertBox').fadeOut(120); }
    function showAlert(message, onOk) { AppMsg.show(message, onOk); }
    function showConfirm(message, onYes, onNo) {
        $('#appAlertTitle').text('Confirm');
        $('#appAlertMessage').text(message || '');
        $('#appAlertCancel').show().off('click').on('click', function () { closeAlert(); if (onNo) onNo(); });
        $('#appAlertOk').off('click').on('click', function () { closeAlert(); onYes(); });
        $('#appAlertOverlay, #appAlertBox').fadeIn(120);
    }
    function failMsg(x, fallback) {
        if (x && x.status === 440) {
            showAlert((x.responseJSON && x.responseJSON.message) || 'Your session has expired. Please log in again.', function () { window.location.reload(); });
            return;
        }
        if (x && x.statusText === 'abort') return;
        showAlert((x && x.responseJSON && x.responseJSON.message) || fallback || 'Could not load data. Please try again.');
    }

    // Numeric-only inputs: digits and one decimal point, limited to the column's decimals, right aligned.
    // Draw Qty (class "neg") also takes a leading minus: a negative quantity is a sample adjustment.
    function sanitizeNum(el) {
        var v = el.value, neg = $(el).hasClass('neg') && /^\s*-/.test(v), clean = v.replace(/[^0-9.]/g, '');
        var dp = COL_DP[$(el).data('col')]; if (dp === undefined) dp = 3;
        var dot = clean.indexOf('.');
        if (dot >= 0) {
            var frac = clean.substring(dot + 1).replace(/\./g, '');
            clean = dp > 0 ? clean.substring(0, dot + 1) + frac.substring(0, dp) : clean.substring(0, dot);
        }
        if (neg) clean = '-' + clean;
        if (clean !== v) el.value = clean;
    }
    $(document).on('keypress', 'input.num:not([readonly])', function (e) {
        var ch = String.fromCharCode(e.which);
        if (e.which < 32) return;
        if (ch === '-' && $(this).hasClass('neg') && this.selectionStart === 0 && this.value.indexOf('-') < 0) return;
        if (!/[0-9.]/.test(ch) || (ch === '.' && this.value.indexOf('.') >= 0 && this.selectionStart === this.selectionEnd)) e.preventDefault();
    });
    $(document).on('input paste', 'input.num:not([readonly])', function () { var el = this; setTimeout(function () { sanitizeNum(el); }, 0); });

    // ---------------------------------------------------------------- state
    var FY_START = iso(H.FY_START), FY_END = iso(H.FY_END);
    var TODAY = iso(H.TODAY) || new Date().toISOString().substring(0, 10);
    // The Unit is locked: a NEW document carries the one picked on the list's "New" row (server-checked
    // against the user's units), an edit the document's own. UNIT is what Save posts -- see payload().
    var UNIT = H.UNIT || '';
    // Doc Date lower bound from the AEDV back-date window (ViewBag.MinDocDate = later of the FY start
    // and today - Aday); Save re-checks it server-side.
    var MIN_DOC = '@ViewBag.MinDocDate';
    var rows = [], seq = 0;

    // ---------------------------------------------------------------- header
    $('#UNIT_disp').val(UNIT);                                        // the code that is saved
    $('#UNIT_name').val(H.UNIT_NAME || UNIT).attr('title', UNIT);     // the Unit's description
    $('#DOCNO').val(H.DOCNO || '');
    $('#hdrDocNo').text(H.DOCNO || '');
    $('#SALE_TYPE').val(H.SALE_TYPE || ''); $('#SALE_TYPE_disp').val(H.SALE_TYPE_NAME || '');
    $('#SALE_CENTRE').val(H.SALE_CENTRE || ''); $('#SALE_CENTRE_disp').val(H.SALE_CENTRE_NAME || '');
    $('#WAREHOUSE').val(H.WAREHOUSE || ''); $('#WAREHOUSE_disp').val(H.WAREHOUSE_NAME || ''); $('#DESTI_disp').val(H.DESTI || '');
    $('#BROK_CODE').val(H.BROK_CODE || ''); $('#BROK_CODE_disp').val(H.BROKER_NAME || '');
    $('#PCODE').val(H.PCODE || ''); $('#PCODE_disp').val(H.PARTY_NAME || '');

    if (IS_EDIT) {
        // VB6 frmrfsh: Doc No and Date are fixed in Edit.
        $('#DOCDT').val(iso(H.DOCDT)).prop('disabled', true);
    } else {
        // VB6 blankrec: today, or the year end once the year is over; never a future date.
        var maxDt = TODAY < FY_END ? TODAY : FY_END;
        var minDt = FY_START;
        if (MIN_DOC && MIN_DOC > minDt) minDt = MIN_DOC;
        $('#DOCDT').attr('min', minDt).attr('max', maxDt).val(maxDt < minDt ? minDt : maxDt);
    }

    function isAuction() { return $.trim($('#SALE_TYPE').val()) === AUCTION; }

    function applyModeUi() {
        $('.hdr-pick').prop('readonly', IS_VIEW).attr('placeholder', IS_VIEW ? '' : 'Click to select');
        $('label a.clr').toggle(!IS_VIEW);
        $('#btnSelectStock, #btnRemoveRows').toggleClass('is-disabled', IS_VIEW);
        if (IS_VIEW) $('.general-container input, .general-container select, .general-container textarea').prop('disabled', true);
    }

    // ---------------------------------------------------------------- lines
    function newRow(src) {
        var r = $.extend({
            SALE_NO: '', SALE_DATE: '', PROMPT_DATE: '', INVNO: '', MARK: '', MARK_NAME: '', AWR_NO: '', AWR_DATE: '', PACK_DATE: '',
            GRADE: '', GRADE_NAME: '', CAT: '', CATEGORY_NAME: '', GARDEN: '', GARDEN_NAME: '', OWN_GARDEN: 'Y',
            BAG_CHEST: 0, NET_WT: 0, TNET_WT: 0, TGROSS_WT: 0, TARE_WT: 0, CHEST_NO: 0, DRAW_QTY: 0, LOTNO: '',
            CHESTSLF: 0, CHESTSLT: 0, MFG_FROM: '', MFG_TO: '', SIZE_CODE: '', CROP_YEAR: '', UNCLAIM: 'N'
        }, src || {});
        ['SALE_NO', 'INVNO', 'MARK', 'MARK_NAME', 'AWR_NO', 'GRADE', 'GRADE_NAME', 'CAT', 'CATEGORY_NAME', 'GARDEN', 'GARDEN_NAME', 'LOTNO', 'SIZE_CODE', 'CROP_YEAR']
            .forEach(function (k) { r[k] = r[k] == null ? '' : $.trim(String(r[k])); });
        ['SALE_DATE', 'PROMPT_DATE', 'AWR_DATE', 'PACK_DATE', 'MFG_FROM', 'MFG_TO'].forEach(function (k) { r[k] = iso(r[k]); });
        r.OWN_GARDEN = r.OWN_GARDEN === 'N' ? 'N' : 'Y';
        r.UNCLAIM = r.UNCLAIM === 'Y' ? 'Y' : 'N';
        r.BAG_CHEST = r2(r.BAG_CHEST); r.NET_WT = r3(r.NET_WT); r.TNET_WT = r3(r.TNET_WT); r.TGROSS_WT = r3(r.TGROSS_WT);
        r.TARE_WT = r3(r.TARE_WT); r.DRAW_QTY = r3(r.DRAW_QTY);
        r.CHEST_NO = Math.floor(num(r.CHEST_NO)); r.CHESTSLF = Math.floor(num(r.CHESTSLF)); r.CHESTSLT = Math.floor(num(r.CHESTSLT));
        r._cid = ++seq;
        return r;
    }
    function lotKey(r) { return [r.INVNO, r.MARK, r.GRADE, iso(r.PACK_DATE), r.AWR_NO || ''].join('|').toUpperCase(); }
    function ro() { return IS_VIEW ? ' readonly tabindex="-1"' : ''; }

    function renderGrid() {
        var $tb = $('#gridBody').empty();
        rows.forEach(function (r, i) {
            r.SRLNO = i + 1;
            var tr = $('<tr data-cid="' + r._cid + '"></tr>');
            tr.append('<td><input type="checkbox" class="rowChk" ' + (IS_VIEW ? 'disabled' : '') + ' /></td>');
            tr.append('<td>' + r.SRLNO + '</td>');
            // HO (VB6 Form_Load "Case HO"): no Sale No / Sale Date / Prompt Date / Chest No columns; Unclaim shown.
            tr.append('<td>' + esc(r.INVNO) + '</td>');
            tr.append('<td title="' + esc(r.MARK) + '">' + esc(r.MARK_NAME || r.MARK) + '</td>');
            tr.append('<td>' + esc(r.AWR_NO) + '</td>');
            tr.append('<td>' + esc(dmy(r.AWR_DATE)) + '</td>');
            tr.append('<td>' + esc(dmy(r.PACK_DATE)) + '</td>');
            tr.append('<td title="' + esc(r.GRADE) + '">' + esc(r.GRADE_NAME || r.GRADE) + '</td>');
            tr.append('<td title="' + esc(r.CAT) + '">' + esc(r.CATEGORY_NAME || r.CAT) + '</td>');
            tr.append('<td class="' + (r.OWN_GARDEN === 'Y' ? 'own-y' : '') + '" title="' + esc(r.GARDEN_NAME) + (r.OWN_GARDEN === 'Y' ? ' (own garden)' : '') + '">' + esc(r.GARDEN) + '</td>');
            ['BAG_CHEST', 'NET_WT'].forEach(function (c) {
                tr.append('<td class="num"><input type="text" inputmode="decimal" class="num f-' + c + '" data-col="' + c + '" value="' + fcol(c, r[c]) + '"' + ro() + ' /></td>');
            });
            tr.append('<td class="num c-tnet">' + f3(r.TNET_WT) + '</td>');
            tr.append('<td class="num c-gross">' + f3(r.TGROSS_WT) + '</td>');
            tr.append('<td class="num">' + f3(r.TARE_WT) + '</td>');
            tr.append('<td style="text-align:center;"><input type="checkbox" class="f-unclaim"' + (r.UNCLAIM === 'Y' ? ' checked' : '') + (IS_VIEW ? ' disabled' : '') + ' /></td>');
            tr.append('<td class="num"><input type="text" inputmode="decimal" class="num neg f-DRAW_QTY" data-col="DRAW_QTY" value="' + f3(r.DRAW_QTY) + '"' + ro() + ' /></td>');
            tr.append('<td>' + esc(r.LOTNO) + '</td>');
            tr.append('<td class="num">' + r.CHESTSLF + '</td>');
            tr.append('<td class="num">' + r.CHESTSLT + '</td>');
            tr.append('<td>' + esc(dmy(r.MFG_FROM)) + '</td>');
            tr.append('<td>' + esc(dmy(r.MFG_TO)) + '</td>');
            tr.append('<td>' + esc(r.SIZE_CODE) + '</td>');
            tr.append('<td>' + esc(r.CROP_YEAR) + '</td>');
            $tb.append(tr);
        });
        if (!rows.length) $tb.append('<tr><td colspan="24" style="text-align:center;color:#666;">Use "Select Data" to pick the lots from the finished stock.</td></tr>');
        refreshTotals();
    }

    // VB6 grid footer: Bag/Chest, Total Net Wt, Gross Wt and Draw Qty.
    function refreshTotals() {
        var bags = 0, net = 0, gross = 0, draw = 0;
        rows.forEach(function (r) { bags += num(r.BAG_CHEST); net += num(r.TNET_WT); gross += num(r.TGROSS_WT); draw += num(r.DRAW_QTY); });
        $('#ftBags').text(f2(bags)); $('#ftNet').text(f3(net)); $('#ftGross').text(f3(gross)); $('#ftDraw').text(f3(draw));
    }

    function findRow(cid) { return rows.find(function (r) { return r._cid == cid; }); }

    // VB6 DATAGRID1_BeforeColUpdate. A refused value puts the old one back.
    $('#gridBody').on('change', 'input.num', function () {
        var $tr = $(this).closest('tr'), r = findRow($tr.data('cid')); if (!r) return;
        var col = $(this).data('col'), v = rcol(col, this.value), old = r[col], el = this;
        function refuse(msg) { el.value = col === 'CHEST_NO' ? (old ? old : '') : fcol(col, old); showAlert(msg); }

        if (col === 'BAG_CHEST' || col === 'NET_WT') {
            if (v < 0) { refuse('Bag/Chest and Net Wt. cannot be negative.'); return; }
            if (col === 'BAG_CHEST' && v > MAX_BAGS) { refuse('Bag/Chest is too large.'); return; }
            if (col === 'NET_WT' && v > MAX_NET) { refuse('Net Wt. is too large.'); return; }
            // pNetWt: "Net Wt. cannot be less than" the number of bags.
            if (col === 'NET_WT' && v < num(r.BAG_CHEST)) { refuse('Net Wt. cannot be less than ' + num(r.BAG_CHEST)); return; }
            r[col] = v;
            // pBagChest / pNetWt: Total Net Wt and Gross Wt both become Bag/Chest x Net Wt.
            r.TNET_WT = r3(num(r.BAG_CHEST) * num(r.NET_WT));
            r.TGROSS_WT = r.TNET_WT;
            $tr.find('.c-tnet').text(f3(r.TNET_WT)); $tr.find('.c-gross').text(f3(r.TGROSS_WT));
        } else if (col === 'DRAW_QTY') {
            if (v !== old) {
                // pDrawQty, HO (VB6's own-garden / sample-adjustment rules are WH-only): not above Total Net Wt.
                if (v !== 0 && v > num(r.TNET_WT)) { refuse('Draw Qty cannot be greater than ' + num(r.TNET_WT)); return; }
                if (Math.abs(v) > MAX_QTY) { refuse('Draw Qty is too large.'); return; }
            }
            r.DRAW_QTY = v;
        } else if (col === 'CHEST_NO') {
            v = Math.floor(Math.abs(v));
            // pChestNo: inside the lot's chest range (when the lot has one).
            if (r.CHESTSLF !== 0 && r.CHESTSLT !== 0 && (v < r.CHESTSLF || v > r.CHESTSLT)) {
                refuse('Chest No should be between  ' + r.CHESTSLF + '  and  ' + r.CHESTSLT); return;
            }
            r.CHEST_NO = v;
            this.value = v ? v : '';
            return;
        }
        this.value = fcol(col, r[col]);
        refreshTotals();
    });
    $('#gridBody').on('focus', 'input.num:not([readonly])', function () { var el = this; setTimeout(function () { el.select(); }, 0); });
    // pUnclaim (shown for HO): stored as 'Y' / 'N'.
    $('#gridBody').on('change', 'input.f-unclaim', function () {
        var r = findRow($(this).closest('tr').data('cid')); if (r) r.UNCLAIM = this.checked ? 'Y' : 'N';
    });
    // pSaleDate / pPromptDate: must be dates (the date box guarantees it).
    $('#gridBody').on('change', 'input.f-date', function () {
        var r = findRow($(this).closest('tr').data('cid')); if (r) r[$(this).data('col')] = this.value;
    });
    // Enter moves to the next editable cell, as in the VB6 grid.
    $('#gridBody').on('keydown', 'input:not(.pk)', function (e) {   // .pk = inputpicker boxes: Enter picks a row there
        if (e.which !== 13) return;
        e.preventDefault();
        $(this).trigger('change');
        var $all = $('#gridBody input:not([readonly]):not([type="checkbox"]):not(.inputpicker-original)');
        var i = $all.index(this);
        if (i >= 0 && i < $all.length - 1) $all.eq(i + 1).focus();
    });

    // Sale No: the row's own box is the dropdown -- clicking / focusing it opens the inputpicker anchored
    // right under it. The plugin clones the input it is attached to (classes included), so the clone
    // (.inputpicker-input) must not match here or a second picker would be attached inside the first.
    $('#gridBody').on('click focus', 'input.pk:not([readonly]):not(.inputpicker-input)', function () {
        var $inp = $(this), $tr = $inp.closest('tr'), r = findRow($tr.data('cid')); if (!r) return;
        openLookup('saleNo', $inp, function (row) {
            r.SALE_NO = row.CODE; r.SALE_DATE = iso(row.SALE_DATE); r.PROMPT_DATE = iso(row.PROMPT_DATE);
            $tr.find('input[data-col="SALE_DATE"]').val(r.SALE_DATE);
            $tr.find('input[data-col="PROMPT_DATE"]').val(r.PROMPT_DATE);
        });
    });
    $('#gridBody').on('click', '.lk-clear', function () {
        var r = findRow($(this).closest('tr').data('cid')); if (!r || IS_VIEW) return;
        r.SALE_NO = '';
        $('.inputpicker-wrapped-list').remove();
        renderGrid();
    });

    $('#chkAll').on('change', function () { $('.rowChk').prop('checked', $(this).is(':checked')); });
    $('#btnRemoveRows').on('click', function () {
        if (IS_VIEW) return;
        var cids = $('.rowChk:checked').map(function () { return $(this).closest('tr').data('cid'); }).get();
        if (!cids.length) { showAlert('Select at least one row to remove.'); return; }
        rows = rows.filter(function (r) { return cids.indexOf(r._cid) === -1; });
        $('#chkAll').prop('checked', false);
        $('.inputpicker-wrapped-list').remove();
        renderGrid();
    });

    // ---------------------------------------------------------------- lookups
    // jquery.inputpicker dropdowns (Root UI convention, CLAUDE.md "Lookup pickers"): anchored under the
    // field, paged, and searched server-side on EVERY column shown (the MVC picker actions take
    // (q, limit, ..., p) and reply { data, count }). The first field is the value written to the box.
    // `params` are the picker's own filters, sent with every request (urlParam).
    var CODE_NAME = [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }];
    var LOOKUPS = {
        saleType: { url: URL.saleType, fields: CODE_NAME },
        saleCentre: { url: URL.saleCentre, fields: CODE_NAME },
        warehouse: { url: URL.warehouse, fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Name' }, { name: 'DESTI', text: 'Destination' }] },
        broker: { url: URL.broker, fields: CODE_NAME },
        party: { url: URL.party, fields: CODE_NAME },
        saleNo: { url: URL.saleNo, fields: [{ name: 'CODE', text: 'Sale No' }, { name: 'SALE_DATE_TEXT', text: 'Sale Date' }, { name: 'PROMPT_DATE_TEXT', text: 'Prompt Date' }, { name: 'SALE_CENTRE_NAME', text: 'Sale Centre' }] },
        category: { url: URL.category, fields: CODE_NAME },
        garden: { url: URL.garden, fields: CODE_NAME },
        mark: { url: URL.mark, fields: [{ name: 'CODE', text: 'Code' }, { name: 'NAME', text: 'Mark' }, { name: 'GARDEN', text: 'Garden' }],
                params: function () { return { garden: $('#sfGarden').val() || '' }; } },
        awrNo: { url: URL.awrNo, fields: [{ name: 'CODE', text: 'AWR No' }, { name: 'AWR_DATE_TEXT', text: 'AWR Date' }],
                 params: function () { return { warehouse: $('#WAREHOUSE').val() || '', mark: $('#sfMark').val() || '', garden: $('#sfGarden').val() || '' }; } }
    };

    // The row the user picked, looked up in the data the dropdown last loaded. This copy of the plugin
    // writes the picked value into the original input and fires "change" on it; it does not hand the
    // row to a select handler, so read it back by the picked value.
    function pickedRow($input, cfg) {
        var key = cfg.fields[0].name, v = String($input.val() == null ? '' : $input.val()), data = [];
        try { data = $input.inputpicker('data') || []; } catch (e) { data = []; }
        for (var i = 0; i < data.length; i++) { if (String(data[i][key]) === v) return data[i]; }
        return null;
    }

    // Open the dropdown AND refresh its rows. The plugin loads url-backed data asynchronously and only
    // re-renders the list on a keystroke, so showing it right after init (before the first response
    // lands) displayed "No results" -- the keyup makes it fetch and render the rows.
    function showPickerList($orig) {
        $orig.inputpicker('show');
        $orig.next('.inputpicker-overflow-hidden').find('input').trigger($.Event('keyup', { keyCode: 0 }));
    }

    // Empty a picker box (the plugin shows a clone of the input, so both are blanked).
    function clearPick($input) {
        $input.val('');
        $input.next('.inputpicker-overflow-hidden').find('input').val('');
    }

    function openLookup(key, $input, onSelect) {
        var cfg = LOOKUPS[key];
        $('.inputpicker-wrapped-list').remove();

        // This plugin never sets $.data('inputpicker'); the class it puts on the original input is the
        // "already initialised" test (otherwise every click re-wraps the field and drops what the user
        // has typed). Showing is deferred a tick: called from a click, the click's own bubbling up to the
        // plugin's document-level "outside click" handler would otherwise hide it straight away.
        if ($input.hasClass('inputpicker-original')) {
            if (cfg.params) { try { $input.inputpicker('set', 'urlParam', cfg.params()); } catch (e) { /* keeps the old filter */ } }
            setTimeout(function () { showPickerList($input); }, 0);
            return;
        }

        $input.inputpicker({
            url: cfg.url,
            urlParam: cfg.params ? cfg.params() : {},
            fields: cfg.fields,
            fieldText: cfg.fields[0].name,
            fieldValue: cfg.fields[0].name,
            headShow: true,
            filterOpen: true,
            autoOpen: true,
            pagination: true,
            pageField: 'p',
            pageLimitField: 'limit',
            pageLimit: 10,
            pageCountField: 'count',
            width: 'auto',
            urlDelay: 0.2      // seconds (the plugin multiplies by 1000): one request per pause in typing, not per keystroke
        });
        setTimeout(function () { showPickerList($input); }, 0);

        function deliver(row) { if (row && onSelect) onSelect(row); }
        // Both hooks call the same idempotent handler, so whichever this plugin build fires works.
        $input.off('inputpicker.select').on('inputpicker.select', function (e, row) {
            deliver(row);
            $(this).inputpicker('hide');
        });
        $input.off('change.ipk').on('change.ipk', function () { deliver(pickedRow($input, cfg)); });
    }

    // Header pickers (VB6 txtSaleType / txtSale_Centre / txtWarehouse / TxtBroker / TxtPCode help).
    var HDR_PICK = {
        saleType: function (x) { $('#SALE_TYPE_disp').val(x.NAME || ''); },
        saleCentre: function (x) { $('#SALE_CENTRE_disp').val(x.NAME || ''); },
        warehouse: function (x) { $('#WAREHOUSE_disp').val(x.NAME || ''); $('#DESTI_disp').val(x.DESTI || ''); },
        broker: function (x) { $('#BROK_CODE_disp').val(x.NAME || ''); },
        party: function (x) { $('#PCODE_disp').val(x.NAME || ''); }
    };
    $('.hdr-pick').on('click focus', function () {
        if (IS_VIEW) return;
        var key = $(this).data('picker');
        openLookup(key, $(this), HDR_PICK[key]);
    });
    // Sale Type, Warehouse, Broker and Party are optional for HO: "clear" empties them.
    $('label a.clr').on('click', function () {
        if (IS_VIEW) return;
        var id = $(this).data('for');
        clearPick($('#' + id));
        $('#' + id + '_disp').val('');
        if (id === 'WAREHOUSE') $('#DESTI_disp').val('');
    });

    // ---------------------------------------------------------------- Select Data (stock)
    // VB6 GardenInv_List: the warehouse's AWR receipts less the delivery orders issued, filtered by
    // Category / Mark / Garden / AWR No / AWR dates (and, for an Auction sale, the catalogue's Sale No).
    var stock = [], stockXhr = null;
    var SF_NAME = { saleNo: '#sfSaleNoName', category: '#sfCategoryName', garden: '#sfGardenName', mark: '#sfMarkName' };
    var sfSale = { SALE_DATE: '', PROMPT_DATE: '' };     // dates of the Sale No picked in the filter

    $('#stockPicker .stock-filters input[data-picker]').on('click focus', function () {
        var key = $(this).data('picker'), $inp = $(this);
        openLookup(key, $inp, function (x) {
            if (key === 'saleNo') {
                sfSale = { SALE_DATE: iso(x.SALE_DATE), PROMPT_DATE: iso(x.PROMPT_DATE) };
                $(SF_NAME.saleNo).text(x.SALE_DATE_TEXT || '').attr('title', 'Prompt ' + (x.PROMPT_DATE_TEXT || ''));
            } else if (SF_NAME[key]) {
                $(SF_NAME[key]).text(x.NAME || '').attr('title', x.NAME || '');
            }
        });
    });

    function clearStockFilters() {
        ['#sfSaleNo', '#sfCategory', '#sfGarden', '#sfMark', '#sfAwrNo'].forEach(function (s) { clearPick($(s)); });
        $('#stockPicker .sf-name').text('');
        sfSale = { SALE_DATE: '', PROMPT_DATE: '' };
        $('#sfInvNo').val('');
    }
    $('#btnStockClear').on('click', function () { clearStockFilters(); });

    function openStockPicker() {
        if (IS_VIEW) return;
        // VB6 CmdRefresh_Click: "Please Enter Sales Centre"; the warehouse is where the stock lies.
        if (!$('#SALE_CENTRE').val()) { showAlert('Please Enter Sales Centre'); return; }
        $('#pickerOverlay, #stockPicker').fadeIn(120);
        loadStock();
    }
    function closeStockPicker() {
        $('.inputpicker-wrapped-list').hide();
        $('#pickerOverlay, #stockPicker').fadeOut(120);
    }
    $('#btnSelectStock').on('click', openStockPicker);
    $('#btnStockClose, #btnStockCancel').on('click', closeStockPicker);
    $('#btnStockRefresh').on('click', function () { loadStock(); });

    function loadStock() {
        if (stockXhr) stockXhr.abort();
        $('#stockInfo').text('');
        $('#stockBody').html('<p class="stock-empty">Loading...</p>');
        stockXhr = $.get(URL.stock, {
            // HO stock: Sale Centre's finished stock; the document being edited is sent so its own
            // draws are not taken off the stock again.
            warehouse: $('#WAREHOUSE').val(), saleCentre: $('#SALE_CENTRE').val(), saleType: $('#SALE_TYPE').val(),
            mark: $('#sfMark').val(), garden: $('#sfGarden').val(), category: $('#sfCategory').val(), awrNo: $('#sfAwrNo').val(),
            docDate: $('#DOCDT').val(),
            unit: $('#UNIT_disp').val(), docno: IS_EDIT ? ($('#DOCNO').val() || '') : '', docdt: IS_EDIT ? ($('#DOCDT').val() || '') : ''
        }).done(function (r) {
            stock = ((r && r.rows) || []).map(function (s, i) { s._i = i; s._on = false; return s; });
            renderStock();
            $('#stockInfo').text(stock.length + ' lot(s)' + (r && r.truncated ? ' -- only the first ' + r.limit + ' are shown; narrow the filters.' : ''));
        }).fail(function (x) {
            if (x && x.statusText === 'abort') return;
            stock = [];
            $('#stockBody').html('<p class="stock-empty">' + esc((x.responseJSON && x.responseJSON.message) || 'Unable to load the stock.') + '</p>');
        });
    }

    function renderStock() {
        if (!stock.length) { $('#stockBody').html('<p class="stock-empty">No stock found for these filters.</p>'); return; }
        var have = {};
        rows.forEach(function (r) { have[lotKey(r)] = true; });
        var h = ['<table><thead><tr><th style="width:24px;"></th><th>Inv No.</th><th>Mark</th><th>Grade</th><th>Category</th><th>Pack Date</th>',
                 '<th>AWR No.</th><th>AWR Date</th><th class="num">Bag/Chest</th><th class="num">Net Wt.</th><th class="num">Total Net Wt.</th>',
                 '<th class="num">Gross Wt.</th><th>Lot No.</th><th class="num">Draw Qty.</th><th>Garden</th></tr></thead><tbody>'];
        stock.forEach(function (s) {
            var taken = !!have[lotKey(s)];
            h.push('<tr data-i="' + s._i + '"' + (s._on ? ' class="is-on"' : '') + (taken ? ' title="Already on this document" style="opacity:.55;"' : '') + '>' +
                '<td><input type="checkbox" class="stkChk"' + (s._on ? ' checked' : '') + (taken ? ' disabled' : '') + ' /></td>' +
                '<td>' + esc(s.INVNO) + '</td>' +
                '<td title="' + esc(s.MARK) + '">' + esc(s.MARK_NAME || s.MARK) + '</td>' +
                '<td title="' + esc(s.GRADE) + '">' + esc(s.GRADE_NAME || s.GRADE) + '</td>' +
                '<td>' + esc(s.CATEGORY_NAME || s.CAT) + '</td>' +
                '<td>' + esc(dmy(s.PACK_DATE)) + '</td>' +
                '<td>' + esc(s.AWR_NO) + '</td>' +
                '<td>' + esc(dmy(s.AWR_DATE)) + '</td>' +
                '<td class="num">' + f2(s.BAG_CHEST) + '</td>' +
                '<td class="num">' + f3(s.NET_WT) + '</td>' +
                '<td class="num">' + f3(s.TNET_WT) + '</td>' +
                '<td class="num">' + f3(s.TGROSS_WT) + '</td>' +
                '<td>' + esc(s.LOTNO) + '</td>' +
                '<td class="num">' + f3(s.DRAW_QTY) + '</td>' +
                '<td title="' + esc(s.GARDEN_NAME) + '">' + esc(s.GARDEN) + (s.OWN_GARDEN === 'Y' ? ' (own)' : '') + '</td></tr>');
        });
        h.push('</tbody></table>');
        $('#stockBody').html(h.join(''));
    }
    function setStock(i, on) {
        var s = stock[i]; if (!s) return;
        var $tr = $('#stockBody tr[data-i="' + i + '"]');
        if ($tr.find('.stkChk').prop('disabled')) return;
        s._on = on;
        $tr.toggleClass('is-on', on).find('.stkChk').prop('checked', on);
    }
    $('#stockBody').on('click', 'tbody tr', function (e) {
        var i = $(this).data('i'), s = stock[i]; if (!s) return;
        setStock(i, $(e.target).hasClass('stkChk') ? $(e.target).is(':checked') : !s._on);
    });
    // VB6 CmdSelAll / CmdDeSelAll.
    $('#btnStockSelectAll').on('click', function () { stock.forEach(function (s) { setStock(s._i, true); }); });
    $('#btnStockDeselectAll').on('click', function () { stock.forEach(function (s) { setStock(s._i, false); }); });
    // VB6 txtInvNo_Validate: typing an Inv No ticks that lot ("Garden Inv No Not Found" otherwise).
    $('#sfInvNo').on('keydown', function (e) {
        if (e.which !== 13) return;
        e.preventDefault();
        var v = $.trim(this.value).toUpperCase(); if (!v) return;
        var hit = stock.filter(function (s) { return String(s.INVNO || '').toUpperCase() === v; });
        if (!hit.length) { showAlert('Garden Inv No Not Found'); this.value = ''; return; }
        hit.forEach(function (s) { setStock(s._i, true); });
        var $tr = $('#stockBody tr[data-i="' + hit[0]._i + '"]');
        if ($tr.length && $tr[0].scrollIntoView) $tr[0].scrollIntoView({ block: 'nearest' });
        this.value = '';
    });

    // VB6 CmdOK_Click: every ticked lot becomes a line, with the Draw Qty the sampling table proposes
    // and the Sale No / Sale Date / Prompt Date in force.
    $('#btnStockOk').on('click', function () {
        var picked = stock.filter(function (s) { return s._on; });
        if (!picked.length) { showAlert('Tick at least one lot.'); return; }
        if (rows.length + picked.length > MAX_LINES) { showAlert('A document can hold at most ' + MAX_LINES + ' lines.'); return; }
        var have = {};
        rows.forEach(function (r) { have[lotKey(r)] = true; });
        picked.forEach(function (s) {
            if (have[lotKey(s)]) return;
            have[lotKey(s)] = true;
            var r = newRow(s);
            r.CHEST_NO = 0;
            rows.push(r);
        });
        closeStockPicker();
        renderGrid();
    });

    // ---------------------------------------------------------------- save
    function payload() {
        return {
            // UNIT: the locked Unit (see state above). IsNew lets the server apply the AEDV Add / Edit
            // right and back-date window (SampleDrawEntryController.Save). The transaction type
            // ("WH") is fixed server-side.
            UNIT: $('#UNIT_disp').val(), IsNew: !IS_EDIT,
            DOCNO: $('#DOCNO').val() || null, DOCDT: $('#DOCDT').val() || null,
            SALE_TYPE: $.trim($('#SALE_TYPE').val()), SALE_CENTRE: $.trim($('#SALE_CENTRE').val()), WAREHOUSE: $.trim($('#WAREHOUSE').val()),
            BROK_CODE: $.trim($('#BROK_CODE').val()), PCODE: $.trim($('#PCODE').val()),
            LINES: rows.map(function (r) {
                return {
                    SALE_NO: r.SALE_NO || null, SALE_DATE: r.SALE_DATE || null, PROMPT_DATE: r.PROMPT_DATE || null,
                    INVNO: r.INVNO, MARK: r.MARK, GRADE: r.GRADE, PACK_DATE: r.PACK_DATE || null,
                    AWR_NO: r.AWR_NO || null, AWR_DATE: r.AWR_DATE || null, CAT: r.CAT || null, GARDEN: r.GARDEN || null,
                    BAG_CHEST: r2(r.BAG_CHEST), NET_WT: r3(r.NET_WT), TNET_WT: r3(r.TNET_WT), TGROSS_WT: r3(r.TGROSS_WT), TARE_WT: r3(r.TARE_WT),
                    DRAW_QTY: r3(r.DRAW_QTY), LOTNO: r.LOTNO || null, CHEST_NO: r.CHEST_NO, CHESTSLF: r.CHESTSLF, CHESTSLT: r.CHESTSLT,
                    MFG_FROM: r.MFG_FROM || null, MFG_TO: r.MFG_TO || null, SIZE_CODE: r.SIZE_CODE || null, CROP_YEAR: r.CROP_YEAR || null,
                    UNCLAIM: r.UNCLAIM
                };
            })
        };
    }

    // VB6 txtDocdt_Validate + cmdSAVE_Click.
    function validate() {
        var d = $('#DOCDT').val();
        if (!d) return 'Doc Date cannot be blank';
        if (!IS_EDIT) {
            if (d > TODAY) return 'Can not enter future date ' + dmy(d);
            if (d < FY_START || d > FY_END) return 'Date not between financial Year';
            if (d < ($('#DOCDT').attr('min') || '') || d > ($('#DOCDT').attr('max') || '9999')) {
                return 'Date must be between ' + dmy($('#DOCDT').attr('min')) + ' and ' + dmy($('#DOCDT').attr('max')) + '.';
            }
        }
        if (!$.trim($('#SALE_CENTRE').val())) return 'Sales Centre cannot be blank';
        // HO: Warehouse and Broker / Party are optional (VB6 asks for them on "WH" only).
        if (!rows.length) return 'Without Invoice Detail, Record Can Not be Saved.';
        if (rows.length > MAX_LINES) return 'A document can hold at most ' + MAX_LINES + ' lines.';
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i], at = 'Line ' + r.SRLNO + ' (Inv No ' + r.INVNO + '): ';
            if (!r.MARK) return at + 'Without Mark, Record Can Not be Saved.';
            if (!r.AWR_DATE) return at + 'Without AWR Date, Record Can Not be Saved.';
            if (!r.PACK_DATE) return at + 'Without Pack Date, Record Can Not be Saved.';
            if (!r.GRADE) return at + 'Without Grade Record Can Not be Saved.';
            if (!(r.NET_WT > 0)) return at + 'Enter Net Wt Detail !';
            if (!r.DRAW_QTY) return at + 'Enter Draw Qty. !';
            if (r.DRAW_QTY > r.TNET_WT) return at + 'Draw Qty cannot be greater than ' + r.TNET_WT;
        }
        return null;
    }

    var saving = false;
    $('#btnSave').on('click', function () {
        if (IS_VIEW || saving) return;
        $('#gridBody input:focus').trigger('change');
        var err = validate();
        if (err) { showAlert(err); return; }
        showConfirm('Are you sure?', function () {
            saving = true;
            $('#btnSave').prop('disabled', true);
            $.ajax({ url: URL.save, type: 'POST', contentType: 'application/json', data: JSON.stringify(payload()) })
                .done(function (resp) {
                    if (resp && resp.success) {
                        var no = resp.data && resp.data.docno ? resp.data.docno : '';
                        showAlert('Saved successfully.' + (no ? '\n' + '@screenName' + ' No. ' + no : ''), function () { window.location.href = URL.list; });
                    } else {
                        showAlert((resp && resp.message) || 'Save failed.');
                    }
                })
                .fail(function (x) { failMsg(x, 'Save failed.'); })
                .always(function () { saving = false; $('#btnSave').prop('disabled', false); });
        });
    });

    // ---------------------------------------------------------------- init
    // VB6 add_record: AWR From = start of the year, AWR To = today.
    $('#sfAwrFrom').val(FY_START);
    $('#sfAwrTo').val(TODAY);
    rows = (DOC.lines || []).map(function (l) { return newRow(l); });
    renderGrid();
    applyModeUi();
    // Leaving the page (e.g. a side-menu click) closes any dropdown still open.
    $(window).on('beforeunload pagehide', function () { $('.inputpicker-wrapped-list').hide(); });
})();
</script>
@Html.Partial("_RecordLock")
</body>
</html>
