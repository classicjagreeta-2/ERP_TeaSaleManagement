@model System.Web.Mvc.HandleErrorInfo
@{
    // Rendered by GlobalExceptionFilter. No layout on purpose: _Layout reads
    // session/menu data, and if that is what failed the error page would fail too.
    Layout = null;

    int statusCode = ViewData["StatusCode"] as int? ?? 500;
    string errorMessage = ViewData["ErrorMessage"] as string ?? "An unexpected error occurred while processing your request.";
    string errorId = ViewData["ErrorId"] as string;
    string heading = statusCode == 404 ? "Page not found" : "Something went wrong";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error @statusCode</title>
    <style>
        *, *::after, *::before {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(#003eff, #0028a9);
            color: #fff;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .error-card {
            max-width: 640px;
            width: calc(100% - 32px);
            text-align: center;
            padding: 32px 16px;
        }

        .error-code {
            font-size: 5rem;
            font-weight: 300;
            margin: 0;
            text-shadow: 0 0 10px #fff;
            animation: blink 4.8s infinite both;
        }

        .error-heading {
            font-size: 1.5rem;
            margin: 8px 0 16px;
        }

        .error-message {
            font-family: Consolas, monospace;
            font-size: .95rem;
            background: rgba(0, 0, 0, .25);
            border-radius: 6px;
            padding: 12px 16px;
            word-break: break-word;
        }

        .error-ref {
            font-size: .85rem;
            opacity: .85;
            margin-top: 12px;
        }

        .error-actions a {
            display: inline-block;
            margin: 20px 8px 0;
            padding: 8px 20px;
            color: #0028a9;
            background: #fff;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 600;
        }

        @@keyframes blink {
            0%, 50%, 100% {
                opacity: .4;
            }

            25%, 75% {
                opacity: 1;
            }
        }
    </style>
</head>
<body>
    <div class="error-card">
        <h1 class="error-code">@statusCode</h1>
        <div class="error-heading">@heading</div>
        <div class="error-message">@errorMessage</div>
        @if (!string.IsNullOrEmpty(errorId))
        {
            <div class="error-ref">Please quote reference <strong>@errorId</strong> when reporting this problem.</div>
        }
        <div class="error-actions">
            <a href="javascript:history.back()">Go Back</a>
            <a href="@Url.Content("~/")">Home</a>
        </div>
    </div>
</body>
</html>
