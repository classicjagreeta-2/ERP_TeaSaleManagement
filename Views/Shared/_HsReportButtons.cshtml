@* Output buttons of the HS register forms; each opens the report in a new tab (Excel ones download). *@
<button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Graphics" title="PDF in a new tab">Graphics</button>
<button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Html" title="HTML page in a new tab">HTML</button>
<button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Excel" title="Download as Excel (.xlsx)">Excel</button>
<button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="ExcelChecklist" title="Download the plain data rows as Excel (.xlsx)">Excel Checklist</button>
