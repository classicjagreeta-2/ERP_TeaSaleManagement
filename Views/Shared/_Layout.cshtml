            //debugger;
            // Bootstrap throws "Please use show on visible elements" when a tooltip is asked for on a
            // hidden element (the boxes of the closed side panel): no tooltip there, and no error.
            (function () {
                var T = $.fn.tooltip && $.fn.tooltip.Constructor;
                if (!T || T.prototype.__hiddenSafe) return;
                var show = T.prototype.show;
                T.prototype.show = function () {
                    if ($(this.element).css('display') === 'none') return;
                    return show.apply(this, arguments);
                };
                T.prototype.__hiddenSafe = true;
            })();
            $(function () {
                $('[data-toggle="tooltip"]').tooltip()
