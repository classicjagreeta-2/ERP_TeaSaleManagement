        .pcoded .pcoded-header, .pcoded .pcoded-header[header-theme] {
            background: #fff !important; color: var(--cc-text) !important; font-family: var(--cc-font);
            border-bottom: 1px solid var(--cc-border); box-shadow: none !important;
