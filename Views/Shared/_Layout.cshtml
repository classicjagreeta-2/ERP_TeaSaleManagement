        .pcoded .pcoded-header .cc-icon-btn {
            width: 34px; height: 34px; padding: 0 !important; border-radius: 6px !important; border: 1px solid var(--cc-border);
            background: #fff; color: var(--cc-muted) !important; display: inline-flex; align-items: center; justify-content: center;
            font-size: 15px; line-height: 32px; text-align: center; vertical-align: middle; transition: all var(--cc-ease);
        }
        .pcoded .pcoded-header .cc-icon-btn:hover { color: var(--cc-navy) !important; border-color: #CBD4E6; background: var(--cc-bg); }
        .pcoded .pcoded-header .cc-icon-btn:focus-visible { outline: none; box-shadow: var(--cc-ring); }
        .pcoded .pcoded-header .navbar-logo a.mobile-menu.cc-icon-btn { top: 11px; right: 14px; }
        .pcoded .pcoded-header .navbar-container .nav-left > li, .pcoded .pcoded-header .navbar-container .nav-right > li { display: flex; align-items: center; height: 56px; line-height: normal; }
        .pcoded .pcoded-header .cc-product { font-size: .78rem; font-weight: 600; color: var(--cc-muted); white-space: nowrap; padding-right: 4px; }
        .pcoded .pcoded-header .cc-pill {
            display: inline-flex; align-items: center; gap: .45rem; max-width: 360px; height: 30px; padding: 0 .7rem; border-radius: 6px;
            background: #fff; border: 1px solid var(--cc-border); color: var(--cc-text) !important; font-size: 12px !important; font-weight: 500;
            line-height: 1; white-space: nowrap; text-decoration: none; cursor: pointer; transition: border-color var(--cc-ease), background var(--cc-ease);
        }
        .pcoded .pcoded-header .cc-pill:hover { background: var(--cc-bg); border-color: #CBD4E6; }
        .pcoded .pcoded-header .cc-pill i { color: var(--cc-muted); font-size: 12px; flex: none; }
        .pcoded .pcoded-header .cc-pill-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
        .pcoded .pcoded-header .cc-user { display: flex; align-items: center; gap: .65rem; cursor: pointer; }
        .pcoded .pcoded-header .cc-user-text { display: flex; flex-direction: column; text-align: right; line-height: 1.15; }
        .pcoded .pcoded-header .cc-user-name { font-weight: 600; font-size: .88rem; color: var(--cc-navy); }
        .pcoded .pcoded-header .cc-user-role { font-size: .72rem; color: var(--cc-muted); }
        .pcoded .pcoded-header .cc-avatar {
            width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex: none;
            background: var(--cc-navy); color: #fff; font-weight: 700; font-size: .78rem; box-shadow: 0 0 0 3px #fff, 0 0 0 4px var(--cc-border);
        }
        .pcoded .pcoded-header .cc-user > .feather { color: var(--cc-muted); font-size: 14px; }
        .pcoded .pcoded-header .profile-notification { border: 1px solid var(--cc-border); border-radius: 12px; box-shadow: var(--cc-shadow-lg); overflow: hidden; font-family: var(--cc-font); }
        .pcoded .pcoded-header .profile-notification li a { color: var(--cc-text) !important; font-size: .85rem; }
        .pcoded .pcoded-header .profile-notification li:hover { background: var(--cc-navy-50); }
        @@media (max-width: 1199.98px) { .pcoded .pcoded-header .cc-pill { max-width: 240px; } }
        @@media (max-width: 991.98px) { .pcoded .pcoded-header .cc-pill-item, .pcoded .pcoded-header .cc-product-item { display: none !important; } }
        @@media (max-width: 575.98px) { .pcoded .pcoded-header .cc-user-text { display: none; } .cc-logo { width: 128px; } }

        /* ---- Side menu (calm, enterprise style - 2026-11-04 rev. 2) ----
           Solid navy, one text weight, no rounded "pills". An open group gets a slightly darker band; only the screen
           you are on gets the orange marker. The theme's own salmon left lines (a:before, !important) are switched off. */
        .pcoded .pcoded-navbar, .pcoded .pcoded-navbar[navbar-theme] { background: #002164 !important; font-family: var(--cc-font); box-shadow: none; }
        .pcoded .pcoded-navbar .pcoded-inner-navbar, .pcoded .pcoded-navbar .main-menu { background: transparent !important; }
        .pcoded .pcoded-navbar .pcoded-item.pcoded-left-item { margin: 0; padding: 0; }
        .pcoded .pcoded-navbar .pcoded-item.pcoded-left-item:first-child { padding-top: 8px; }
        .pcoded .pcoded-navbar .pcoded-item > li > a {
            border-radius: 0 !important; margin: 0 !important; color: rgba(255,255,255,.80) !important;
            font-size: 13px !important; font-weight: 500; line-height: 1.35 !important; letter-spacing: 0;
            transition: background var(--cc-ease), color var(--cc-ease);
        }
        .pcoded .pcoded-navbar .pcoded-item > li > a .pcoded-micon i { color: rgba(255,255,255,.55) !important; font-size: 15px; }
        .pcoded .pcoded-navbar .pcoded-item > li > a:hover { background: rgba(255,255,255,.05) !important; color: #fff !important; }
        .pcoded .pcoded-navbar .pcoded-item > li.pcoded-trigger > a { background: rgba(0,0,0,.18) !important; color: #fff !important; }
        .pcoded .pcoded-navbar .pcoded-item > li.pcoded-trigger > a .pcoded-micon i { color: #fff !important; }
        .pcoded .pcoded-navbar .pcoded-item > li.pcoded-trigger > .pcoded-submenu,
        .pcoded .pcoded-navbar .pcoded-item li .pcoded-submenu { background: rgba(0,0,0,.18) !important; }
        .pcoded .pcoded-navbar .pcoded-item li .pcoded-submenu .pcoded-submenu { background: transparent !important; }
        .pcoded .pcoded-navbar .pcoded-item li .pcoded-submenu li > a {
            color: rgba(255,255,255,.68) !important; border-radius: 0; font-size: 12.5px !important; font-weight: 400; line-height: 1.35 !important;
            transition: background var(--cc-ease), color var(--cc-ease);
        }
        .pcoded .pcoded-navbar .pcoded-item li .pcoded-submenu li > a:hover { color: #fff !important; background: rgba(255,255,255,.05) !important; }
        .pcoded .pcoded-navbar .pcoded-item li .pcoded-submenu li.pcoded-trigger > a { color: #fff !important; font-weight: 500; }
        /* long names wrap instead of running under the arrow (the theme puts the text in an absolute box as wide
           as the menu); only in the normal open menu, the theme's collapsed / hidden modes are left alone */
        .pcoded[vertical-nav-type="expanded"] .pcoded-navbar .pcoded-item > li > a { display: flex !important; align-items: center; gap: 2px; }
        .pcoded[vertical-nav-type="expanded"] .pcoded-navbar .pcoded-item > li > a > .pcoded-micon { flex: none; }
        .pcoded[vertical-nav-type="expanded"] .pcoded-navbar .pcoded-item > li > a > .pcoded-mtext {
            position: static !important; flex: 1; min-width: 0; width: auto !important; white-space: normal !important; padding-left: 6px;
        }
        .pcoded .pcoded-navbar .pcoded-item li > a .pcoded-mtext { white-space: normal !important; }
        .pcoded .pcoded-navbar .pcoded-item li.pcoded-hasmenu > a { padding-right: 34px !important; }
        /* The theme's active colours / left lines use 5-class selectors with !important; the :not(.cc-x) parts only
           raise the specificity so these win. */
        .pcoded .pcoded-navbar[active-item-theme] .pcoded-item li:not(.cc-x):not(.cc-y) > a:before { border-left-width: 0 !important; border-left-color: transparent !important; }
        /* the screen you are on */
        .pcoded .pcoded-navbar[active-item-theme] .pcoded-item li.active:not(.cc-x):not(.cc-y) > a,
        .pcoded .pcoded-navbar[active-item-theme] .pcoded-item li.active:not(.cc-x):not(.cc-y) > a .pcoded-mtext {
            color: #fff !important; background: rgba(255,255,255,.08) !important; box-shadow: inset 3px 0 0 var(--cc-orange);
        }
        .pcoded .pcoded-navbar[active-item-theme] .pcoded-item li.active:not(.cc-x):not(.cc-y) > a .pcoded-mtext { background: transparent !important; box-shadow: none; }
        /* chevron: always "right", turned down when the group is open */
        .pcoded[theme-layout="vertical"] .pcoded-navbar .pcoded-item li.pcoded-hasmenu > a:after,
        .pcoded[theme-layout="vertical"] .pcoded-navbar .pcoded-item li.pcoded-hasmenu[dropdown-icon] > a:after {
            content: "\e844" !important; color: rgba(255,255,255,.40); font-size: 13px !important; padding-top: 0 !important;
            top: 50% !important; margin-top: -8px; line-height: 16px; transition: transform var(--cc-ease), color var(--cc-ease) !important;
        }
        .pcoded[theme-layout="vertical"] .pcoded-navbar .pcoded-item li.pcoded-hasmenu.pcoded-trigger > a:after { transform: rotate(90deg); color: rgba(255,255,255,.75); }
        .pcoded .pcoded-navbar .mCSB_scrollTools .mCSB_dragger_bar { background: rgba(255,255,255,.25) !important; }

        /* ---- Content area ---- */
        .pcoded .pcoded-main-container, .pcoded .pcoded-content, .pcoded .pcoded-inner-content { background: var(--cc-bg); }
        @@media (prefers-reduced-motion: reduce) { .pcoded .pcoded-header *, .pcoded .pcoded-navbar * { transition: none !important; } }
    </style>

</head>
