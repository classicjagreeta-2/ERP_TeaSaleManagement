    @* ===== Classic ERP skin (design only, 2026-11-04) =====
       Same look as Views\Module\SelectModule.cshtml. Only overrides the pcoded theme's header, side menu and the
       Menu/Index page - forms, grids and reports keep the old styles. Header stays 56px: the theme and the entry pages
       (#target sticks at 60px) depend on it. Icons are the theme's feather icons (Font Awesome 4 is already loaded
       here, so Font Awesome 5 is not added). Remove this block to get the old look back. See CLAUDE.md. *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style id="cc-skin">
        :root {
            --cc-navy: #002164; --cc-navy-800: #0B2C73; --cc-navy-900: #00163F; --cc-navy-50: #EEF2FA; --cc-navy-100: #E1E8F5;
            --cc-orange: #FE4D00; --cc-orange-50: #FFF2EB;
            --cc-bg: #F5F7FB; --cc-border: #E3E8F2; --cc-muted: #5B6B8C; --cc-text: #0B1B3F;
            --cc-shadow-sm: 0 1px 2px rgba(0,33,100,.06), 0 1px 3px rgba(0,33,100,.05);
            --cc-shadow-lg: 0 10px 24px rgba(0,33,100,.10), 0 24px 56px rgba(0,33,100,.10);
            --cc-ring: 0 0 0 .22rem rgba(254,77,0,.22);
            --cc-ease: 200ms cubic-bezier(.2,.7,.3,1);
            --cc-font: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        /* ---- Top bar ---- */
        .pcoded .pcoded-header .cc-pill {
            display: flex !important;
            align-items: center !important;
        }

            /* First badge */
            .pcoded .pcoded-header .cc-pill:first-child {
                white-space: nowrap !important;
            }

        /* Company badge */
        .pcoded .pcoded-header .header-notification .cc-pill {
            height: auto !important;
            min-height: 36px !important;
            padding: 5px 10px !important;
            white-space: normal !important;
            border-radius: 12px !important;
        }

        /* Company text */
        .pcoded .pcoded-header .cc-pill-text {
            display: block !important;
            min-width: 0 !important;
            white-space: normal !important;
            line-height: 1.3 !important;
        }

            /* Financial year */
