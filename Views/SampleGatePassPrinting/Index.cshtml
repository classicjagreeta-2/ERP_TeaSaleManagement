@{
    ViewBag.Title = "Sample Gate Pass Printing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("_HsReportHead")

<div class="general-container">
    <div class="rpt-details">
        @Html.Partial("_HsReportToolbar")

        <div class="header-details">
            <div class="row">
                <div class="col-md-4 align-items-center">
                    <div class="header-left"><div class="title-heading">Sample Gate Pass Printing</div></div>
                </div>
                <div class="col-md-8 d-flex justify-content-end align-items-center" style="padding-right:2.2%">
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Graphics" title="PDF in a new tab">Graphics</button>
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Html" title="HTML page in a new tab">HTML</button>
                    <button type="button" class="btn btn-primary mr-2 rpt-btn out-btn" data-output="Excel" title="Download as Excel (.xlsx)">Excel</button>
                </div>
            </div>

            <div class="accordion-container">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-15">
                                <label>From Date <span>(*)</span></label>
                                <div class="date-field">
                                    <input type="text" id="FromDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.FinancialYearFrom" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#FromDate" />
                                </div>
                            </div>
                            <div class="form-col-15">
                                <label>To Date <span>(*)</span></label>
                                <div class="date-field">
                                    <input type="text" id="ToDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.DefaultDate" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#ToDate" />
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Doc No From</label>
                                <div id="DocFrom_holder"></div>
                            </div>
                            <div class="form-col-20">
                                <label>Doc No To</label>
                                <div id="DocTo_holder"></div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-100" style="font-size:12px;color:#666;">
                                With a Doc No the dates are not used: Doc No From only (or To only) prints that document, both print the range.
                                With no Doc No, every sample draw of the period is printed.
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_HsReportScripts")
<script>
    $(function () {
        HsReport.init({ title: "Sample Gate Pass Printing", fyFrom: "@ViewBag.FinancialYearFrom", fyTo: "@ViewBag.FinancialYearTo" });
        var DOC_FIELDS = [{ name: "CODE", text: "DOC NO", width: "100px" }, { name: "DOCDT", text: "DATE", width: "90px" },
                          { name: "UNIT", text: "UNIT", width: "60px" }, { name: "TYPE", text: "TYPE", width: "50px" }];
        function loadDocs() {
            return $.getJSON('@Url.Action("Lookup", "SampleGatePassPrinting")', { what: "GetDocuments", fromDate: $("#FromDate").val(), toDate: $("#ToDate").val() });
        }
        HsReport.picker({ id: "DocFrom", multiple: false, auto: false, placeholder: "(none)", width: "360px", fields: DOC_FIELDS, load: loadDocs });
        HsReport.picker({ id: "DocTo", multiple: false, auto: false, placeholder: "(none)", width: "360px", fields: DOC_FIELDS, load: loadDocs });
        $("#FromDate, #ToDate").on("change", function () { HsReport.reload("DocFrom"); HsReport.reload("DocTo"); });

        $(".out-btn").on("click", function () {
            var from = HsReport.value("DocFrom"), to = HsReport.value("DocTo");
            if (!from && !to && !HsReport.checkPeriod("FromDate", "ToDate")) return;
            HsReport.open('@Url.Action("Report", "SampleGatePassPrinting")', {
                fromDate: $("#FromDate").val(),
                toDate: $("#ToDate").val(),
                docNoFrom: from,
                docNoTo: to,
                outputType: $(this).data("output")
            });
        });
    });
</script>
