@{
    ViewBag.Title = "Unsold List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("_HsReportHead")

<div class="general-container">
    <div class="rpt-details">
        @Html.Partial("_HsReportToolbar")

        <div class="header-details">
            <div class="row">
                <div class="col-md-4 align-items-center">
                    <div class="header-left"><div class="title-heading">Unsold List</div></div>
                </div>
                <div class="col-md-8 d-flex justify-content-end align-items-center" style="padding-right:2.2%">
                    @Html.Partial("_HsReportButtons")
                </div>
            </div>

            <div class="accordion-container">
                <div class="accordion">
                    <div class="accordion-header active"><span class="txt">Header</span></div>
                    <div class="accordion-body" style="display:block;">
                        <div class="form-row">
                            <div class="form-col-15">
                                <label>As on Date <span>(*)</span></label>
                                <div class="date-field">
                                    <input type="text" id="AsOnDate" class="form-control sr-date" autocomplete="off" data-default="@ViewBag.DefaultDate" />
                                    <img src="@Url.Content("~/libraries/assetspo/images/calendar.png")" alt="calendar" class="calendar-icon sr-cal" data-target="#AsOnDate" />
                                </div>
                            </div>
                            <div class="form-col-20">
                                <label>Select Unit <span>(*)</span></label>
                                <div id="Unit_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Select Garden</label>
                                <div id="Gardens_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Select Mark</label>
                                <div id="Marks_holder"></div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-30">
                                <label>Select Destination</label>
                                <div id="Destinations_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Select Category</label>
                                <div id="Categories_holder"></div>
                            </div>
                            <div class="form-col-30">
                                <label>Select Grade</label>
                                <div id="Grades_holder"></div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-30 non-jst">
                                <label>Based On</label>
                                <div class="sr-radio">
                                    <label><input type="radio" name="BasedOn" value="D" checked /> Despatch Date</label>
                                    <label><input type="radio" name="BasedOn" value="A" /> AWR Date</label>
                                </div>
                            </div>
                            <div class="form-col-30">
                                <label>Crop</label>
                                <div class="sr-radio">
                                    <label><input type="radio" name="Crop" value="A" checked /> All</label>
                                    <label><input type="radio" name="Crop" value="N" /> New Crop</label>
                                    <label><input type="radio" name="Crop" value="O" /> Old Crop</label>
                                </div>
                            </div>
                            <div class="form-col-30">
                                <label>Report</label>
                                <div class="sr-radio">
                                    <label><input type="radio" name="Layout" value="L" checked /> Unsold List</label>
                                    <label class="jst-only"><input type="radio" name="Layout" value="A" /> Stock Ageing</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-col-40">
                                <div class="sr-check">
                                    <label><input type="checkbox" id="SalesInvoiceOnly" /> Base On Sales Invoice Only</label>
                                    <label class="jst-only"><input type="checkbox" id="NegativeStock" /> With Negative Stock</label>
                                    <label class="non-jst"><input type="checkbox" id="IncludeAuctionRelease" /> Include Auction Release</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_HsReportScripts")
<script>
    $(function () {
        HsReport.init({ title: "Unsold List", fyFrom: "@ViewBag.FinancialYearFrom", fyTo: "@ViewBag.FinancialYearTo" });
        var lookup = '@Url.Action("Lookup", "UnsoldList")';
        // JST units: negative stock / stock ageing; other units: despatch / AWR date and auction release.
        function setUnit(code) {
            $(".jst-only, .non-jst").hide();
            if (!code) return;
            $.getJSON('@Url.Action("Options", "UnsoldList")', { unit: code }, function (o) {
                $(o && o.jst ? ".jst-only" : ".non-jst").show();
                if (!(o && o.jst) && $("input[name=Layout]:checked").val() === "A") $("input[name=Layout][value=L]").prop("checked", true);
            });
        }
        setUnit("");
        HsReport.picker({ id: "Unit", multiple: false, placeholder: "Select Unit", width: "320px",
            load: function () { return $.getJSON('@Url.Action("Units", "UnsoldList")'); }, onChange: setUnit });
        HsReport.picker({ id: "Gardens", load: function () { return $.getJSON(lookup, { what: "GetGardens" }); } });
        HsReport.picker({ id: "Marks", load: function () { return $.getJSON(lookup, { what: "GetMarks" }); } });
        HsReport.picker({ id: "Destinations", load: function () { return $.getJSON(lookup, { what: "GetDestinations" }); } });
        HsReport.picker({ id: "Categories", load: function () { return $.getJSON(lookup, { what: "GetCategories" }); } });
        HsReport.picker({ id: "Grades", load: function () { return $.getJSON(lookup, { what: "GetGrades" }); } });

        $(".out-btn").on("click", function () {
            if (!HsReport.checkPeriod("AsOnDate")) return;
            if (!HsReport.value("Unit")) { HsReport.alert("Select a Unit."); return; }
            HsReport.open('@Url.Action("Report", "UnsoldList")', {
                asOnDate: $("#AsOnDate").val(),
                unit: HsReport.value("Unit"),
                gardens: HsReport.codes("Gardens"),
                marks: HsReport.codes("Marks"),
                destinations: HsReport.codes("Destinations"),
                categories: HsReport.codes("Categories"),
                grades: HsReport.codes("Grades"),
                basedOn: $("input[name=BasedOn]:checked").val(),
                crop: $("input[name=Crop]:checked").val(),
                salesInvoiceOnly: $("#SalesInvoiceOnly").is(":checked"),
                negativeStock: $("#NegativeStock").is(":visible") && $("#NegativeStock").is(":checked"),
                includeAuctionRelease: $("#IncludeAuctionRelease").is(":visible") && $("#IncludeAuctionRelease").is(":checked"),
                layout: $("input[name=Layout]:checked").val(),
                outputType: $(this).data("output")
            });
        });
    });
</script>
