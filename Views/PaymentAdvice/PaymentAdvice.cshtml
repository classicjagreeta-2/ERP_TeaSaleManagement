@model PagedList.StaticPagedList<Finance.Models.DTO.TRN_PAYMENT_ADVICE_DTO>
@using PagedList.Mvc;
@using PagedList;
@using Finance.Utility
@{
    ViewBag.Title = "PaymentAdvice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>PaymentAdvice Entry</title>

</head>

<body>

    <!-- first screen start -->
    <div class="general-container">

        <!-- action btns start -->
        <div class="action-btns">

            <ul>
                <li> <button type="button" class="IdaddNewRecord btn btn-link"> <i class="fa fa-plus"></i> New </button> </li>
                @*<li>
                    <button class="dt-button buttons-copy btn-sm" tabindex="0" aria-controls="example" type="button" fdprocessedid="yfptws"><span>Copy Voucher</span></button>
                </li>*@    
            </ul>
        </div>
        <!-- action btns end -->

        <div class="title-heading">PaymentAdvice Entry</div>

        <div class="search-box">
            <div class="search">
                @using (Html.BeginForm("PaymentAdvice", "PaymentAdvice", FormMethod.Get))
                {
                    <label>@Html.TextBox("SearchString", ViewBag.CurrentFilter as string, new { @class = "form-control input-sm", @oninput = "this.value = this.value.toUpperCase()", @placeholder = "Search" })</label>
                }
            </div>
        </div>

        <!-- table start -->
        <div class="table-responsive">
            <table id="table1" class="border main-table">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Advice No</th>
                        <th>
                            Advice Date <a href="#">
                                <i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i>
                            </a>
                        </th>

                        <th>Party Code & Name <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a></th>
                        <th>
                            Bill No <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                        <th>
                            Bill Date <a href="#">
                                <i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i>
                            </a>
                        </th>
                        <th>
                            Bill Amount <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                        <th>
                            Deduction Amount <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                        <th>
                            TDS Amount <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                        <th>
                            Amount Payable <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                        <th>
                            Remarks <a href="#"><i class="feather icon-arrow-up"></i><i class="feather icon-arrow-down"></i></a>
                        </th>
                    </tr>
                </thead>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tbody>
                            @{
                                var disabled = item.LOCKEDUNTIL.HasValue &&
                                        item.LOCKEDUNTIL > DateTime.Now &&
                                        item.LOCKEDBYUSERID != @SessionHelper.GetUser().getUserName;
                                var lockMessage = (disabled) ? $"Locked By User {item.LOCKEDBYUSERID}" : "";
                            }
                            <tr class="main-row @(disabled ? "disabled-row" : "")"
                                title="@(disabled ? lockMessage : "")"
                                style="@(disabled ? "background-color:#f2f2f2;color:#808080;opacity:0.6;" : "")">
                                <td>
                                    @using (Html.BeginForm("InsertOrUpdate", "PaymentAdvice", FormMethod.Get, new { style = "display:inline" }))
                                    {
                                        @Html.Hidden("Id", item.ID)
                                        <button type="submit" @(disabled ? "disabled" : "")> <i class='fa fa-edit'></i></button>
                                    }
                                    <button disabled><i class='fa fa-trash-o'></i></button>
                                    <button type="button"
                                            class="option"
                                            onclick="window.open('@Url.Action("PrintPaymentAdvice", "PaymentAdvice", new { PAYADVUNIT = item.UNIT, PAYADVNO = item.PAYADV_NO, PAYADVDT = item.PAYADV_DT?.ToString("yyyy-MM-dd") })', '_blank')"
                                            data-unit="@item.UNIT">
                                        <i class='fa fa-print'></i>
                                    </button>
                                </td>
                                <td>@item.PAYADV_NO</td>
                                <td>@(item.PAYADV_DT.HasValue ? item.PAYADV_DT.Value.ToString("dd-MM-yyyy") : "")</td>
                                <td>@item.ACODE@item.SUBCODE - @item.ACNAME</td>
                                <td>@item.BLNO</td>
                                <td>@(item.BLDT?.ToString("dd-MM-yyyy"))</td>
                                <td>@item.BILL_AMT</td>
                                <td>@item.DEDUCT_AMT</td>
                                <td>@item.TDS_AMT</td>
                                <td>@item.PAYABLE_AMT</td>
                                <td>@item.REMARKS</td>
                            </tr>

                        </tbody>
                    }
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="11"><center> No Data </center></td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <!-- table end -->
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-5">
                <div class="dataTables_info" id="dom-jqry_info" role="status" aria-live="polite"> Showing @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-7">
                <div class="dataTables_paginate paging_simple_numbers" id="dom-jqry_paginate">
                    @Html.PagedListPager(Model, page => Url.Action("PaymentAdvice", new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter, pageSize = ViewBag.PageSize }))
                </div>
            </div>
        </div>

    </div>
    <!-- first screen end -->
    <!-- Overlay -->
    <div class="popup-overlay">

        <!-- Popup Voucher Printing -->
        <div id="VoucherPrinting" class="popup-box">
            <div class="popup-header">
                <h2>MemoVoucher Printing</h2>
                <button class="close-btn">X</button>
            </div>


            <div class="voucher-printing">
                <div class="row-printing">

                    <div class="col">
                        <label class="form-label">Date From</label>
                        <input type="text" id="datefrom" name="fname" value="">
                    </div>

                    <div class="col">
                        <label for="fname" class="form-label">Date Upto</label>
                        <input type="text" id="dateupto" name="fname" value="">
                    </div>

                    <div class="col">
                        <label for="inputCity" class="form-label">Unit</label>

                        <input type="text" id="unit" name="fname" value="">
                    </div>

                    <div class="col">
                        <label for="inputCity" class="form-label">Voucher Type</label>

                        <input type="text" id="vtype" name="fname" value="">
                    </div>

                    <div class="col">
                        <label for="inputEmail4" class="form-label">Voucher From</label>
                        <input type="text" id="vfrom">
                    </div>

                    <div class="col">
                        <label for="inputEmail4" class="form-label">To</label>
                        <input type="text" id="to">
                    </div>

                    <div class="col">
                        <div class="checkbox-row">
                            <input type="checkbox" id="withdetail" checked="" name="withdetail" value="detail">
                            <label for="Memo">With Detail Narration</label>
                        </div>
                    </div>

                    <div class="col">
                        <div class="checkbox-row">
                            <input type="checkbox" id="WithParty" name="WithParty" value="party">
                            <label for="Memo">With Party Bank Details</label>
                        </div>
                    </div>

                    <div class="col">
                        <div class="checkbox-row">
                            <input type="checkbox" id="qty" checked="" name="qty" value="qty">
                            <label for="Provisional">Show Quantity</label>
                        </div>
                    </div>

                </div>

                <div class="bottom-btn">
                    @*<button class="btn-blue">Ok</button>
                        <button class="btn-white">Cancel</button>*@
                    <input type="submit" id="Btn_ok" class="btn btn-info" target="_blank" value="Ok">
                    <input type="submit" id="cancelBtn" class="btn btn-info" style="margin-left: 12px;" value="Cancel">
                </div>
            </div>
        </div>
        <!-- Overlay end -->


        <script src="~/Content/assets/js/custom.js"></script>
