@model Finance.Models.DTO.TRN_PAYMENT_ADVICE_DTO
@{
    var _aedv = (Finance.Helpers.AEDV)ViewBag._aedv;
    ViewBag.Title = "Payment Advice Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{ 
    string UnitValue = ViewBag.Unit;
}

<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Voucher Entry</title>
    <!-- CSS -->

    <link href="~/Content/assets/css/font-awesome.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/assets/css/jquery-ui.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry.css">
    <link rel="stylesheet" href="~/Content/assets/css/voucher-entry-responsive.css">
    <link href="~/Content/src/jquery.inputpicker.css" rel="stylesheet">
    <script src="https://unpkg.com/slim-select@latest/dist/slimselect.js"></script>
    <link href="https://unpkg.com/slim-select@latest/dist/slimselect.css" rel="stylesheet"></link>
    <style>
        /* Keyboard ↑ ↓ selected row */
        .inputpicker-wrapped-list tr.inputpicker-active {
            background-color: #0d6efd !important; /* BLUE */
            color: #ffffff !important;
        }

            /* Force text visibility */
            .inputpicker-wrapped-list tr.inputpicker-active td {
                color: white !important;
                background-color: navy !important;
            }

        /* Mouse hover same as keyboard */
        .inputpicker-wrapped-list tr:hover {
            background-color: #0d6efd !important;
            color: #ffffff !important;
        }

        /* Optional: selected (clicked) row */
        .inputpicker-wrapped-list tr.inputpicker-selected {
            background-color: #cfe2ff !important;
        }
        /* make space for X */
        .inputpicker-input {
            padding-right: 22px !important;
        }

        /* parent must allow absolute position */
        .inputpicker-div {
            position: relative !important;
        }

        /* X button always top */
        /*.ip-clear-btn {
            position: absolute !important;
            right: 6px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            z-index: 9;
            pointer-events: auto !important;
            cursor: pointer !important;
        }*/

        /* dropdown should be lower than X */
        .inputpicker-wrapped-list {
            z-index: 999999 !important;
            max-width: 50%;
            min-width: 250px;
        }

        /* space for X */
        .inputpicker-input {
            padding-right: 22px !important;
        }
        /* Fix: prevent inputpicker wrapper from shrinking the textbox inside the modal */
        #billSelectionModal .inputpicker-div,
        #billSelectionModal .inputpicker-overflow-hidden {
            width: 100% !important;
            display: block !important;
        }

        #billSelectionModal .inputpicker-input {
            width: 100% !important;
            box-sizing: border-box !important;
        }
        /* Scroll lock when modal is open */
        html.modal-scroll-lock {
            overflow: hidden !important;
        }
        /* Page-scoped: no vertical scroll on voucher-container */
        .voucher-container {
            overflow-y: visible !important;
        }
        /* Override global sticky tfoot — let Total row flow naturally */
        #paymentAdviceTable tfoot th {
            position: static !important;
        }
        /* Non-editable cells — light professional background */
        #paymentAdviceTable tbody td.field-width,
        #paymentAdviceTable tbody input[readonly] {
            background-color: #eef1f6 !important;
        }
    </style>

</head>

<body>
    <div class="general-container">
        <div class="voucher-details">
            <!-- header content start -->
            <div class="header-content">
                <!-- action btns start -->
                <div class="action-btns">
                    <ul>
                        <li><a href="#" id="Btn_Save"><i class="fa fa-floppy-o"></i> Save</a></li>
                        <li><a href="@Url.Action("PaymentAdvice", "PaymentAdvice")" id="btnCancelHeader"><i class="fa fa-times"></i> Cancel</a></li>
                        <li style="margin-left: auto;">
                            <label class="btn btn-inverse pull-right" style="border-radius: 6px; margin-right: 10px;"> Payment Advice Entry </label>
                        </li>
                    </ul>
                </div>
                <!-- action btns end -->
            </div>
            <!-- header content end -->

            <div class="voucher-container">
                <div class="voucher-content">
                    <form id="formPaymentAdvice" class="cash-form">
                        <div class="row">
                            <div class="col-4">
                                <div class="form-group border-bottom">
                                    <label>Payment Advice No:</label>
                                    <div class="date-field">
                                        <input type="text" id="paymentAdviceNo" class="form-control border-bottom" value="@Model.PAYADV_NO" readonly="readonly" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-group border-bottom">
                                    <label>Advice Date:</label>
                                    <div class="date-field">
                                        @{
                                            bool isEdit = Model.PAYADV_DT != null;
                                        }
                                        @if (isEdit)
                                        {
                                            @Html.TextBox(
                                                "PAYADV_DT",
                                                Model.PAYADV_DT?.ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                    id = "adviceDate",
                                                    @class = "form-control border-bottom",
                                                    style = "width:100%",
                                                    type = "date",
                                                    @required = "required",
                                                    min = ((DateTime)ViewBag.MinDate).ToString("yyyy-MM-dd"),
                                                    max = DateTime.Today.ToString("yyyy-MM-dd"),
                                                    @readonly = "readonly"
                                            })
                                        }
                                        else
                                        {
                                            @Html.TextBox(
                                                "PAYADV_DT",
                                                Model.PAYADV_DT?.ToString("yyyy-MM-dd"),
                                                new
                                                {
                                                id = "adviceDate",
                                                @class = "form-control border-bottom",
                                                style = "width:100%",
                                                type = "date",
                                                @required = "required",
                                                min = ((DateTime)ViewBag.MinDate).ToString("yyyy-MM-dd"),
                                                max = DateTime.Today.ToString("yyyy-MM-dd")
                                            })
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-group border-bottom">
                                    <input type="hidden" id="unit" class="form-control border-bottom" value="@(@Model.UNIT)" />
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="voucher-content">
                    <!-- action btns start -->
                    <div class="action-btns">
                        <ul>
                            <li>
                                <a href="#" id="btnShowBillModal" class="openPopup" data-popup="billSelectionModal">
                                    <i class="fa fa-list"></i> Select Bills
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- action btns end -->

                    <form class="cash-form">
                        <div class="table-responsive" style="max-height: calc(100vh - 280px); overflow-x: auto; overflow-y: auto;">
                            <table class="border no-border-form" id="paymentAdviceTable">
                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>A/c Code</th>
                                        <th>Ac Name</th>
                                        <th>Bill No</th>
                                        <th>Bill Date</th>
                                        <th>Due Date</th>
                                        <th>Bill Amount</th>
                                        <th>Deduct Amount</th>
                                        <th>TDS</th>
                                        <th>Amount Payable</th>
                                        <th style="width: 80px;">Remarks</th>
                                    </tr>
                                </thead>
                                <tbody id="paymentAdviceGridBody">
                                    @for (int i = 0; i < 0; i++)
                                    {
                                        <tr id="row_@i">
                                            <td class="action-btn-col">
                                                @(i == 0 ? Html.Raw("<i class='fa fa-trash-o' style='cursor:pointer;color:#c0392b;'></i>") : Html.Raw(""))
                                            </td>
                                            <td class="field-width"></td>
                                            <td class="field-width"></td>
                                            <td class="field-width"></td>
                                            <td class="field-width"></td>
                                            <td class="field-width"></td>
                                            <td><input type="number" class="cr" value="0.00" readonly /></td>
                                            <td><input type="number" class="cr" value="0.00" readonly /></td>
                                            <td><input type="number" class="cr" value="0.00" readonly /></td>
                                            <td><input type="number" class="cr" value="0.00" readonly /></td>
                                            <td class="field-width"></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total">
                                        <th colspan="6" class="right"><strong>Total:</strong></th>
                                        <th id="totalBillAmount" class="right">0.00</th>
                                        <th id="totalDeductAmount" class="right">0.00</th>
                                        <th id="totalTDS" class="right">0.00</th>
                                        <th id="totalPayableAmount" class="right">0.00</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </form>
                </div>

                <!-- Buttons outside scrollable area -->
                <div class="bottom-btn" style="background-color: #fff; padding: 10px 20px; border: 1px solid #ddd; border-top: none;">
                    <button type="button" class="btn-white" id="btnSendMail">Send Mail</button>
                    <button type="button" class="btn-white" id="btnPrint">Print Payment Advice</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Overlay -->
    <div class="popup-overlay" id="billSelectionOverlay">
        <!-- Popup Bill Selection -->
        <div id="billSelectionModal" class="popup-box" style="width: 80%;">
            <div class="popup-header">
                <h2>Select Bills</h2>
                <button class="close-btn" id="closeBillModal">X</button>
            </div>

            <form class="cash-form">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group border-bottom">
                            <label>Party:</label>
                            <div class="date-field" id="partyCodeContainer">
                                <input type="text" id="modalPartyCode" class="form-control border-bottom" autocomplete="off"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group border-bottom">
                            <label>&nbsp;</label>
                            <input type="text" id="modalPartyName" class="form-control border-bottom" readonly="readonly" style="background-color: #f5f5f5;" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div class="bottom-btn" style="padding-top: 0; justify-content: flex-start; margin-top: -4px;">
                                <button type="button" class="btn-white" id="btnRefreshBills">Refresh</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group border-bottom">
                            <label>From Date:</label>
                            @{ 
                                string formattedStart = ViewBag.start != null ? DateTime.ParseExact(ViewBag.start.ToString(), "dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString("yyyy-MM-dd") : "2026-04-01";
                            }
                            <input type="date" id="modalFromDate" class="form-control border-bottom" value="@formattedStart" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group border-bottom">
                            <label>Upto Date:</label>
                            @{
                                string formattedEnd = ViewBag.end != null ? DateTime.ParseExact(ViewBag.end.ToString(), "dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString("yyyy-MM-dd") : "2026-06-26";
                            }
                            <input type="date" id="modalUptoDate" class="form-control border-bottom" value="@formattedEnd" />
                        </div>
                    </div>
                    <div class="col-md-4"></div>
                </div>

                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                    <table class="border main-table auto-fit-table" id="modalBillsTable" style="position: relative;">
                        <thead style="position: sticky; top: 0; z-index: 1; background-color: #fff;">
                            <tr>
                                <th>Sel.</th>
                                <th>Bill No</th>
                                <th>Bill Date</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>TDS Amt</th>
                                <th>Payable Amount</th>
                                <th>doc</th>
                                <th>docno</th>
                                <th>docdt</th>
                                <th>srl</th>
                                <th>A/c Code</th>
                                <th>Ac Name</th>
                            </tr>
                        </thead>
                        <tbody id="modalBillsBody">
                            @for (int i = 0; i < 0; i++)
                            {
                                <tr>
                                    <td class="action-btn-col"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td><input type="number" class="cr" value="0.00" readonly /></td>
                                    <td><input type="number" class="cr" value="0.00" readonly /></td>
                                    <td><input type="number" class="cr" value="0.00" readonly /></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                    <td class="field-width"></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bottom-btn">
                    <button type="button" class="btn-white" id="btnModalSelectAll">Select All</button>
                    <button type="button" class="btn-white" id="btnModalDeselectAll">De-Select All</button>
                    <button type="button" class="btn-white" id="btnModalCancel">Cancel</button>
                    <button type="button" class="btn-blue" id="btnModalOK">OK</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
        <script src="~/Content/src/jquery.inputpicker.js"></script>
        <script src="~/Content/assets/js/custom.js"></script>
        <script>
        $(document).ready(function() {
            var modalPartyPickerInit = false;

            function calculateFooterTotals() {
                var totalBill = 0;
                var totalDeduct = 0;
                var totalTds = 0;
                var totalPayable = 0;

                $('#paymentAdviceGridBody tr').each(function() {
                    var billAmt = parseFloat($(this).find('.bill-amt').val()) || 0;
                    var deductAmt = parseFloat($(this).find('.deduct-amt').val()) || 0;
                    var tdsAmt = parseFloat($(this).find('.tds-amt').val()) || 0;
                    var payableAmt = parseFloat($(this).find('.payable-amt').val()) || 0;

                    totalBill += billAmt;
                    totalDeduct += deductAmt;
                    totalTds += tdsAmt;
                    totalPayable += payableAmt;
                });

                $('#totalBillAmount').text(totalBill.toFixed(2));
                $('#totalDeductAmount').text(totalDeduct.toFixed(2));
                $('#totalTDS').text(totalTds.toFixed(2));
                $('#totalPayableAmount').text(totalPayable.toFixed(2));
            }

            // Recalculate row payable and footer totals on input change
            $(document).on('input', '.deduct-amt, .tds-amt', function() {
                var tr = $(this).closest('tr');
                var bill = parseFloat(tr.find('.bill-amt').val()) || 0;
                var deduct = parseFloat(tr.find('.deduct-amt').val()) || 0;
                var tds = parseFloat(tr.find('.tds-amt').val()) || 0;
                var payable = bill - deduct - tds;
                tr.find('.payable-amt').val(payable.toFixed(2));
                calculateFooterTotals();
            });
            function toIsoDate(dateStr) {
                if (!dateStr || dateStr.trim() === "") {
                    return ""; 
                }
                const parts = dateStr.split('/');
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            // Save Handler
            $('#Btn_Save').click(function(e) {
                e.preventDefault();
                var initialAdviceNo = $('#paymentAdviceNo').val();
                let stopSave = false;
                if (initialAdviceNo) {
                    if (refreshInterval) {
                        clearInterval(refreshInterval);
                        refreshInterval = null;
                    }
                    let unit = '@UnitValue';
                    $.ajax({
                        url: '@Url.Action("CheckRowVersion", "PaymentAdvice")',
                        type: 'GET',
                        async: false,
                        data: {
                            PaymentAdviceNo: initialAdviceNo,
                            unit: unit
                        },
                        success: function (response) {
                            if (response.status === false) {
                                $.confirm({
                                    title: 'Record Locked',
                                    type: 'red',
                                    content: response.content,
                                    typeAnimated: true,
                                    icon: 'icon-smiley',
                                    buttons: {
                                        Okay: function (e) {
                                            var url = "@Url.Action("PaymentAdvice", "PaymentAdvice")";
                                            window.location.href = url;
                                        },
                                    }
                                });
                                stopSave = true;
                            }
                        },
                        error: function (xhr) {
                            alert('An error occurred.');
                            stopSave = true;
                        }
                    });
                }
                if (stopSave === true) {
                    return false;
                }
                var adviceDate = $('#adviceDate').val();
                if (!adviceDate) {
                    alert("Please select Advice Date.");
                    return;
                }
                var rows = $('#paymentAdviceGridBody tr');
                if (rows.length === 0) {
                    alert("Please add at least one bill before saving.");
                    return;
                }

                var adviceNo = $('#paymentAdviceNo').val() || "";
                var unit = $('#unit').val() || "";
                var dataList = [];
                rows.each(function() {
                    var $row = $(this);
                    var obj = {
                        UNIT:unit,
                        ACODE: $row.data('acode'),
                        SUBCODE: $row.data('subcode'),
                        I_DOCTYPE: $row.data('i_doctype'),
                        I_DOCNO: $row.data('i_docno'),
                        I_DOCDT: $row.data('i_docdt'),
                        I_SRLNO: parseInt($row.data('i_srlno')) || 0,
                        BLNO: $row.find('td').eq(3).text().trim(),
                        BLDT: toIsoDate($row.find('td').eq(4).text().trim()),
                        DUEDT: toIsoDate($row.find('td').eq(5).text().trim()),
                        BILL_AMT: parseFloat($row.find('.bill-amt').val()) || 0,
                        DEDUCT_AMT: parseFloat($row.find('.deduct-amt').val()) || 0,
                        TDS_AMT: parseFloat($row.find('.tds-amt').val()) || 0,
                        PAYABLE_AMT: parseFloat($row.find('.payable-amt').val()) || 0,
                        REMARKS: $row.find('.remarks-inp').val(),
                        PAYADV_DT: adviceDate,
                        PAYADV_NO: adviceNo
                    };
                    dataList.push(obj);
                });

                $.ajax({
                    url: '@Url.Action("Save", "PaymentAdvice")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataList),
                    success: function (response) {
                        $.confirm({
                            title: 'Confirmation !!',
                            type: 'green',
                            content: response.message,
                            typeAnimated: true,
                            icon: 'icon-smiley',
                            buttons: {
                                Okay: function (e) {
                                    var url = "@Url.Action("PaymentAdvice", "PaymentAdvice")";
                                    window.location.href = url;
                                },
                            }
                        });
                    },
                    error: function (error) {
                        alert("Error while saving");
                    }
                });
            });

            $('#btnCancelHeader').click(function(e) {
                e.preventDefault();
                var url = "@Url.Action("PaymentAdvice", "PaymentAdvice")";
                var initialAdviceNo = $('#paymentAdviceNo').val();
                if (initialAdviceNo) {
                    $.ajax({
                        contentType: 'application/json',
                        url: '@Url.Action("RemoveRowVersion", "PaymentAdvice")' + '?PaymentAdviceNo=' + encodeURIComponent(initialAdviceNo) + '&unit=' + encodeURIComponent('@UnitValue'),
                        type: 'GET'
                    });
                }
                window.location.href = url;
            });

            // Modal Handlers
            $('#btnShowBillModal').click(function(e) {
                e.preventDefault();

                // Reset the modal pop up
                if (modalPartyPickerInit) {
                    $('#modalPartyCode').inputpicker('destroy');
                    // inputpicker's destroy method is buggy and removes/hides the original element.
                    // We rebuild it here to ensure the textbox comes back cleanly.
                    $('#partyCodeContainer').html('<input type="text" id="modalPartyCode" class="form-control border-bottom" autocomplete="off"/>');
                    modalPartyPickerInit = false;
                }

                $('#modalPartyCode').val('');
                $('#modalPartyName').val('');
                $('#modalBillsBody').empty();

                $('html').addClass('modal-scroll-lock'); // lock ALL page scroll
                $('#billSelectionOverlay').show();
                $('#billSelectionModal').show();
            });

            $('#closeBillModal, #btnModalCancel').click(function(e) {
                e.preventDefault();

                var $checkedBoxes = $('#modalBillsBody').find('.bill-select:checked');
                var adviceBody = $('#paymentAdviceGridBody');
                var billIdsToUnlock = [];

                $checkedBoxes.each(function() {
                    var $row = $(this).closest('tr');
                    var billId = $row.data('id');

                    if (billId) {
                        var isAlreadyAdded = adviceBody.find('tr[data-id="' + billId + '"]').length > 0;
                        if (!isAlreadyAdded) {
                            billIdsToUnlock.push(billId);
                        }
                    }
                });

                if (billIdsToUnlock.length > 0) {
                    var unlockUrl = '@Url.Action("RemovebillLock", "PaymentAdvice")' + '?' + $.param({ billid: billIdsToUnlock }, true);
                    fetch(unlockUrl).catch(function(err) {
                        console.error('Error removing bill lock:', err);
                    });
                }

                $('html').removeClass('modal-scroll-lock'); // restore page scroll
                $('#billSelectionOverlay').hide();
                $('#billSelectionModal').hide();
            });

            // Select/Deselect All
            $('#btnModalSelectAll').click(function() {
                var $checkboxes = $('#modalBillsBody').find('.bill-select:not(:disabled):not(:checked)');
                if ($checkboxes.length === 0) return;

                var $btn = $(this);
                $btn.prop('disabled', true).text('Selecting...');

                var billIds = [];
                var rowMap = {};

                $checkboxes.each(function() {
                    var $cb = $(this);
                    var $row = $cb.closest('tr');
                    var billId = $row.data('id');

                    if (billId) {
                        billIds.push(billId);
                        rowMap[billId] = { cb: $cb, row: $row };
                    }
                });

                if (billIds.length > 0) {
                    var lockUrl = '@Url.Action("Lockbill", "PaymentAdvice")' + '?' + $.param({ billid: billIds }, true);
                    fetch(lockUrl)
                        .then(function(response) { return response.json(); })
                        .then(function(results) {
                            if (results && Array.isArray(results)) {
                                results.forEach(function(res) {
                                    var item = rowMap[res.billId];
                                    if (item) {
                                        if (res.status === false) {
                                            item.cb.prop('checked', false); // Revert
                                            item.row.css('cursor', 'not-allowed').attr('title', res.content || '');
                                            item.row.find('td, input').each(function () {
                                                this.style.setProperty('background-color', '#f2f2f2', 'important');
                                            });
                                            item.row.find('input').prop('disabled', true);
                                        } else {
                                            item.cb.prop('checked', true); // Visually check
                                        }
                                    }
                                });
                            }
                            $btn.prop('disabled', false).text('Select All');
                        })
                        .catch(function(err) {
                            console.error('Error locking bills:', err);
                            $btn.prop('disabled', false).text('Select All');
                        });
                } else {
                    $btn.prop('disabled', false).text('Select All');
                }
            });

            // Remove row on trash icon click
            $(document).on('click', '#paymentAdviceGridBody .fa-trash-o', function (e) {
                e.preventDefault();
                let row = $(this).closest('tr');
                let billId = row.data('id');
                $.confirm({
                    title: "Delete Confirmation",
                    content: "This action is irreversible. Are you sure you want to proceed?",
                    buttons: {
                        confirm: {
                            text: "Yes, delete it",
                            action: function () {
                                if (billId) {
                                    var unlockUrl = '@Url.Action("RemovebillLock", "PaymentAdvice")' + '?' + $.param({ billid: [billId] }, true);
                                    fetch(unlockUrl).catch(function(err) {
                                        console.error('Error removing bill lock:', err);
                                    });
                                }
                                row.remove();
                                calculateFooterTotals();
                            }
                        },
                        cancel: {
                            text: "No, cancel",
                            action: function () {
                            }
                        }
                    }
                });
            });

            $('#btnModalDeselectAll').click(function() {
                var $checkboxes = $('#modalBillsBody').find('.bill-select:not(:disabled):checked');
                if ($checkboxes.length === 0) return;

                var $btn = $(this);
                $btn.prop('disabled', true).text('De-Selecting...');

                var billIds = [];
                var rowMap = {};
                var adviceBody = $('#paymentAdviceGridBody');

                $checkboxes.each(function() {
                    var $cb = $(this);
                    var $row = $cb.closest('tr');
                    var billId = $row.data('id');

                    if (billId) {
                        var isAlreadyAdded = adviceBody.find('tr[data-id="' + billId + '"]').length > 0;
                        if (!isAlreadyAdded) {
                            billIds.push(billId);
                            rowMap[billId] = { cb: $cb };
                        }
                    }
                });

                if (billIds.length > 0) {
                    var unlockUrl = '@Url.Action("RemovebillLock", "PaymentAdvice")' + '?' + $.param({ billid: billIds }, true);
                    fetch(unlockUrl)
                        .then(function(response) { return response.json(); })
                        .then(function(results) {
                            if (results && Array.isArray(results)) {
                                results.forEach(function(res) {
                                    var item = rowMap[res.billId];
                                    if (item) {
                                        if (res.status === false) {
                                            console.warn('Unable to remove lock: ', res.content);
                                        } else {
                                            item.cb.prop('checked', false); // Visually uncheck
                                        }
                                    }
                                });
                            }
                            $btn.prop('disabled', false).text('De-Select All');
                        })
                        .catch(function(err) {
                            console.error('Error removing bill lock:', err);
                            $btn.prop('disabled', false).text('De-Select All');
                        });
                } else {
                    $btn.prop('disabled', false).text('De-Select All');
                }
            });

            function addAdviceRow(item) {
                var adviceBody = $('#paymentAdviceGridBody');
                var rowId = item.id || '';
                var accode = (item.acode || '') + (item.subcode || '');
                var acname = item.acname || '';
                var blno = item.blno || '';
                var bldt = item.bldt || '';
                var duedt = item.duedt || '';
                var billAmt = parseFloat(item.billAmt) || 0;
                var deductAmt = parseFloat(item.deductAmt) || 0;
                var tdsAmt = parseFloat(item.tdsAmt) || 0;
                var payable = parseFloat(item.payable) || 0;
                var remarks = item.remarks || '';

                // Skip if this bill is already added (prevent duplicates)
                if (rowId && adviceBody.find('tr[data-id="' + rowId + '"]').length > 0) return;

                var idx = adviceBody.find('tr').length;
                var newRow = '<tr id="adv-row-' + idx + '" data-id="' + rowId + '"' +
                    ' data-acode="' + (item.acode || '') + '"' +
                    ' data-subcode="' + (item.subcode || '') + '"' +
                    ' data-i_doctype="' + (item.i_doctype || '') + '"' +
                    ' data-i_docno="' + (item.i_docno || '') + '"' +
                    ' data-i_docdt="' + (item.i_docdt || '') + '"' +
                    ' data-i_srlno="' + (item.i_srlno || '') + '"' +
                    '>' +
                    '<td class="action-btn-col"><i class="fa fa-trash-o" style="cursor:pointer;color:#c0392b;"></i></td>' +
                    '<td class="field-width">' + accode + '</td>' +
                    '<td class="field-width">' + acname + '</td>' +
                    '<td class="field-width">' + blno   + '</td>' +
                    '<td class="field-width">' + bldt   + '</td>' +
                    '<td class="field-width">' + duedt  + '</td>' +
                    '<td><input type="number" class="cr bill-amt"     value="' + billAmt.toFixed(2) + '" readonly /></td>' +
                    '<td><input type="number" class="cr deduct-amt"   value="' + deductAmt.toFixed(2) + '" /></td>' +
                    '<td><input type="number" class="cr tds-amt"      value="' + tdsAmt.toFixed(2) + '" /></td>' +
                    '<td><input type="number" class="cr payable-amt"  value="' + payable.toFixed(2) + '" readonly /></td>' +
                    '<td class="field-width" style="width:80px;"><input type="text" class="form-control border-bottom remarks-inp" style="width:80px;" value="' + remarks + '" /></td>' +
                '</tr>';
                adviceBody.append(newRow);
            }

            $('#btnModalOK').click(function() {
                $('#modalBillsBody').find('.bill-select:checked').each(function () {
                    var $row   = $(this).closest('tr');

                    var item = {
                        id: $row.data('id'),
                        acode: $row.data('acode'),
                        subcode: $row.data('subcode'),
                        acname: $row.find('td').eq(12).text().trim(),
                        blno: $row.data('blno'),
                        bldt: $row.find('td').eq(2).text().trim(),
                        duedt: $row.find('td').eq(3).text().trim(),
                        billAmt: parseFloat($row.find('td').eq(4).find('input').val()) || 0,
                        deductAmt: 0,
                        tdsAmt: 0,
                        payable: parseFloat($row.find('td').eq(6).find('input').val()) || 0,
                        i_doctype: $row.data('i_doctype'),
                        i_docno: $row.data('i_docno'),
                        i_docdt: $row.data('i_docdt'),
                        i_srlno: $row.data('i_srlno'),
                        remarks: ''
                    };
                    addAdviceRow(item);
                });

                calculateFooterTotals();

                $('html').removeClass('modal-scroll-lock');
                $('#billSelectionOverlay').hide();
                $('#billSelectionModal').hide();
            });
            // Initialize inputpicker on first click only; open dropdown on subsequent clicks
            $(document).on('click', '#modalPartyCode', function () {
                if (!modalPartyPickerInit) {
                    modalPartyPickerInit = true;
                    $('#modalPartyCode').inputpicker({
                        url: '@Url.Action("GetPartyByPage", "PaymentAdvice")',
                        fields: [
                            { name: 'ACNAME', text: 'ACNAME' },
                            { name: 'ACCODE', text: 'ACCODE' }
                        ],
                        fieldText: 'ACCODE',
                        fieldValue: 'ACCODE',
                        headShow: true,
                        autoOpen: false,
                        pagination: true,
                        pageField: 'page',
                        pageLimitField: 'pageSize',
                        pageLimit: 10,
                        pageCountField: 'count',
                        openAfterLoad: true,
                        width: '100%',
                        urlDelay: 1
                    });
                } else {
                    $('#modalPartyCode').inputpicker('open');
                }
            });
            $(document).on('change', '#modalPartyCode', function () {
                let item = $('#modalPartyCode').inputpicker('element');
                if (item) {
                    $('#modalPartyName').val(item.ACNAME);
                }
            });

            function formatJsonDate(jsonDate) {
                if (!jsonDate) return '';
                if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
                    var ms = parseInt(jsonDate.replace(/[^0-9]/g, ''));
                    var d = new Date(ms);
                    return d.getDate().toString().padStart(2, '0') + '/' + (d.getMonth() + 1).toString().padStart(2, '0') + '/' + d.getFullYear();
                } else {
                    var d = new Date(jsonDate);
                    if (!isNaN(d.getTime())) {
                        return d.getDate().toString().padStart(2, '0') + '/' + (d.getMonth() + 1).toString().padStart(2, '0') + '/' + d.getFullYear();
                    }
                }
                return '';
            }

            var initialAdviceNo = $('#paymentAdviceNo').val();
            var refreshInterval = null;
            function initializeInterval() {
                if (refreshInterval) {
                    clearInterval(refreshInterval);
                    refreshInterval = null;
                }
                refreshInterval = setInterval(function () {
                    let unit = '@UnitValue';
                    $.ajax({
                        url: '@Url.Action("RenewLocks", "PaymentAdvice")',
                        type: 'GET',
                        async: false,
                        data: {
                            PaymentAdviceNo: initialAdviceNo,
                            unit: unit
                        },
                        success: function (response) {
                            if (response.status === false) {
                                if (refreshInterval) {
                                    clearInterval(refreshInterval);
                                    refreshInterval = null;
                                }
                                $.confirm({
                                    title: 'Record Locked',
                                    type: 'red',
                                    content: response.content,
                                    typeAnimated: true,
                                    icon: 'icon-smiley',
                                    buttons: {
                                        Okay: function (e) {
                                            var url = "@Url.Action("PaymentAdvice", "PaymentAdvice")";
                                            window.location.href = url;
                                        },
                                    }
                                });
                            }
                        },
                        error: function (xhr) {
                            alert('An error occurred.');
                        }
                    });

                }, 60000);
            }
            if (initialAdviceNo) {
                 $.ajax({
                     url: '@Url.Action("GetByAdviceNo", "PaymentAdvice")',
                     type: 'GET',
                     data: { adviceNo: initialAdviceNo },
                     success: function (res) {
                         if (res && res.length > 0) {
                             $.each(res, function (i, dataItem) {
                                 var item = {
                                     id: dataItem.ID || '',
                                     acode: dataItem.ACODE,
                                     subcode: dataItem.SUBCODE,
                                     acname: dataItem.ACNAME || '',
                                     blno: dataItem.BLNO,
                                     bldt: formatJsonDate(dataItem.BLDT),
                                     duedt: formatJsonDate(dataItem.DUEDT),
                                     billAmt: dataItem.BILL_AMT || 0,
                                     deductAmt: dataItem.DEDUCT_AMT || 0,
                                     tdsAmt: dataItem.TDS_AMT || 0,
                                     payable: dataItem.PAYABLE_AMT || 0,
                                     i_doctype: dataItem.I_DOCTYPE,
                                     i_docno: dataItem.I_DOCNO,
                                     i_docdt: formatJsonDate(dataItem.I_DOCDT),
                                     i_srlno: dataItem.I_SRLNO,
                                     remarks: dataItem.REMARKS || '',
                                     acname: dataItem.ACNAME
                                 };
                                 addAdviceRow(item);
                             });
                             calculateFooterTotals();
                         }
                     },
                     error: function (err) {
                         var url = "@Url.Action("PaymentAdvice", "PaymentAdvice")";
                         window.location.href = url;
                         //console.error('Error fetching advice details:', err);
                     }
                 });
                 initializeInterval();
            }

            $('#btnRefreshBills').click(function () {
                var partyCode = $('#modalPartyCode').val();
                if (partyCode) {
                    var selectedItem = $('#modalPartyCode').inputpicker('element');
                    if (selectedItem) {
                        var acode = selectedItem.ACODE;
                        var subcode = selectedItem.SUBCODE;
                        var acname = selectedItem.ACNAME;
                        var fromDate = $('#modalFromDate').val();
                        var uptoDate = $('#modalUptoDate').val();
                        var unit = $('#unit').val();
                        $.ajax({
                            url: '@Url.Action("GetBySubCode", "PaymentAdvice")',
                            type: 'GET',
                            data: { subcode: subcode, acode: acode, startDate: fromDate, formDate: uptoDate,unit:unit },
                            success: function (res) {
                                var tbody = $('#modalBillsBody');
                                tbody.empty();

                                if (res && res.length > 0) {
                                    $.each(res, function (i, item) {
                                        var bldt = formatJsonDate(item.BLDT);
                                        var duedt = formatJsonDate(item.DUEDT);
                                        var docdt = formatJsonDate(item.DOCDT);
                                        var idocdt = formatJsonDate(item.I_DOCDT);

                                        var isAlreadyAdded = false;
                                        if (item.ID) {
                                            isAlreadyAdded = $('#paymentAdviceGridBody').find('tr[data-id="' + item.ID + '"]').length > 0;
                                        }

                                        var trAttributes = item.isdisable ? ' style="cursor: not-allowed;" title="' + (item.LOCKEDBYUSERID || '') + '"' : '';
                                        var tdStyle = item.isdisable ? ' style="background-color: #f2f2f2 !important;"' : '';
                                        var checkboxAttr = item.isdisable ? ' disabled' : '';
                                        if (isAlreadyAdded) {
                                            checkboxAttr += ' checked';
                                        }

                                        var tr = '<tr id="bill-row-' + i + '"' + trAttributes +
                                            ' data-blno="' + (item.BLNO || '') + '"' +
                                            ' data-id="' + (item.ID || '') + '"' +
                                            ' data-doc="' + (item.DOCTYPE || '') + '"' +
                                            ' data-docno="' + (item.DOCNO || '') + '"' +
                                            ' data-srlno="' + (item.SRLNO || '') + '"' +
                                            ' data-acode="' + (item.ACODE || '') + '"' +
                                            ' data-I_DOCTYPE="' + (item.I_DOCTYPE || '') + '"' +
                                            ' data-I_DOCNO="' + (item.I_DOCNO || '') + '"' +
                                            ' data-I_DOCDT="' + (idocdt || '') + '"' +
                                            ' data-subcode="' + (subcode || '') + '"' +
                                            ' data-I_SRLNO="' + (item.I_SRLNO || '') + '"'+
                                            '>' +
                                            '<td class="action-btn-col"' + tdStyle + '><input type="checkbox" class="bill-select"' + checkboxAttr + ' /></td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (item.BLNO || '') + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + bldt + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + duedt + '</td>' +
                                            '<td' + tdStyle + '><input type="number" class="cr" value="' + (item.AMT || 0).toFixed(2) + '" readonly' + checkboxAttr + tdStyle + ' /></td>' +
                                            '<td' + tdStyle + '><input type="number" class="cr" value="0.00" readonly' + checkboxAttr + tdStyle + ' /></td>' +
                                            '<td' + tdStyle + '><input type="number" class="cr" value="' + (item.AMT || 0).toFixed(2) + '" readonly' + checkboxAttr + tdStyle + ' /></td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (item.DOCTYPE || '') + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (item.DOCNO || '') + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + docdt + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (item.SRLNO || '') + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (item.ACODE || '')+(item.SUBCODE||'') + '</td>' +
                                            '<td class="field-width"' + tdStyle + '>' + (acname || '') + '</td>' +
                                        '</tr>';
                                        tbody.append(tr);
                                    });
                                } else {
                                    tbody.append('<tr><td colspan="13" style="text-align:center;">No bills found</td></tr>');
                                }
                            },
                            error: function (err) {
                                console.error('Error fetching bills:', err);
                            }
                        });
                    }
                }
            });

            $(document).on('change', '.bill-select', function () {
                var $checkbox = $(this);
                var $row = $checkbox.closest('tr');
                var billId = $row.data('id');

                if (billId) {
                    if ($checkbox.is(':checked')) {
                        $.ajax({
                            url: '@Url.Action("Lockbill", "PaymentAdvice")',
                            type: 'GET',
                            data: { billid: [billId] },
                            traditional: true,
                            success: function (res) {
                                var data = (res && res.length > 0) ? res[0] : res;
                                if (data && (data.status === false)) {
                                    $.confirm({
                                        title: 'Alert',
                                        content: `Currently blocked by user ${data.content}` || ' Unable to lock bill.',
                                        type: 'red',
                                        buttons: {
                                            ok: function () {
                                                $checkbox.prop('checked', false);
                                                $row.css('cursor', 'not-allowed').attr('title', data.content || '');
                                                $row.find('td, input').each(function() {
                                                    this.style.setProperty('background-color', '#f2f2f2', 'important');
                                                });
                                                $row.find('input').prop('disabled', true);
                                            }
                                        }
                                    });
                                }
                            },
                            error: function (err) {
                                console.error('Error locking bill:', err);
                            }
                        });
                    } else {
                        $.ajax({
                            url: '@Url.Action("RemovebillLock", "PaymentAdvice")',
                            type: 'GET',
                            data: { billid: [billId] },
                            traditional: true,
                            success: function (res) {
                                var data = (res && res.length > 0) ? res[0] : res;
                                if (data && data.status === false) {
                                    console.warn('Unable to remove lock: ', data.content);
                                }
                            },
                            error: function (err) {
                                console.error('Error removing bill lock:', err);
                            }
                        });
                    }
                }
            });
            window.addEventListener("beforeunload", function (e) {
                if (refreshInterval) {
                    clearInterval(refreshInterval);
                    refreshInterval = null;
                }
                $.ajax({
                    url: '@Url.Action("RemovebillLockByUser", "PaymentAdvice")',
                    type: 'GET',
                    success: function (res) {
                    },
                    error: function (err) {
                        console.error('Error removing bill lock:', err);
                    }
                });
            });

            window.addEventListener("unload", function () {
                if (refreshInterval) {
                    clearInterval(refreshInterval);
                    refreshInterval = null;
                }
                $.ajax({
                    url: '@Url.Action("RemovebillLockByUser", "PaymentAdvice")',
                    type: 'GET',
                    success: function (res) {
                    },
                    error: function (err) {
                        console.error('Error removing bill lock:', err);
                    }
                });
            });
            //// Add custom click outside behavior for modal
            //$(window).click(function(e) {
            //    if ($(e.target).is('#billSelectionOverlay')) {
            //        $('#billSelectionOverlay').hide();
            //    }
            //});
        });
        </script>
    }
</body>
