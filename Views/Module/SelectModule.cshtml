@model IEnumerable<TeaSaleManagement.Models.MODULE>
@{
    Layout = null;
}
<title>Classic ERP Packet Sales Export - @System.Configuration.ConfigurationManager.AppSettings["DatabaseType"]</title>

<!-- Favicon icon -->
<link rel="icon" href="~/Content/libraries/assets/images/favicon.ico" type="image/x-icon">
<!-- Google font-->
<link href="https://fonts.googleapis.com/css?family=Open+Sans:400,600,800" rel="stylesheet">
<!-- Required Fremwork -->
<link rel="stylesheet" type="text/css" href="~/Content/libraries/bower_components/bootstrap/css/bootstrap.min.css">
<!-- feather Awesome -->
<link rel="stylesheet" type="text/css" href="~/Content/libraries/assets/icon/feather/css/feather.css">
<!-- Style.css -->
<link rel="stylesheet" type="text/css" href="~/Content/libraries/assets/css/style.css">


<!-- Pre-loader end -->
<div class="pcoded">
    <div class="pcoded-container navbar-wrapper">
        <div class="pcoded-main-container">
            <div>
                <div class="pcoded-content">
                    <div class="pcoded-inner-content">
                        <!-- Main-body start -->
                        <div class="main-body">
                            <div class="page-wrapper">
                                <!-- Page-header start -->
                                <div class="page-header" style="text-align:center">
                                    <div class="row align-items-end">
                                        <div class="col-lg-12">
                                            <div class="page-header-title">
                                                <div class="d-inline">
                                                    <h4>CLASSIC ERP MODULE SELECTION</h4>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Page-header end -->
                                <!-- Page body start -->
                                <div class="page-body">
                                    <div class="col-sm-12">
                                        <!-- Login card start -->
                                        <div class="card">
                                            <div class="card-header">
                                                @*<h5>Module Selection</h5>*@
                                                <a href=@Url.Action("login","Auth")
                                                   class="btn btn-default pull-right" style="color:red">CLOSE</a>
                                            </div>
                                            <div class="card-block">
                                                <div class="page-body">
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            <!-- Default card start -->
                                                            <div class="card-block">
                                                                <div class="row">
                                                                    @foreach (var item in Model)
                                                                    {
                                                                        if (@item.PERMISSION == "Y")
                                                                        {
                                                                            <div class="col-md-4">
                                                                                <div class="card order-card social-card bg-c-yellow cardglow">
                                                                                    <div class="card-block">
                                                                                        <p class="m-b-0">  <i class="feather icon-arrow-down m-l-10"></i></p>
                                                                                        <i class="card-icon feather icon-users"></i>
                                                                                        <div class="row align-items-center">
                                                                                            <div class="col">
                                                                                                <h3 class="uppercase"> @item.MODULE_NAME</h3>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <a href="@Url.Action("CompanySelection","Module",new { code = item.MODULE_CODE, controlschema = item.CONTROL_TABLE, menuschema = item.MENU_TABLE, sortby=item.MENU_SORT_BY,mname=item.MODULE_NAME })" class="download-icon"><i class="feather icon-arrow-down"></i></a>
                                                                                    <div class="card-footer bg-c-blue">
                                                                                        @*<h6 class="text-white m-b-0">Tag Line</h6>*@
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Login card end -->
                                    </div>
                                </div>
                                <!-- Page body end -->
                            </div>
                        </div>
                        <!-- Main-body end -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

