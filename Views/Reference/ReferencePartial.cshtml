@*@model TeaSaleManagement.Models.Master.M_REF_JAG*@

@using (Html.BeginForm("AddOrUpdate", "Reference", FormMethod.Post, new { onsubmit = "return validateForm();" }))
{
    @Html.Hidden("Id", "", new { id = "id" })
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row col-md-12">

        <input type="hidden" id="Id" name="Id" value="">

        <div class="col-md-2">
            <label for="cd" class="form-label">Code<span class="required-field" style="color: red;">*</span></label>
            @Html.TextBox("cd", "", new { id = "cd", @class = "form-control", @minlength = "2", @maxlength = "7", @readonly = "readonly", @oninput = "this.value = this.value.toUpperCase(); width:120px;" })
            <span id="cdError" class="text-danger"></span>



        </div>
        <div class="col-md-4">
            <label for="inputdescription" class="form-label">Description<span class="required-field" style="color: Red;">*</span></label>
            @Html.TextBox("nam", "", new { @class = "form-control", maxlength = "40", @readonly = "@readonly", @oninput = "this.value = this.value.toUpperCase();" })
            <span id="namError" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label for="inputCity" class="form-label">Sht Descn</label>
            @Html.TextBox("adds", "", new { @class = "form-control", maxlength = "24", @readonly = "@readonly", @oninput = "this.value = this.value.toUpperCase();" })
            @*<span id="addsError" class="text-danger "></span>*@
        </div>

        <div class="col-md-3">
            <label class="form-label">Fund Flow Group <span class="required-field" style="color: Red;"></span></label>


            @Html.DropDownList("FFCODE", new SelectList(ViewBag.AllowCal, "Value", "Text"), "SELECT..", new
       {
           @class = "form-control js-fundflow-select",
           @id = "FFCODE",

       
       })
            @*<span id="FFCODEError" class="text-danger "></span>*@

        </div>
        <div class="col-md-5">
            <label for="inputCity" class="form-label">Full Descn<span class="required-field" style="color: Red;">*</span></label>

            @Html.TextBox("addss", "", new { @class = "form-control", maxlength = "100", @readonly = "@readonly", @oninput = "this.value = this.value.toUpperCase();" })
            <span id="addssError" class="text-danger"></span>
        </div>


        <div class="col-md-2">
            <label for="ENTDT">Active From</label>
            @Html.TextBox("ENTDT", "{0:yyyy-MM-ddTHH:mm:ss}", new { @class = "form-control", type = "date", id = "ENTDT" })
            @*<span id="ENTDT_Error" class="text-danger"></span>*@
        </div>

        <div class="col-md-2">
            <label for="ENTDT_NEW">Active To</label>
            @Html.TextBox("ENTDT_NEW", "{0:yyyy-MM-ddTHH:mm:ss}", new { @class = "form-control", type = "date", id = "ENTDT_NEW" })
            <span id="ENTDT_NEWError" class="text-danger"></span>
        </div>


    </div>
}

