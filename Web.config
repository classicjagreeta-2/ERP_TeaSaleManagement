	<system.webServer>
		<security>
			<requestFiltering>
				<!-- Optional: Increase request limit (in bytes) -->
				<requestLimits  maxUrl="8192" maxQueryString="32768" maxAllowedContentLength="2147483647" />
			</requestFiltering>
		</security>
		<modules runAllManagedModulesForAllRequests="true" />
	</system.webServer>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
		<!-- same as the Forms login timeout below, so the rights / API token in Session do not expire first -->
		<sessionState mode="InProc" timeout="30" />
		<authentication mode="Forms">
			<!--value in minutes, Default is 30 minutes-->
			<forms timeout="30" slidingExpiration="true" />
		</authentication>
	</system.web>
